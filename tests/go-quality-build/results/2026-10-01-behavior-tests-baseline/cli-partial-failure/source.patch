+type unreadableInput struct{ t *testing.T }
+
+func (r unreadableInput) Read([]byte) (int, error) {
+	r.t.Fatal("read stdin after usage error")
+	return 0, io.EOF
+}
+
+// Each chunk is a complete row. The next Read inspects the filesystem before
+// making further input available, so collecting all rows before writing fails.
+type checkedInput struct {
+	t      *testing.T
+	dir    string
+	chunks []string
+	want   []map[string]string
+	index  int
+	endErr error
+}
+
+func (r *checkedInput) Read(p []byte) (int, error) {
+	r.t.Helper()
+	assertRecords(r.t, r.dir, r.want[r.index])
+	if r.index == len(r.chunks) {
+		return 0, r.endErr
+	}
+	chunk := r.chunks[r.index]
+	if len(p) < len(chunk) {
+		r.t.Fatalf("reader buffer too small for test row: %d", len(p))
+	}
+	r.index++
+	return copy(p, chunk), nil
+}
