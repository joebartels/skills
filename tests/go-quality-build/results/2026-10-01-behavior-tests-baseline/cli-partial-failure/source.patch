+func TestCLI(t *testing.T) {
+	binary := filepath.Join(t.TempDir(), "ledgerload")
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	build := exec.CommandContext(ctx, "go", "build", "-o", binary, ".")
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build: %v\n%s", err, output)
+	}
+
+	for _, tc := range []struct {
+		name       string
+		args       func(string) []string
+		input      string
+		setup      func(*testing.T, string)
+		exitCode   int
+		want       map[string]string
+		diagnostic string
+	}{
+		{name: "success", input: "web,007\napi,2\nweb,9\n", want: map[string]string{"web": "9\n", "api": "2\n"}},
+		{name: "empty", want: map[string]string{}},
+		{name: "invalid prefix", input: "web,7\nbad,0\nlater,1\nweb,99\n", exitCode: 2, want: map[string]string{"web": "7\n"}, diagnostic: "quantity"},
+		{name: "malformed CSV", input: "web,7\nbro\"ken,2\nlater,1\n", exitCode: 2, want: map[string]string{"web": "7\n"}, diagnostic: "quote"},
+		{name: "file failure", input: "web,7\nblocked,2\nlater,1\nweb,99\n", setup: func(t *testing.T, dir string) {
+			if err := os.Mkdir(filepath.Join(dir, "blocked"), 0o755); err != nil {
+				t.Fatal(err)
+			}
+		}, exitCode: 2, want: map[string]string{"web": "7\n"}, diagnostic: "blocked"},
+		{name: "missing dir", args: func(string) []string { return nil }, input: "web,7\n", exitCode: 2, want: map[string]string{}, diagnostic: "dir"},
+		{name: "positional", args: func(dir string) []string { return []string{"--dir", dir, "extra"} }, input: "web,7\n", exitCode: 2, want: map[string]string{}, diagnostic: "positional"},
+		{name: "unknown flag", args: func(string) []string { return []string{"--unknown"} }, input: "web,7\n", exitCode: 2, want: map[string]string{}, diagnostic: "flag"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			if tc.setup != nil {
+				tc.setup(t, dir)
+			}
+			args := []string{"--dir", dir}
+			if tc.args != nil {
+				args = tc.args(dir)
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, binary, args...)
+			cmd.Stdin = strings.NewReader(tc.input)
+			var stdout, stderr bytes.Buffer
+			cmd.Stdout, cmd.Stderr = &stdout, &stderr
+			err := cmd.Run()
+			if ctx.Err() != nil {
+				t.Fatalf("process exceeded deadline: %v", ctx.Err())
+			}
+			gotCode := 0
+			if err != nil {
+				var exitErr *exec.ExitError
+				if !errors.As(err, &exitErr) {
+					t.Fatalf("launch: %v", err)
+				}
+				gotCode = exitErr.ExitCode()
+			}
+			if gotCode != tc.exitCode {
+				t.Fatalf("exit = %d, want %d; stderr = %q", gotCode, tc.exitCode, stderr.String())
+			}
+			if stdout.Len() != 0 {
+				t.Fatalf("stdout = %q, want empty", stdout.String())
+			}
+			if tc.exitCode == 0 && stderr.Len() != 0 {
+				t.Fatalf("success stderr = %q", stderr.String())
+			}
+			if tc.exitCode != 0 && !strings.Contains(stderr.String(), tc.diagnostic) {
+				t.Fatalf("stderr = %q, want useful %q diagnostic", stderr.String(), tc.diagnostic)
+			}
+			assertRecords(t, dir, tc.want)
+		})
+	}
