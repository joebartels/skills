+func TestLowerBound(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		value int
+	}{
+		{name: "below", value: 0},
+		{name: "inclusive", value: 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := clamp.Clamp(tc.value, 1, 9); got != 1 {
+				t.Fatalf("Clamp(%d, 1, 9) = %d, want 1", tc.value, got)
+			}
+		})
+	}
