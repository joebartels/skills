-	runs.Wait()
-	return nil
 }
+
+func wrap(stage string, job Job, err error) error {
+	if err == nil {
+		return nil
+	}
+	return fmt.Errorf("%s job %d: %w", stage, job, err)
+}
+func hasError(errs []error, target error) bool {
+	for _, err := range errs {
+		if errors.Is(err, target) {
+			return true
+		}
+	}
+	return false
+}
