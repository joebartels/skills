+func TestIndependentCancellationLikeFailureIsPreserved(t *testing.T) {
+	independent := errors.Join(context.Canceled, errors.New("independent failure"))
+	err := runPipeline(context.Background(), 1, func(context.Context, chan<- int) error { return independent }, func(ctx context.Context, in <-chan int) error {
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	if !errors.Is(err, independent) {
+		t.Fatalf("got %v, want independent joined failure", err)
+	}
+}
