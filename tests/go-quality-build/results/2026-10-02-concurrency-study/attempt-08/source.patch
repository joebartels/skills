+func TestEarlyConsumerCompletionStopsAndJoinsProducer(t *testing.T) {
+	started, cleaned := make(chan struct{}), make(chan struct{})
+	returned := false
+	err := runPipeline(context.Background(), 1, func(ctx context.Context, out chan<- int) error {
+		close(started)
+		for i := 0; ; i++ {
+			select {
+			case out <- i:
+			case <-ctx.Done():
+				close(cleaned)
+				return ctx.Err()
+			}
+		}
+	}, func(ctx context.Context, in <-chan int) error {
+		await(t, started)
+		<-in
+		return nil
+	})
+	returned = true
+	await(t, cleaned)
+	if err != nil {
+		t.Fatalf("early completion error: %v", err)
+	}
+	if !returned {
+		t.Fatal("runPipeline returned before producer cleanup")
+	}
+}
+
+func TestProducerFailureStopsConsumerAndPreservesError(t *testing.T) {
+	producerErr := errors.New("producer failed")
+	consumerStopped := make(chan struct{})
+	err := runPipeline(context.Background(), 1, func(context.Context, chan<- int) error {
+		return producerErr
+	}, func(ctx context.Context, in <-chan int) error {
+		<-ctx.Done()
+		close(consumerStopped)
+		return ctx.Err()
+	})
+	await(t, consumerStopped)
+	if !errors.Is(err, producerErr) || errors.Is(err, context.Canceled) {
+		t.Fatalf("got error %v, want producer failure without coordinated cancellation", err)
+	}
+}
