+func TestCallerCancellationRemainsErrorAndJoinsBothCallbacks(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	started := make(chan struct{}, 2)
+	cleaned := make(chan struct{}, 2)
+	callback := func(ctx context.Context) error {
+		started <- struct{}{}
+		<-ctx.Done()
+		cleaned <- struct{}{}
+		return ctx.Err()
+	}
+	done := make(chan error, 1)
+	go func() {
+		done <- runPipeline(ctx, 1, func(ctx context.Context, _ chan<- int) error { return callback(ctx) }, func(ctx context.Context, _ <-chan int) error { return callback(ctx) })
+	}()
+	await(t, started)
+	await(t, started)
+	cancel()
+	await(t, cleaned)
+	await(t, cleaned)
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("got %v, want caller cancellation", err)
+	}
+}
