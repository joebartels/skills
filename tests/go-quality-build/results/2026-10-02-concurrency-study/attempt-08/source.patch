+func TestCommandTakeAndMalformedInput(t *testing.T) {
+	var output, diagnostic bytes.Buffer
+	if code := command(context.Background(), []string{"--take=2"}, strings.NewReader("4\n5\n6\n"), &output, &diagnostic); code != 0 || output.String() != "4\n5\n" || diagnostic.Len() != 0 {
+		t.Fatalf("early take: code=%d stdout=%q stderr=%q", code, output.String(), diagnostic.String())
+	}
+	output.Reset()
+	diagnostic.Reset()
+	if code := command(context.Background(), nil, strings.NewReader("bad\n7\n"), &output, &diagnostic); code != 2 || output.Len() != 0 || diagnostic.Len() == 0 {
+		t.Fatalf("malformed input: code=%d stdout=%q stderr=%q", code, output.String(), diagnostic.String())
+	}
