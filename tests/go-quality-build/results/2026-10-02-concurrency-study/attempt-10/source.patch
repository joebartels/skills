+func TestServeCapacityAndCohortRelease(t *testing.T) {
+	jobs := make(chan Job, 3)
+	for _, job := range []Job{1, 2, 3} {
+		jobs <- job
+	}
+	close(jobs)
+	started := make(chan Job, 3)
+	releaseRun := make(chan struct{})
+	releaseClose := make(chan struct{})
+	closeStarted := make(chan Job, 3)
+	var active, closed atomic.Int64
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	var releaseRuns, releaseCloses sync.Once
+	go func() {
+		defer close(done)
+		finished <- Serve(context.Background(), jobs, 2, func(_ context.Context, job Job) (Lease, error) {
+			if job == 3 && closed.Load() != 2 {
+				return nil, errors.New("third job admitted before both closes")
+			}
+			return leaseFuncs{
+				run: func(context.Context, Job) error {
+					active.Add(1)
+					started <- job
+					if job != 3 {
+						<-releaseRun
+					}
+					active.Add(-1)
+					return nil
+				},
+				close: func() error {
+					if active.Load() != 0 {
+						return errors.New("closed while cohort Run was active")
+					}
+					closeStarted <- job
+					if job != 3 {
+						<-releaseClose
+					}
+					closed.Add(1)
+					return nil
+				},
+			}, nil
+		})
+	}()
+	t.Cleanup(func() {
+		releaseRuns.Do(func() { close(releaseRun) })
+		releaseCloses.Do(func() { close(releaseClose) })
+		await(t, done)
+	})
+	first, second := await(t, started), await(t, started)
+	if first == second || first == 3 || second == 3 {
+		t.Fatalf("first started jobs = %d, %d; want 1 and 2", first, second)
+	}
+	releaseRuns.Do(func() { close(releaseRun) })
+	await(t, closeStarted)
+	select {
+	case job := <-started:
+		t.Fatalf("job %d started before Close completed", job)
+	case <-time.After(30 * time.Millisecond):
+	}
+	releaseCloses.Do(func() { close(releaseClose) })
+	if job := await(t, started); job != 3 {
+		t.Fatalf("next started job = %d, want 3", job)
+	}
+	if err := await(t, finished); err != nil {
+		t.Fatal(err)
+	}
+	if got := closed.Load(); got != 3 {
+		t.Fatalf("closed = %d, want 3", got)
+	}
+}
