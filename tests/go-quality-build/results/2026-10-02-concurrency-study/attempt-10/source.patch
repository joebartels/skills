+func TestServeRunFailureInterruptsOpen(t *testing.T) {
+	runErr := errors.New("run failed")
+	openErr := errors.New("open interrupted")
+	jobs := make(chan Job, 2)
+	jobs <- 1
+	jobs <- 2
+	close(jobs)
+	openStarted := make(chan struct{})
+	var closed atomic.Int64
+	ctx, cancel := context.WithCancel(context.Background())
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		finished <- Serve(ctx, jobs, 2, func(openCtx context.Context, job Job) (Lease, error) {
+			if job == 2 {
+				close(openStarted)
+				<-openCtx.Done()
+				return nil, openErr
+			}
+			return leaseFuncs{
+				run: func(context.Context, Job) error {
+					<-openStarted
+					return runErr
+				},
+				close: func() error {
+					closed.Add(1)
+					return nil
+				},
+			}, nil
+		})
+	}()
+	t.Cleanup(func() {
+		cancel()
+		await(t, done)
+	})
+	err := await(t, finished)
+	if !errors.Is(err, runErr) || !errors.Is(err, openErr) || closed.Load() != 1 {
+		t.Fatalf("Serve=%v closed=%d, want both errors and one close", err, closed.Load())
+	}
+}
