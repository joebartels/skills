+type leaseFuncs struct {
+	run   func(context.Context, Job) error
+	close func() error
+}
+
+func (l leaseFuncs) Run(ctx context.Context, job Job) error { return l.run(ctx, job) }
+func (l leaseFuncs) Close() error                           { return l.close() }
+
+func await[T any](t *testing.T, ch <-chan T) T {
+	t.Helper()
+	select {
+	case value := <-ch:
+		return value
+	case <-time.After(3 * time.Second):
+		t.Fatal("timed out waiting for event")
+		var zero T
+		return zero
+	}
+}
