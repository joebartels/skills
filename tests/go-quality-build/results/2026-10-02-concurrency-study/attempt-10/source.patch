+func TestServeCancellationWhileCloseIsHeld(t *testing.T) {
+	closeErr := errors.New("close failed")
+	ctx, cancel := context.WithCancel(context.Background())
+	jobs := make(chan Job, 2)
+	jobs <- 1
+	jobs <- 2
+	close(jobs)
+	closeStarted := make(chan struct{})
+	releaseClose := make(chan struct{})
+	var opened atomic.Int64
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	var release sync.Once
+	go func() {
+		defer close(done)
+		finished <- Serve(ctx, jobs, 1, func(context.Context, Job) (Lease, error) {
+			opened.Add(1)
+			return leaseFuncs{
+				run: func(context.Context, Job) error { return nil },
+				close: func() error {
+					close(closeStarted)
+					<-releaseClose
+					return closeErr
+				},
+			}, nil
+		})
+	}()
+	t.Cleanup(func() {
+		cancel()
+		release.Do(func() { close(releaseClose) })
+		await(t, done)
+	})
+	await(t, closeStarted)
+	cancel()
+	select {
+	case err := <-finished:
+		t.Fatalf("Serve returned before Close completed: %v", err)
+	case <-time.After(30 * time.Millisecond):
+	}
+	release.Do(func() { close(releaseClose) })
+	err := await(t, finished)
+	if !errors.Is(err, context.Canceled) || !errors.Is(err, closeErr) {
+		t.Fatalf("Serve = %v, want cancellation and Close error", err)
+	}
+	if opened.Load() != 1 {
+		t.Fatalf("opened = %d, want 1", opened.Load())
+	}
+}
