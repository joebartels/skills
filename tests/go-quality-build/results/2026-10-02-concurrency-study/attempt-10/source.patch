+func TestServeAcquiredLeaseAfterCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	jobs := make(chan Job, 2)
+	jobs <- 1
+	jobs <- 2
+	close(jobs)
+	openStarted := make(chan struct{})
+	runStarted := make(chan struct{})
+	runStopping := make(chan struct{})
+	releaseRun := make(chan struct{})
+	var runCount, closeCount atomic.Int64
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	var release sync.Once
+	go func() {
+		defer close(done)
+		finished <- Serve(ctx, jobs, 2, func(openCtx context.Context, job Job) (Lease, error) {
+			if job == 2 {
+				<-runStarted
+				close(openStarted)
+				<-openCtx.Done()
+			}
+			return leaseFuncs{
+				run: func(runCtx context.Context, _ Job) error {
+					runCount.Add(1)
+					close(runStarted)
+					<-runCtx.Done()
+					close(runStopping)
+					<-releaseRun
+					return nil
+				},
+				close: func() error {
+					closeCount.Add(1)
+					return nil
+				},
+			}, nil
+		})
+	}()
+	t.Cleanup(func() {
+		cancel()
+		release.Do(func() { close(releaseRun) })
+		await(t, done)
+	})
+	await(t, openStarted)
+	cancel()
+	await(t, runStopping)
+	if closeCount.Load() != 0 {
+		t.Fatal("closed lease before held Run completed")
+	}
+	release.Do(func() { close(releaseRun) })
+	if err := await(t, finished); !errors.Is(err, context.Canceled) {
+		t.Fatalf("Serve = %v, want cancellation", err)
+	}
+	if runCount.Load() != 1 || closeCount.Load() != 2 {
+		t.Fatalf("runs=%d closes=%d, want 1 and 2", runCount.Load(), closeCount.Load())
+	}
+}
