+func TestServeCancellationBeforeAndDuringAdmission(t *testing.T) {
+	t.Run("already canceled", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel()
+		opened := false
+		err := Serve(ctx, make(chan Job), 2, func(context.Context, Job) (Lease, error) {
+			opened = true
+			return nil, nil
+		})
+		if opened || !errors.Is(err, context.Canceled) {
+			t.Fatalf("opened=%v err=%v", opened, err)
+		}
+	})
+	t.Run("sparse open channel", func(t *testing.T) {
+		ctx, cancel := context.WithCancel(context.Background())
+		finished := make(chan error, 1)
+		go func() {
+			finished <- Serve(ctx, make(chan Job), 2, func(context.Context, Job) (Lease, error) {
+				return nil, errors.New("unexpected Open")
+			})
+		}()
+		cancel()
+		if err := await(t, finished); !errors.Is(err, context.Canceled) {
+			t.Fatalf("Serve = %v, want cancellation", err)
+		}
+	})
+}
