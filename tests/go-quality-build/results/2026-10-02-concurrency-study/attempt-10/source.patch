+func TestServeIndependentRunAndCloseFailures(t *testing.T) {
+	runErr := errors.New("run failed")
+	closeErr := errors.New("close failed")
+	for _, tc := range []struct {
+		name     string
+		runErr   error
+		closeErr error
+	}{
+		{"run only", runErr, nil},
+		{"close only", nil, closeErr},
+		{"both", runErr, closeErr},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			jobs := make(chan Job, 1)
+			jobs <- 1
+			close(jobs)
+			closes := 0
+			err := Serve(context.Background(), jobs, 2, func(context.Context, Job) (Lease, error) {
+				return leaseFuncs{
+					run:   func(context.Context, Job) error { return tc.runErr },
+					close: func() error { closes++; return tc.closeErr },
+				}, nil
+			})
+			for _, want := range []error{tc.runErr, tc.closeErr} {
+				if want != nil && !errors.Is(err, want) {
+					t.Fatalf("Serve = %v, missing %v", err, want)
+				}
+			}
+			if closes != 1 {
+				t.Fatalf("closes = %d, want 1", closes)
+			}
+		})
+	}
+}
