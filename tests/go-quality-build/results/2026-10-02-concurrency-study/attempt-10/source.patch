+func TestServeFailuresJoinAndStopAdmission(t *testing.T) {
+	openErr := errors.New("open failed")
+	runErr := errors.New("run failed")
+	closeErr := errors.New("close failed")
+	jobs := make(chan Job, 3)
+	for _, job := range []Job{1, 2, 3} {
+		jobs <- job
+	}
+	close(jobs)
+	running := make(chan struct{})
+	stopping := make(chan struct{})
+	releaseRun := make(chan struct{})
+	var opened, closed atomic.Int64
+	finished := make(chan error, 1)
+	done := make(chan struct{})
+	var release sync.Once
+	go func() {
+		defer close(done)
+		finished <- Serve(context.Background(), jobs, 2, func(ctx context.Context, job Job) (Lease, error) {
+			opened.Add(1)
+			if job == 2 {
+				<-running
+				return nil, openErr
+			}
+			return leaseFuncs{
+				run: func(ctx context.Context, _ Job) error {
+					close(running)
+					<-ctx.Done()
+					close(stopping)
+					<-releaseRun // deliberately held cleanup
+					return runErr
+				},
+				close: func() error {
+					closed.Add(1)
+					return closeErr
+				},
+			}, nil
+		})
+	}()
+	t.Cleanup(func() {
+		release.Do(func() { close(releaseRun) })
+		await(t, done)
+	})
+	await(t, stopping)
+	if closed.Load() != 0 {
+		t.Fatal("lease closed before Run completed")
+	}
+	release.Do(func() { close(releaseRun) })
+	err := await(t, finished)
+	for _, want := range []error{openErr, runErr, closeErr} {
+		if !errors.Is(err, want) {
+			t.Fatalf("Serve = %v, missing %v", err, want)
+		}
+	}
+	if opened.Load() != 2 || closed.Load() != 1 {
+		t.Fatalf("opened=%d closed=%d, want 2 and 1", opened.Load(), closed.Load())
+	}
+}
