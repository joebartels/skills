+			err = observedCancellation(ctx, err)
+			break
+		}
+		if applyErr := apply(ctx, job); applyErr != nil {
+			if ctxErr := ctx.Err(); ctxErr != nil {
+				err = observedCancellation(ctx, ctxErr)
+				if !errors.Is(applyErr, ctxErr) {
+					err = errors.Join(applyErr, err)
+				}
+			} else {
+				err = applyErr
+			}
 			break
 		}
 		accepted++
 	}
