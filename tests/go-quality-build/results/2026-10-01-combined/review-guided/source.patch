+// SyncBulletins fetches and validates one feed response, then atomically replaces
+// the local snapshot. The caller owns the HTTP client and its lifetime.
+func (s *Service) SyncBulletins(ctx context.Context, client *http.Client, feedURL string) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if client == nil {
+		return errors.New("nil bulletin HTTP client")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, feedURL, nil)
+	if err != nil {
+		return fmt.Errorf("create bulletin request: %w", err)
+	}
+	resp, err := client.Do(req)
+	if err != nil {
+		return fmt.Errorf("fetch bulletins: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("bulletin feed status: %s", resp.Status)
+	}
+	var bulletins []Bulletin
+	decoder := json.NewDecoder(resp.Body)
+	if err := decoder.Decode(&bulletins); err != nil {
+		return fmt.Errorf("decode bulletin feed: %w", err)
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); err != io.EOF {
+		if err == nil {
+			return errors.New("decode bulletin feed: multiple JSON values")
+		}
+		return fmt.Errorf("decode bulletin feed: %w", err)
+	}
+	if bulletins == nil {
+		return errors.New("decode bulletin feed: expected JSON array")
+	}
+	for i, b := range bulletins {
+		if strings.TrimSpace(b.ID) == "" || strings.TrimSpace(b.Text) == "" {
+			return fmt.Errorf("invalid bulletin at index %d: id and text must be nonblank", i)
+		}
+	}
+	data, err := json.Marshal(bulletins)
+	if err != nil {
+		return fmt.Errorf("encode bulletin snapshot: %w", err)
+	}
+	if err := os.MkdirAll(s.root, 0755); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(s.root, ".bulletins-*.tmp")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	defer os.Remove(tmpName)
+	if _, err := tmp.Write(data); err != nil {
+		_ = tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	if err := os.Rename(tmpName, filepath.Join(s.root, "bulletins.json")); err != nil {
+		return err
+	}
+	return nil
+}
+
+// RunBulletinSync performs an immediate sync and then one sync per interval.
+// It runs synchronously, so cycles cannot overlap. Cancellation stops and joins
+// the current request before this method returns.
+func (s *Service) RunBulletinSync(ctx context.Context, interval time.Duration, client *http.Client, feedURL string, report func(error)) error {
+	if interval <= 0 {
+		return errors.New("bulletin sync interval must be positive")
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return nil
+		}
+		if err := s.SyncBulletins(ctx, client, feedURL); err != nil {
+			if ctx.Err() != nil {
+				return nil
+			}
+			if report != nil {
+				report(err)
+			}
+		}
+		timer := time.NewTimer(interval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return nil
+		case <-timer.C:
+		}
+	}
 }
 
