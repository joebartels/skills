+// runServer owns worker startup and joins it before returning, including when
+// the listener fails. listen and shutdown are supplied by the process host.
+func runServer(ctx context.Context, listen func() error, shutdown func(context.Context) error, runWorker func(context.Context)) error {
+	workerCtx, cancelWorker := context.WithCancel(ctx)
+	workerDone := make(chan struct{})
+	go func() { defer close(workerDone); runWorker(workerCtx) }()
+	serverDone := make(chan error, 1)
+	go func() { serverDone <- listen() }()
+	var serveErr error
+	select {
+	case serveErr = <-serverDone:
+	case <-ctx.Done():
+	}
+	shutdownCtx, shutdownCancel := context.WithTimeout(context.Background(), 10*time.Second)
+	shutdownErr := shutdown(shutdownCtx)
+	shutdownCancel()
+	cancelWorker()
+	<-workerDone
+	if serveErr == nil && ctx.Err() != nil {
+		serveErr = <-serverDone
+	}
+	if errors.Is(serveErr, http.ErrServerClosed) {
+		serveErr = nil
+	}
+	if serveErr == nil && ctx.Err() == nil {
+		serveErr = errors.New("http server stopped unexpectedly")
+	}
+	return errors.Join(serveErr, shutdownErr)
+}
