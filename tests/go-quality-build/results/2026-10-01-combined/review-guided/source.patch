+func TestRunServerSignalShutdownJoinsWorker(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	workerStarted := make(chan struct{})
+	workerCanceled := make(chan struct{})
+	releaseWorker := make(chan struct{})
+	workerJoined := make(chan struct{})
+	listenStopped := make(chan struct{})
+	var shutdownOnce sync.Once
+	var releaseOnce sync.Once
+	t.Cleanup(func() { releaseOnce.Do(func() { close(releaseWorker) }) })
+	done := make(chan error, 1)
+	go func() {
+		done <- runServer(ctx,
+			func() error { <-listenStopped; return http.ErrServerClosed },
+			func(context.Context) error { shutdownOnce.Do(func() { close(listenStopped) }); return nil },
+			func(workerCtx context.Context) {
+				close(workerStarted)
+				<-workerCtx.Done()
+				close(workerCanceled)
+				<-releaseWorker
+				close(workerJoined)
+			},
+		)
+	}()
+	select {
+	case <-workerStarted:
+	case <-time.After(time.Second):
+		t.Fatal("worker did not start")
+	}
+	cancel()
+	select {
+	case <-workerCanceled:
+	case <-time.After(time.Second):
+		t.Fatal("worker was not canceled")
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("server returned before worker joined: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	releaseOnce.Do(func() { close(releaseWorker) })
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatalf("normal signal shutdown returned %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("server did not return after worker joined")
+	}
+	select {
+	case <-workerJoined:
+	default:
+		t.Fatal("worker cleanup did not finish before return")
+	}
+}
+
+func TestRunServerReturnsListenFailureAfterJoiningWorker(t *testing.T) {
+	want := errors.New("listen failed")
+	workerJoined := make(chan struct{})
+	shutdownCalled := false
+	err := runServer(context.Background(),
+		func() error { return want },
+		func(context.Context) error { shutdownCalled = true; return nil },
+		func(ctx context.Context) { <-ctx.Done(); close(workerJoined) },
+	)
+	if !errors.Is(err, want) {
+		t.Fatalf("runServer error = %v, want %v", err, want)
+	}
+	if !shutdownCalled {
+		t.Fatal("shutdown was not called after listen failure")
+	}
+	select {
+	case <-workerJoined:
+	default:
+		t.Fatal("worker was not joined")
+	}
+}
