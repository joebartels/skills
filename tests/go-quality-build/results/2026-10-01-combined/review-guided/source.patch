+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func newResponse(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Status: http.StatusText(status), Body: io.NopCloser(strings.NewReader(body)), Header: make(http.Header)}
+}
+
+type eofGateBody struct {
+	reader  *strings.Reader
+	eof     chan struct{}
+	release chan struct{}
+	once    sync.Once
+}
+
+func (b *eofGateBody) Read(p []byte) (int, error) {
+	n, err := b.reader.Read(p)
+	if err == io.EOF {
+		b.once.Do(func() { close(b.eof) })
+		<-b.release
+	}
+	return n, err
+}
