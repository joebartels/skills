+func TestRunBulletinSyncReportsFailuresAndKeepsCyclesSerial(t *testing.T) {
+	var calls, active, maxActive atomic.Int32
+	second := make(chan struct{})
+	client := &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		call := calls.Add(1)
+		current := active.Add(1)
+		for old := maxActive.Load(); current > old && !maxActive.CompareAndSwap(old, current); old = maxActive.Load() {
+		}
+		defer active.Add(-1)
+		if call == 1 {
+			return newResponse(http.StatusServiceUnavailable, `failure`), nil
+		}
+		close(second)
+		return newResponse(http.StatusOK, `[]`), nil
+	})}
