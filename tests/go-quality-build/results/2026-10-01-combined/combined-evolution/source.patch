+package main
+
+import (
+	"context"
+	"encoding/csv"
+	"fmt"
+	"io"
+	"os"
+
+	"example.com/fielddesk"
+)
+
+func main() {
+	if err := run(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func run(args []string) error {
+	if len(args) != 1 {
+		return fmt.Errorf("usage: import-checkins <csv-file>")
+	}
+	file, err := os.Open(args[0])
+	if err != nil {
+		return fmt.Errorf("open CSV: %w", err)
+	}
+	defer file.Close()
+	root := os.Getenv("FIELDDESK_ROOT")
+	if root == "" {
+		root = "./data"
+	}
+	reader := csv.NewReader(file)
+	reader.FieldsPerRecord = 2
+	svc := fielddesk.New(root)
+	for row := 1; ; row++ {
+		record, err := reader.Read()
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return fmt.Errorf("row %d: %w", row, err)
+		}
+		if err := svc.SubmitCheckin(context.Background(), record[0], record[1]); err != nil {
+			return fmt.Errorf("row %d: %w", row, err)
+		}
+	}
+}
