+func TestRunBulletinSyncCancellationJoinsRequest(t *testing.T) {
+	started := make(chan struct{})
+	var canceled atomic.Bool
+	client := &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		close(started)
+		<-r.Context().Done()
+		canceled.Store(true)
+		return nil, r.Context().Err()
+	})}
+	s := fielddesk.New(t.TempDir())
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_ = s.RunBulletinSync(ctx, time.Hour, client, "https://feed.invalid/bulletins", nil)
+	}()
+	select {
+	case <-started:
+	case <-time.After(time.Second):
+		t.Fatal("feed request did not start")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("worker did not join canceled request")
+	}
+	if !canceled.Load() {
+		t.Fatal("feed request did not receive cancellation")
+	}
+}
