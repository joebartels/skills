+func TestImportCheckinsStopsOnFirstInvalidRow(t *testing.T) {
+	root := t.TempDir()
+	csvPath := filepath.Join(t.TempDir(), "rows.csv")
+	if err := os.WriteFile(csvPath, []byte("crew-1,arrived\nbad/id,rejected\ncrew-3,later\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("FIELDDESK_ROOT", root)
+	err := run([]string{csvPath})
+	if err == nil || !strings.Contains(err.Error(), "row 2") {
+		t.Fatalf("run error = %v", err)
+	}
+	if data, err := os.ReadFile(filepath.Join(root, "checkins", "crew-1.txt")); err != nil || string(data) != "arrived\n" {
+		t.Fatalf("first row = %q, %v", data, err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "checkins", "crew-3.txt")); !os.IsNotExist(err) {
+		t.Fatalf("later row was processed: %v", err)
+	}
+}
+
+func TestImportCheckinsRejectsMalformedCSV(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "rows.csv")
+	if err := os.WriteFile(path, []byte("crew-1,ok\nmalformed,row,extra\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("FIELDDESK_ROOT", t.TempDir())
+	if err := run([]string{path}); err == nil {
+		t.Fatal("expected malformed row error")
+	}
+}
