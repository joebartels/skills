+		cancel()
+		calls, releases := 0, 0
+		err := indexer.Serve(ctx, time.Second, func(context.Context) error { calls++; return nil }, func() error { releases++; return nil })
+		if err != nil || calls != 0 || releases != 1 {
+			t.Fatalf("Serve = %v; refreshes = %d, releases = %d", err, calls, releases)
+		}
+	})
+}
