+
+func TestSkipComments(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "numbers")
+	if err := os.WriteFile(p, []byte(" 2\n  # ignored\n-1\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, args := range [][]string{{"--skip-comments", p}, {p, "--skip-comments"}} {
+		var b bytes.Buffer
+		if err := run(args, &b); err != nil {
+			t.Fatalf("run(%q): %v", args, err)
+		}
+		if b.String() != "1\n" {
+			t.Fatalf("run(%q) got %q", args, b.String())
+		}
+	}
+}
+
+func TestCommentsFailWithoutFlagAndWriteNothing(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "numbers")
+	if err := os.WriteFile(p, []byte("2\n# comment\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var b bytes.Buffer
+	if err := run([]string{p}, &b); err == nil || b.Len() != 0 {
+		t.Fatalf("comment accepted or output written: err=%v, output=%q", err, b.String())
+	}
+}
