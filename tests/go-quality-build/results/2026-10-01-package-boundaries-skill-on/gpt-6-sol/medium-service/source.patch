+func TestHTTPBehavior(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	s := Service{Dir: t.TempDir(), NotifyURL: ts.URL, Client: ts.Client()}
+	for _, tc := range []struct {
+		method, target string
+		status         int
+		body           string
+	}{
+		{http.MethodGet, "/?id=ok", http.StatusMethodNotAllowed, ""},
+		{http.MethodPost, "/", http.StatusBadRequest, "submission failed\n"},
+		{http.MethodPost, "/?id=ok", http.StatusNoContent, ""},
+	} {
+		rec := httptest.NewRecorder()
+		s.ServeHTTP(rec, httptest.NewRequest(tc.method, tc.target, nil))
+		if rec.Code != tc.status || rec.Body.String() != tc.body {
+			t.Errorf("%s %s: status %d, body %q", tc.method, tc.target, rec.Code, rec.Body.String())
+		}
+	}
+}
