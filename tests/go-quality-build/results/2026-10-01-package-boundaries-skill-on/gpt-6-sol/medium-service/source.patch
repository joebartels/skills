+package recordstore
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// Store writes one record per ID in Dir.
+type Store struct{ Dir string }
+
+func (s Store) Save(id string) error {
+	return os.WriteFile(filepath.Join(s.Dir, id), []byte("queued\n"), 0600)
+}
