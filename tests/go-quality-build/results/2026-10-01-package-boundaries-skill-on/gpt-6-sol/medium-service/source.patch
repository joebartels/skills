+package main
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func replayFile(t *testing.T, content string) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "batch.txt")
+	if err := os.WriteFile(path, []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func replayEnv(dir, url string) func(string) string {
+	return func(name string) string {
+		switch name {
+		case "RECORD_DIR":
+			return dir
+		case "NOTIFY_URL":
+			return url
+		default:
+			return ""
+		}
+	}
+}
+
+func TestReplaySuccess(t *testing.T) {
+	var notified []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost {
+			t.Errorf("method = %s", r.Method)
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		notified = append(notified, string(body))
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	path := replayFile(t, "  first  \n\n second\t\n")
+	if err := run(context.Background(), []string{path}, replayEnv(dir, ts.URL)); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(notified, []string{"first", "second"}) {
+		t.Fatalf("notified = %v", notified)
+	}
+	for _, id := range notified {
+		data, err := os.ReadFile(filepath.Join(dir, id))
+		if err != nil || string(data) != "queued\n" {
+			t.Fatalf("record %q = %q, %v", id, data, err)
+		}
+	}
+}
+
+func TestReplayStopsOnInvalidID(t *testing.T) {
+	var notified []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		notified = append(notified, string(body))
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	path := replayFile(t, "first\n../bad\nthird\n")
+	err := run(context.Background(), []string{path}, replayEnv(dir, ts.URL))
+	if err == nil || !strings.Contains(err.Error(), "line 2: invalid id") {
+		t.Fatalf("error = %v", err)
+	}
+	if !reflect.DeepEqual(notified, []string{"first"}) {
+		t.Fatalf("notified = %v", notified)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "third")); !os.IsNotExist(err) {
+		t.Fatalf("third record exists or stat failed unexpectedly: %v", err)
+	}
+}
+
+func TestReplayStopsOnNotificationFailure(t *testing.T) {
+	var notified []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		notified = append(notified, string(body))
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	path := replayFile(t, "first\nsecond\n")
+	err := run(context.Background(), []string{path}, replayEnv(dir, ts.URL))
+	if err == nil || !strings.Contains(err.Error(), "line 1: notification status 503") {
+		t.Fatalf("error = %v", err)
+	}
+	if !reflect.DeepEqual(notified, []string{"first"}) {
+		t.Fatalf("notified = %v", notified)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "first"))
+	if err != nil || string(data) != "queued\n" {
+		t.Fatalf("failed notification record = %q, %v", data, err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "second")); !os.IsNotExist(err) {
+		t.Fatalf("second record exists or stat failed unexpectedly: %v", err)
+	}
+}
