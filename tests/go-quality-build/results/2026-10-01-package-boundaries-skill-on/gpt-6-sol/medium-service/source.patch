+package submit
+
+import (
+	"context"
+	"fmt"
+	"strings"
+)
+
+// Store persists the record before notification.
+type Store interface {
+	Save(id string) error
+}
+
+// Notifier sends the outbound notification.
+type Notifier interface {
+	Notify(context.Context, string) error
+}
+
+// Run applies the validation and sequencing shared by all ingress paths.
+func Run(ctx context.Context, id string, store Store, notifier Notifier) error {
+	if id == "" || strings.ContainsAny(id, "/\\") || id == "." || id == ".." {
+		return fmt.Errorf("invalid id")
+	}
+	if err := store.Save(id); err != nil {
+		return err
+	}
+	return notifier.Notify(ctx, id)
+}
