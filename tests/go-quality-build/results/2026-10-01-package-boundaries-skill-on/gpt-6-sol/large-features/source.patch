+// Package invoicerow owns the ID,CENTS line format shared by settlement input
+// and the billing ledger.
+package invoicerow
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+)
+
+type Invoice struct {
+	ID    string
+	Cents int
+}
+
+func validate(invoice Invoice) error {
+	if invoice.ID == "" || strings.ContainsAny(invoice.ID, ",\r\n") || invoice.Cents <= 0 {
+		return fmt.Errorf("invalid invoice")
+	}
+	return nil
+}
+
+// Encode returns one ledger row, including its terminating newline.
+func Encode(invoice Invoice) (string, error) {
+	if err := validate(invoice); err != nil {
+		return "", err
+	}
+	return invoice.ID + "," + strconv.Itoa(invoice.Cents) + "\n", nil
+}
+
+// Decode parses one row, with or without its terminating newline.
+func Decode(line string) (Invoice, error) {
+	line = strings.TrimSuffix(line, "\n")
+	parts := strings.Split(line, ",")
+	if len(parts) != 2 || parts[1] == "" {
+		return Invoice{}, fmt.Errorf("invalid invoice row")
+	}
+	cents, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invalid invoice amount: %w", err)
+	}
+	invoice := Invoice{ID: parts[0], Cents: cents}
+	if err := validate(invoice); err != nil {
+		return Invoice{}, err
+	}
+	return invoice, nil
+}
+
+// Reader reads ledger or settlement rows in order.
+type Reader struct {
+	input *bufio.Reader
+}
+
+func NewReader(input io.Reader) *Reader { return &Reader{input: bufio.NewReader(input)} }
+
+func (r *Reader) Next() (Invoice, error) {
+	line, err := r.input.ReadString('\n')
+	if err != nil && err != io.EOF {
+		return Invoice{}, err
+	}
+	if err == io.EOF && line == "" {
+		return Invoice{}, io.EOF
+	}
+	return Decode(line)
+}
