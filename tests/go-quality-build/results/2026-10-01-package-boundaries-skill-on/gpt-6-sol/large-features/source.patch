+func TestRunStopsAtMalformedRow(t *testing.T) {
+	var charged []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		charged = append(charged, string(body))
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	ledger := filepath.Join(dir, "ledger")
+	if err := os.WriteFile(input, []byte("first,100\nbad,0\nthird,300\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("LEDGER", ledger)
+	t.Setenv("GATEWAY_URL", ts.URL)
+	if err := run([]string{input}); err == nil || !strings.Contains(err.Error(), "row 2") {
+		t.Fatalf("run error = %v", err)
+	}
+	if !reflect.DeepEqual(charged, []string{"first,100"}) {
+		t.Fatalf("charged = %v", charged)
+	}
+	data, err := os.ReadFile(ledger)
+	if err != nil || string(data) != "first,100\n" {
+		t.Fatalf("ledger = %q, %v", data, err)
+	}
+}
+
+func TestRunStopsAtGatewayFailure(t *testing.T) {
+	var charged []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		charged = append(charged, string(body))
+		if len(charged) == 2 {
+			w.WriteHeader(http.StatusPaymentRequired)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	ledger := filepath.Join(dir, "ledger")
+	if err := os.WriteFile(input, []byte("first,100\nsecond,200\nthird,300\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("LEDGER", ledger)
+	t.Setenv("GATEWAY_URL", ts.URL)
+	if err := run([]string{input}); err == nil || !strings.Contains(err.Error(), "row 2") {
+		t.Fatalf("run error = %v", err)
+	}
+	if !reflect.DeepEqual(charged, []string{"first,100", "second,200"}) {
+		t.Fatalf("charged = %v", charged)
+	}
+	data, err := os.ReadFile(ledger)
+	if err != nil || string(data) != "first,100\n" {
+		t.Fatalf("ledger = %q, %v", data, err)
+	}
