+package invoicerow
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestCodecAndReader(t *testing.T) {
+	row := Invoice{ID: "invoice-1", Cents: 250}
+	encoded, err := Encode(row)
+	if err != nil || encoded != "invoice-1,250\n" {
+		t.Fatalf("Encode = %q, %v", encoded, err)
+	}
+	reader := NewReader(strings.NewReader(encoded + "invoice-2,350"))
+	for _, want := range []Invoice{row, {ID: "invoice-2", Cents: 350}} {
+		got, err := reader.Next()
+		if err != nil || got != want {
+			t.Fatalf("Next = %+v, %v; want %+v", got, err, want)
+		}
+	}
+	if _, err := reader.Next(); err != io.EOF {
+		t.Fatalf("final Next = %v", err)
+	}
+}
+
+func TestRejectMalformedRows(t *testing.T) {
+	for _, row := range []string{"", "id", ",100", "id,", "id,0", "id,-1", "id,nope", "id,1,2", "id\r,1", "id,1\r\n", "id,1\nnext,2"} {
+		if _, err := Decode(row); err == nil {
+			t.Errorf("Decode(%q) succeeded", row)
+		}
+	}
+	for _, row := range []Invoice{{ID: "", Cents: 1}, {ID: "a,b", Cents: 1}, {ID: "a\nb", Cents: 1}, {ID: "a\rb", Cents: 1}, {ID: "ok", Cents: 0}} {
+		if _, err := Encode(row); err == nil {
+			t.Errorf("Encode(%+v) succeeded", row)
+		}
+	}
+}
