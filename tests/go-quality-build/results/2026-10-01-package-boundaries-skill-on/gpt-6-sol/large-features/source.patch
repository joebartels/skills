+package paymentgateway
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestRequestBytesAndStatus(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		if r.Method != http.MethodPost || string(body) != "invoice-1,250" {
+			t.Errorf("request = %s %q", r.Method, body)
+		}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	c := Client{HTTP: ts.Client(), URL: ts.URL}
+	if err := c.Charge(context.Background(), "invoice-1", 250); err != nil {
+		t.Fatal(err)
+	}
+}
