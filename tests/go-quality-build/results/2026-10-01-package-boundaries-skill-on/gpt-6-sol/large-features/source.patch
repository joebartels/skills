+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+
+	"example.com/commerce/internal/billing"
+	"example.com/commerce/internal/invoicerow"
+	"example.com/commerce/internal/paymentgateway"
+)
+
+func run(args []string) error {
+	if len(args) != 1 {
+		return fmt.Errorf("usage: settle FILE")
+	}
+	input, err := os.Open(args[0])
+	if err != nil {
+		return err
+	}
+	defer input.Close()
+	ledger, err := os.OpenFile(os.Getenv("LEDGER"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	defer ledger.Close()
+	service := billing.Service{Ledger: ledger, Gateway: &paymentgateway.Client{HTTP: &http.Client{Timeout: 5 * time.Second}, URL: os.Getenv("GATEWAY_URL")}}
+	rows := invoicerow.NewReader(input)
+	for rowNumber := 1; ; rowNumber++ {
+		invoice, err := rows.Next()
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return fmt.Errorf("row %d: %w", rowNumber, err)
+		}
+		if err := service.Charge(context.Background(), invoice.ID, invoice.Cents); err != nil {
+			return fmt.Errorf("row %d: %w", rowNumber, err)
+		}
+	}
+}
+
+func main() {
+	if err := run(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
