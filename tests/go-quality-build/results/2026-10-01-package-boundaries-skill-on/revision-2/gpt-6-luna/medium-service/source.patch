+// Package operation owns dispatch validation and sequencing.
+package operation
+
+import (
+	"context"
+	"fmt"
+	"strings"
+)
+
+// Store persists a validated dispatch record.
+type Store interface {
+	Save(ctx context.Context, id string) error
+}
+
+// Notifier sends a dispatch notification.
+type Notifier interface {
+	Notify(ctx context.Context, id string) error
+}
+
+// Service validates an ID, persists it, and notifies in that order.
+type Service struct {
+	Store    Store
+	Notifier Notifier
+}
+
+func (s *Service) Submit(ctx context.Context, id string) error {
+	if id == "" || strings.ContainsAny(id, "/\\") || id == "." || id == ".." {
+		return fmt.Errorf("invalid id")
+	}
+	if err := s.Store.Save(ctx, id); err != nil {
+		return err
+	}
+	return s.Notifier.Notify(ctx, id)
+}
