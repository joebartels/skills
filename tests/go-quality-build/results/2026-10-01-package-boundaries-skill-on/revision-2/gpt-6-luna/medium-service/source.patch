+// Package recordstore owns the on-disk dispatch record representation.
+package recordstore
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+)
+
+type Files struct{ Dir string }
+
+func (f Files) Save(_ context.Context, id string) error {
+	return os.WriteFile(filepath.Join(f.Dir, id), []byte("queued\n"), 0600)
+}
