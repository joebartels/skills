+package main
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"example.com/dispatch/internal/notifier"
+	"example.com/dispatch/internal/operation"
+	"example.com/dispatch/internal/recordstore"
+)
+
+func main() {
+	if len(os.Args) != 2 {
+		fmt.Fprintln(os.Stderr, "usage: replay <file>")
+		os.Exit(1)
+	}
+	file, err := os.Open(os.Args[1])
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	defer file.Close()
+
+	svc := &operation.Service{
+		Store:    recordstore.Files{Dir: os.Getenv("RECORD_DIR")},
+		Notifier: notifier.HTTP{URL: os.Getenv("NOTIFY_URL"), Client: &http.Client{Timeout: 5 * time.Second}},
+	}
+	if err := replay(context.Background(), file, svc); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+
+func replay(ctx context.Context, input *os.File, svc *operation.Service) error {
+	scanner := bufio.NewScanner(input)
+	for scanner.Scan() {
+		id := strings.TrimSpace(scanner.Text())
+		if id == "" {
+			continue
+		}
+		if err := svc.Submit(ctx, id); err != nil {
+			return fmt.Errorf("replay %q: %w", id, err)
+		}
+	}
+	return scanner.Err()
+}
