+package main
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/dispatch/internal/notifier"
+	"example.com/dispatch/internal/operation"
+	"example.com/dispatch/internal/recordstore"
+)
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func runReplay(t *testing.T, contents string, transport roundTripFunc) (string, error) {
+	t.Helper()
+	dir := t.TempDir()
+	input, err := os.CreateTemp(t.TempDir(), "ids")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := input.WriteString(contents); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := input.Seek(0, 0); err != nil {
+		t.Fatal(err)
+	}
+	client := &http.Client{Transport: transport}
+	svc := &operation.Service{Store: recordstore.Files{Dir: dir}, Notifier: notifier.HTTP{URL: "http://notify.invalid", Client: client}}
+	err = replay(context.Background(), input, svc)
+	input.Close()
+	return dir, err
+}
+
+func TestReplaySuccessTrimsAndSkipsBlankLines(t *testing.T) {
+	var notified []string
+	dir, err := runReplay(t, "  first \n\n second\n", func(r *http.Request) (*http.Response, error) {
+		b, _ := io.ReadAll(r.Body)
+		notified = append(notified, string(b))
+		return &http.Response{StatusCode: http.StatusNoContent, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header), Request: r}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(notified, ",") != "first,second" {
+		t.Fatalf("notifications = %v", notified)
+	}
+	for _, id := range []string{"first", "second"} {
+		b, err := os.ReadFile(filepath.Join(dir, id))
+		if err != nil || string(b) != "queued\n" {
+			t.Fatalf("record %q = %q, %v", id, b, err)
+		}
+	}
+}
+
+func TestReplayInvalidIDStops(t *testing.T) {
+	var notified []string
+	dir, err := runReplay(t, "first\n../bad\nafter\n", func(r *http.Request) (*http.Response, error) {
+		b, _ := io.ReadAll(r.Body)
+		notified = append(notified, string(b))
+		return &http.Response{StatusCode: http.StatusNoContent, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header), Request: r}, nil
+	})
+	if err == nil {
+		t.Fatal("expected invalid ID error")
+	}
+	if strings.Join(notified, ",") != "first" {
+		t.Fatalf("notifications after invalid ID = %v", notified)
+	}
+	if _, statErr := os.Stat(filepath.Join(dir, "after")); !os.IsNotExist(statErr) {
+		t.Fatalf("later record exists or stat failed unexpectedly: %v", statErr)
+	}
+}
+
+func TestReplayNotificationFailureStopsAndKeepsRecord(t *testing.T) {
+	var calls int
+	dir, err := runReplay(t, "first\nafter\n", func(r *http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: http.StatusServiceUnavailable, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header), Request: r}, nil
+	})
+	if err == nil {
+		t.Fatal("expected notification error")
+	}
+	if calls != 1 {
+		t.Fatalf("notification calls = %d", calls)
+	}
+	if b, readErr := os.ReadFile(filepath.Join(dir, "first")); readErr != nil || string(b) != "queued\n" {
+		t.Fatalf("failed notification record = %q, %v", b, readErr)
+	}
+	if _, statErr := os.Stat(filepath.Join(dir, "after")); !os.IsNotExist(statErr) {
+		t.Fatalf("later record exists or stat failed unexpectedly: %v", statErr)
+	}
+}
