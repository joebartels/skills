+package replay
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/dispatch"
+)
+
+func TestRunSequentialAndSkipsBlankLines(t *testing.T) {
+	var got []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { got = append(got, r.URL.Path); w.WriteHeader(204) }))
+	defer ts.Close()
+	dir := t.TempDir()
+	s := &dispatch.Service{Dir: dir, NotifyURL: ts.URL, Client: ts.Client()}
+	if err := Run(context.Background(), strings.NewReader(" a \n\n b\n"), s); err != nil {
+		t.Fatal(err)
+	}
+	for _, id := range []string{"a", "b"} {
+		b, err := os.ReadFile(filepath.Join(dir, id))
+		if err != nil || string(b) != "queued\n" {
+			t.Fatalf("%s: %q %v", id, b, err)
+		}
+	}
+	if len(got) != 2 {
+		t.Fatalf("notifications: %v", got)
+	}
+}
+
+func TestRunStopsOnInvalidID(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	defer ts.Close()
+	dir := t.TempDir()
+	s := &dispatch.Service{Dir: dir, NotifyURL: ts.URL, Client: ts.Client()}
+	if err := Run(context.Background(), strings.NewReader("first\n../bad\nlast\n"), s); err == nil {
+		t.Fatal("expected invalid ID failure")
+	}
+	if _, err := os.Stat(filepath.Join(dir, "last")); !os.IsNotExist(err) {
+		t.Fatalf("processed after failure: %v", err)
+	}
+}
+
+func TestRunStopsOnNotificationFailure(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(503) }))
+	defer ts.Close()
+	dir := t.TempDir()
+	s := &dispatch.Service{Dir: dir, NotifyURL: ts.URL, Client: ts.Client()}
+	if err := Run(context.Background(), strings.NewReader("one\ntwo\n"), s); err == nil {
+		t.Fatal("expected notification failure")
+	}
+	if _, err := os.Stat(filepath.Join(dir, "one")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "two")); !os.IsNotExist(err) {
+		t.Fatalf("processed after failure: %v", err)
+	}
+}
