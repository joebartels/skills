+package records
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+)
+
+type Store struct{ Dir string }
+
+func (s Store) Write(_ context.Context, id string) error {
+	return os.WriteFile(filepath.Join(s.Dir, id), []byte("queued\n"), 0600)
+}
