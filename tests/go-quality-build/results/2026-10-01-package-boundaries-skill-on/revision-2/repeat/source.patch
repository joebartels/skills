+package replay
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"strings"
+
+	"example.com/dispatch"
+)
+
+func Run(ctx context.Context, input io.Reader, service *dispatch.Service) error {
+	scanner := bufio.NewScanner(input)
+	line := 0
+	for scanner.Scan() {
+		line++
+		id := strings.TrimSpace(scanner.Text())
+		if id == "" {
+			continue
+		}
+		if err := service.Submit(ctx, id); err != nil {
+			return fmt.Errorf("line %d: %w", line, err)
+		}
+	}
+	return scanner.Err()
+}
