+package main
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"example.com/dispatch"
+	"example.com/dispatch/internal/recordstore"
+)
+
+type notifyFunc func(context.Context, string) error
+
+func (f notifyFunc) Notify(ctx context.Context, id string) error { return f(ctx, id) }
+
+func replayService(dir string, notify notifyFunc) *dispatch.Service {
+	return &dispatch.Service{Store: recordstore.Store{Dir: dir}, Notifier: notify}
+}
+
+func TestProcessSuccess(t *testing.T) {
+	var got []string
+	dir := t.TempDir()
+	notify := notifyFunc(func(_ context.Context, id string) error { got = append(got, id); return nil })
+	if err := process(strings.NewReader("  first  \n\n second\n"), replayService(dir, notify)); err != nil {
+		t.Fatal(err)
+	}
+	if strings.Join(got, ",") != "first,second" {
+		t.Fatalf("notifications = %v", got)
+	}
+	for _, id := range []string{"first", "second"} {
+		b, err := os.ReadFile(filepath.Join(dir, id))
+		if err != nil || string(b) != "queued\n" {
+			t.Fatalf("record %q = %q, error %v", id, b, err)
+		}
+	}
+}
+
+func TestProcessInvalidIDStops(t *testing.T) {
+	var got []string
+	dir := t.TempDir()
+	notify := notifyFunc(func(_ context.Context, id string) error { got = append(got, id); return nil })
+	err := process(strings.NewReader("first\n../bad\nlast\n"), replayService(dir, notify))
+	if err == nil || !strings.Contains(err.Error(), "line 2") {
+		t.Fatalf("process error = %v", err)
+	}
+	if strings.Join(got, ",") != "first" {
+		t.Fatalf("notifications before invalid ID = %v", got)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "last")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("last record exists or unexpected stat error: %v", err)
+	}
+}
+
+func TestProcessNotificationFailureStops(t *testing.T) {
+	calls := 0
+	notify := notifyFunc(func(context.Context, string) error {
+		calls++
+		return errors.New("notification failed")
+	})
+	dir := t.TempDir()
+	err := process(strings.NewReader("first\nsecond\n"), replayService(dir, notify))
+	if err == nil || calls != 1 {
+		t.Fatalf("process error = %v, notifications = %d", err, calls)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "first")); err != nil {
+		t.Fatalf("first record missing after notification failure: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "second")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("second record exists or unexpected stat error: %v", err)
+	}
+}
