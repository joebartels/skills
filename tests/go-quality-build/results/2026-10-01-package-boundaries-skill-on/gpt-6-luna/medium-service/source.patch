+package main
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"example.com/dispatch"
+	"example.com/dispatch/internal/notifyclient"
+	"example.com/dispatch/internal/recordstore"
+)
+
+func main() {
+	if err := run(os.Args[1:], os.Stderr); err != nil {
+		os.Exit(1)
+	}
+}
+
+func run(args []string, stderr io.Writer) error {
+	if len(args) != 1 {
+		fmt.Fprintln(stderr, "usage: replay FILE")
+		return fmt.Errorf("expected one file argument")
+	}
+	f, err := os.Open(args[0])
+	if err != nil {
+		fmt.Fprintf(stderr, "open replay file: %v\n", err)
+		return err
+	}
+	defer f.Close()
+
+	s := &dispatch.Service{
+		Store: recordstore.Store{Dir: os.Getenv("RECORD_DIR")},
+		Notifier: notifyclient.Client{
+			URL: os.Getenv("NOTIFY_URL"), Client: &http.Client{Timeout: 5 * time.Second},
+		},
+	}
+	if err := process(f, s); err != nil {
+		fmt.Fprintf(stderr, "replay failed: %v\n", err)
+		return err
+	}
+	return nil
+}
+
+func process(r io.Reader, s *dispatch.Service) error {
+	scanner := bufio.NewScanner(r)
+	lineNo := 0
+	for scanner.Scan() {
+		lineNo++
+		id := strings.TrimSpace(scanner.Text())
+		if id == "" {
+			continue
+		}
+		if err := s.Submit(context.Background(), id); err != nil {
+			return fmt.Errorf("line %d: %w", lineNo, err)
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return err
+	}
+	return nil
+}
