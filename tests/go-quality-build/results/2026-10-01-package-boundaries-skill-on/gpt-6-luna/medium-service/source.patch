+package recordstore
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+)
+
+// Store writes the dispatch record representation to disk.
+type Store struct{ Dir string }
+
+func (s Store) Save(_ context.Context, id string) error {
+	return os.WriteFile(filepath.Join(s.Dir, id), []byte("queued\n"), 0600)
+}
