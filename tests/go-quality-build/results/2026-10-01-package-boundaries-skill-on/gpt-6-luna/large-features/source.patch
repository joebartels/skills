+package gatewayhttp
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(req *http.Request) (*http.Response, error) { return f(req) }
+
+func TestClientPreservesGatewayRequestBytes(t *testing.T) {
+	client := Client{HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		if r.Method != http.MethodPost {
+			t.Errorf("method = %s", r.Method)
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		if string(body) != "invoice-1,250" {
+			t.Errorf("body = %q", body)
+		}
+		return &http.Response{StatusCode: http.StatusNoContent, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+	})}, URL: "http://gateway.test/charge"}
+	if err := client.Charge(context.Background(), "invoice-1", 250); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestClientRejectsNon204(t *testing.T) {
+	client := Client{HTTP: &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: http.StatusPaymentRequired, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+	})}, URL: "http://gateway.test/charge"}
+	if err := client.Charge(context.Background(), "invoice-1", 250); err == nil {
+		t.Fatal("expected gateway status error")
+	}
+}
