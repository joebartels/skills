+package invoicecodec
+
+import (
+	"bytes"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestEncodeDecodeRows(t *testing.T) {
+	var ledger bytes.Buffer
+	for _, invoice := range []Invoice{{ID: "one", Cents: 25}, {ID: "two", Cents: 50}} {
+		if err := Encode(&ledger, invoice); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got, want := ledger.String(), "one,25\ntwo,50\n"; got != want {
+		t.Fatalf("encoded %q, want %q", got, want)
+	}
+	got, err := DecodeAll(strings.NewReader(ledger.String()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []Invoice{{ID: "one", Cents: 25}, {ID: "two", Cents: 50}}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("decoded %#v, want %#v", got, want)
+	}
+}
+
+func TestDecodeRejectsMalformedRows(t *testing.T) {
+	for _, row := range []string{"", "no-cents", "id,", "id,0", "id,-2", "id,2x", "id,2,extra", ",2", "id\r,2"} {
+		t.Run(row, func(t *testing.T) {
+			if _, err := DecodeRow(row); err == nil {
+				t.Fatalf("DecodeRow(%q) succeeded", row)
+			}
+		})
+	}
+}
+
+func TestValidateRejectsDelimiterAndNewlineIDs(t *testing.T) {
+	for _, id := range []string{"", "a,b", "a\nb", "a\rb"} {
+		if err := Validate(Invoice{ID: id, Cents: 1}); err == nil {
+			t.Errorf("Validate(%q) succeeded", id)
+		}
+	}
+}
+
+func TestReaderStopsAtMalformedRow(t *testing.T) {
+	r := NewReader(strings.NewReader("one,25\nbad\ntwo,50\n"))
+	if got, err := r.Next(); err != nil || got.ID != "one" {
+		t.Fatalf("first row = %#v, %v", got, err)
+	}
+	if _, err := r.Next(); err == nil || err == io.EOF {
+		t.Fatalf("malformed row error = %v", err)
+	}
+}
