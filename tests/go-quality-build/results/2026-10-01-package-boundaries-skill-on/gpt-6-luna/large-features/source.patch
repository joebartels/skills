+package main
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+
+	"example.com/commerce/internal/billing"
+	"example.com/commerce/internal/gatewayhttp"
+	"example.com/commerce/internal/invoicecodec"
+)
+
+func run(args []string) error {
+	if len(args) != 1 {
+		return fmt.Errorf("usage: settle FILE")
+	}
+	input, err := os.Open(args[0])
+	if err != nil {
+		return err
+	}
+	defer input.Close()
+	ledger, err := os.OpenFile(os.Getenv("LEDGER"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	defer ledger.Close()
+	service := billing.Service{
+		Ledger:  ledger,
+		Gateway: &gatewayhttp.Client{HTTP: &http.Client{Timeout: 5 * time.Second}, URL: os.Getenv("GATEWAY_URL")},
+	}
+	return settle(context.Background(), input, &service)
+}
+
+func settle(ctx context.Context, input io.Reader, service *billing.Service) error {
+	rows := invoicecodec.NewReader(input)
+	for {
+		invoice, err := rows.Next()
+		if err == io.EOF {
+			return nil
+		}
+		if err != nil {
+			return err
+		}
+		if err := service.Charge(ctx, invoice.ID, invoice.Cents); err != nil {
+			return fmt.Errorf("charge invoice %q: %w", invoice.ID, err)
+		}
+	}
+}
+
+func main() {
+	if err := run(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
