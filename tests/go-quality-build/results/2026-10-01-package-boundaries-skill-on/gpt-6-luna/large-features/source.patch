+// Package invoicecodec reads and writes the ID,CENTS row format shared by
+// billing and operations.
+package invoicecodec
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+)
+
+// Invoice is one row in an invoice input file or billing ledger.
+type Invoice struct {
+	ID    string
+	Cents int
+}
+
+// Encode writes one canonical ledger row.
+func Encode(w io.Writer, invoice Invoice) error {
+	if err := Validate(invoice); err != nil {
+		return err
+	}
+	_, err := fmt.Fprintf(w, "%s,%d\n", invoice.ID, invoice.Cents)
+	return err
+}
+
+// Reader decodes one newline-terminated or final unterminated row at a time.
+type Reader struct {
+	scanner *bufio.Scanner
+	line    int
+}
+
+func NewReader(r io.Reader) *Reader {
+	s := bufio.NewScanner(r)
+	// Invoice rows are small in practice; report an error for rows over 1 MiB.
+	s.Buffer(make([]byte, 1024), 1024*1024)
+	return &Reader{scanner: s}
+}
+
+// Next returns the next invoice. It returns io.EOF after the last row.
+func (r *Reader) Next() (Invoice, error) {
+	if !r.scanner.Scan() {
+		if err := r.scanner.Err(); err != nil {
+			return Invoice{}, fmt.Errorf("read invoice row: %w", err)
+		}
+		return Invoice{}, io.EOF
+	}
+	r.line++
+	row, err := DecodeRow(r.scanner.Text())
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invoice row %d: %w", r.line, err)
+	}
+	return row, nil
+}
+
+// DecodeAll reads every row using the same decoder used for settlement input.
+func DecodeAll(r io.Reader) ([]Invoice, error) {
+	rows := NewReader(r)
+	var invoices []Invoice
+	for {
+		invoice, err := rows.Next()
+		if err == io.EOF {
+			return invoices, nil
+		}
+		if err != nil {
+			return nil, err
+		}
+		invoices = append(invoices, invoice)
+	}
+}
+
+// DecodeRow parses one ID,CENTS row without its line ending.
+func DecodeRow(row string) (Invoice, error) {
+	if strings.ContainsAny(row, "\r\n") {
+		return Invoice{}, fmt.Errorf("invalid invoice row")
+	}
+	parts := strings.Split(row, ",")
+	if len(parts) != 2 || parts[1] == "" {
+		return Invoice{}, fmt.Errorf("expected ID,CENTS")
+	}
+	for _, digit := range parts[1] {
+		if digit < '0' || digit > '9' {
+			return Invoice{}, fmt.Errorf("invalid cents %q", parts[1])
+		}
+	}
+	cents, err := strconv.Atoi(parts[1])
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invalid cents %q: %w", parts[1], err)
+	}
+	invoice := Invoice{ID: parts[0], Cents: cents}
+	if err := Validate(invoice); err != nil {
+		return Invoice{}, err
+	}
+	return invoice, nil
+}
+
+// Validate checks the constraints required by both the row format and billing.
+func Validate(invoice Invoice) error {
+	if invoice.ID == "" || strings.ContainsAny(invoice.ID, ",\r\n") || invoice.Cents <= 0 {
+		return fmt.Errorf("invalid invoice")
+	}
+	return nil
+}
