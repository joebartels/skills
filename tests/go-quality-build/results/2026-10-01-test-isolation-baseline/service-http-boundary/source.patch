+func TestFetchCancellation(t *testing.T) {
+	for _, phase := range []string{"before response headers", "while reading response body"} {
+		t.Run(phase, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			started := make(chan struct{})
+			handlerResult := make(chan error, 1)
+			release := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if phase == "while reading response body" {
+					w.Header().Set("Content-Type", "application/json")
+					if _, err := io.WriteString(w, `{"name":"unfinished`); err != nil {
+						handlerResult <- err
+						return
+					}
+					w.(http.Flusher).Flush()
+				}
+				close(started)
+				select {
+				case <-r.Context().Done():
+					handlerResult <- r.Context().Err()
+				case <-release:
+					handlerResult <- errors.New("handler released during cleanup before cancellation")
+				}
+			}))
+			client := server.Client()
+			client.Timeout = 5 * time.Second
+			bodies := make(chan *readSignalBody, 1)
+			if phase == "while reading response body" {
+				transport := client.Transport
+				client.Transport = roundTrip(func(r *http.Request) (*http.Response, error) {
+					response, err := transport.RoundTrip(r)
+					if err != nil {
+						return nil, err
+					}
+					body := &readSignalBody{ReadCloser: response.Body, read: make(chan struct{})}
+					response.Body = body
+					bodies <- body
+					return response, nil
+				})
+				// The decorator does not expose CloseIdleConnections, so retain
+				// cleanup for the owned underlying transport explicitly.
+				t.Cleanup(transport.(*http.Transport).CloseIdleConnections)
+			}
+			type fetchResult struct {
+				metadata metadata.Metadata
+				err      error
+			}
+			result := make(chan fetchResult, 1)
+			finished := make(chan struct{})
+			t.Cleanup(func() {
+				cancel()
+				close(release)
+				select {
+				case <-finished:
+				case <-time.After(6 * time.Second):
+					t.Error("Fetch goroutine did not exit during cleanup")
+				}
+				client.CloseIdleConnections()
+				server.Close()
+			})
+			go func() {
+				defer close(finished)
+				got, err := metadata.Fetch(ctx, client, server.URL+"/catalog")
+				result <- fetchResult{metadata: got, err: err}
+			}()
+			select {
+			case <-started:
+			case got := <-result:
+				t.Fatalf("Fetch returned before the handler barrier: %#v, %v", got.metadata, got.err)
+			case err := <-handlerResult:
+				t.Fatalf("HTTP handler failed before the cancellation barrier: %v", err)
+			case <-time.After(5 * time.Second):
+				t.Fatal("HTTP handler did not reach the cancellation barrier")
+			}
+			var body *readSignalBody
+			if phase == "while reading response body" {
+				select {
+				case body = <-bodies:
+				case got := <-result:
+					t.Fatalf("Fetch returned before acquiring a response body: %#v, %v", got.metadata, got.err)
+				case <-time.After(5 * time.Second):
+					t.Fatal("transport did not return the response body")
+				}
+				select {
+				case <-body.read:
+				case got := <-result:
+					t.Fatalf("Fetch returned before reading the partial response body: %#v, %v", got.metadata, got.err)
+				case <-time.After(5 * time.Second):
+					t.Fatal("Fetch did not read the partial response body")
+				}
+			}
+			cancel()
+			select {
+			case got := <-result:
+				assertFailure(t, got.metadata, got.err)
+				if !errors.Is(got.err, context.Canceled) {
+					t.Errorf("Fetch error = %v, want errors.Is(err, context.Canceled)", got.err)
+				}
+				if body != nil && body.closeCalls != 1 {
+					t.Errorf("canceled response body closed %d times, want 1", body.closeCalls)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("Fetch did not return after caller cancellation")
+			}
+			select {
+			case err := <-handlerResult:
+				if !errors.Is(err, context.Canceled) {
+					t.Errorf("server request error = %v, want context.Canceled", err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("caller cancellation did not reach the server request")
+			}
+		})
+	}
+}
