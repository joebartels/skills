+// readSignalBody observes the real transport's body without changing its I/O.
+// The signal proves that Fetch received and read response bytes before cancel.
+type readSignalBody struct {
+	io.ReadCloser
+	read       chan struct{}
+	readOnce   sync.Once
+	closeCalls int
+}
+
+func (b *readSignalBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	if n > 0 {
+		b.readOnce.Do(func() { close(b.read) })
+	}
+	return n, err
+}
+
+func (b *readSignalBody) Close() error {
+	b.closeCalls++
+	return b.ReadCloser.Close()
+}
