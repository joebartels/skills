+// The httptest fixtures use real loopback HTTP and the standard transport. They
+// verify wire request details and cancellation across http.Client and server
+// request contexts; they require permission to bind a local TCP listener.
+func TestFetchHTTPRequest(t *testing.T) {
+	type requestDetails struct {
+		method     string
+		requestURI string
+	}
+	requests := make(chan requestDetails, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case requests <- requestDetails{method: r.Method, requestURI: r.RequestURI}:
+		default:
+		}
+		w.Header().Set("Content-Type", "application/json")
+		io.WriteString(w, `{"name":"network","revision":3}`)
+	}))
+	client := server.Client()
+	client.Timeout = 5 * time.Second
+	t.Cleanup(func() {
+		client.CloseIdleConnections()
+		server.Close()
+	})
+	const pathAndQuery = "/catalog/a%2Fb?tag=one&tag=two&space=a%20b&plus=a%2Bb"
+	got, err := metadata.Fetch(context.Background(), client, server.URL+pathAndQuery)
+	if err != nil {
+		t.Fatalf("Fetch error = %v", err)
+	}
+	if want := (metadata.Metadata{Name: "network", Revision: 3}); got != want {
+		t.Errorf("Fetch = %#v, want %#v", got, want)
+	}
+	select {
+	case request := <-requests:
+		if request.method != http.MethodGet || request.requestURI != pathAndQuery {
+			t.Errorf("request = %#v, want GET %q", request, pathAndQuery)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("server did not observe the request")
+	}
+}
