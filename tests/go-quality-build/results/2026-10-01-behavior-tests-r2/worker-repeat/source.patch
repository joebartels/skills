+		t.Fatalf("first Run = %v", err)
+	}
+	secondAtJoin := calls[1].Load()
+	for await(t, starts[1], "second instance recurring after first joined") <= secondAtJoin {
+	}
+	if releases[0].Load() != 1 || releases[1].Load() != 0 {
+		t.Fatalf("release counts after first join = %d, %d; want 1, 0", releases[0].Load(), releases[1].Load())
+	}
+	hosts[1].cancel()
+	if err := hosts[1].wait(t); err != nil {
+		t.Fatalf("second Run = %v", err)
