+type batchReader struct {
+	t         *testing.T
+	dir       string
+	reads     int
+	inputFail error
+}
+
+func (r *batchReader) Read(p []byte) (int, error) {
+	r.reads++
+	if r.reads == 1 {
+		return copy(p, "web,7\n"), nil
+	}
+	// The first effect must be visible before a subsequent read can succeed or fail.
+	checkFiles(r.t, r.dir, map[string]string{"web": "7\n"})
+	return 0, r.inputFail
+}
+
+func TestRunStreamsBeforeReadingNextRecord(t *testing.T) {
+	// Use only two reads so the observer checks the one-record prefix.
+	dir := t.TempDir()
+	errInput := errors.New("input unavailable")
+	reader := &batchReader{t: t, dir: dir, inputFail: errInput}
+	err := run([]string{"--dir", dir}, reader, io.Discard)
+	if !errors.Is(err, errInput) {
+		t.Fatalf("run error = %v, want input failure", err)
+	}
+	if reader.reads != 2 {
+		t.Errorf("reads = %d, want 2", reader.reads)
+	}
+	checkFiles(t, dir, map[string]string{"web": "7\n"})
+}
