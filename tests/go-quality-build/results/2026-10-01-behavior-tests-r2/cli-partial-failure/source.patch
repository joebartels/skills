+func buildCLI(t *testing.T) string {
+	t.Helper()
+	binary := filepath.Join(t.TempDir(), "ledgerload")
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "go", "build", "-o", binary, ".")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("build CLI: %v\n%s", err, output)
+	}
+	return binary
+}
+
+func checkProcess(t *testing.T, cmd *exec.Cmd, input string, wantExit int, diagnostic string) {
+	t.Helper()
+	var stdout, stderr bytes.Buffer
+	cmd.Stdin = strings.NewReader(input)
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	if cmd.ProcessState == nil {
+		t.Fatalf("start process: %v", err)
+	}
+	if exit := cmd.ProcessState.ExitCode(); exit != wantExit {
+		t.Fatalf("exit = %d, want %d; error = %v; stdout = %q; stderr = %q", exit, wantExit, err, stdout.String(), stderr.String())
+	}
+	if stdout.Len() != 0 {
+		t.Errorf("stdout = %q, want empty", stdout.String())
+	}
+	if wantExit == 0 && stderr.Len() != 0 {
+		t.Errorf("stderr = %q, want empty", stderr.String())
+	}
+	if wantExit != 0 && !strings.Contains(stderr.String(), diagnostic) {
+		t.Errorf("stderr = %q, want diagnostic containing %q", stderr.String(), diagnostic)
+	}
+}
+
+func runCLI(t *testing.T, binary string, args []string, input string, wantExit int, diagnostic string) {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	checkProcess(t, exec.CommandContext(ctx, binary, args...), input, wantExit, diagnostic)
+}
+
+func checkFiles(t *testing.T, dir string, files map[string]string, directories ...string) {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != len(files)+len(directories) {
+		t.Errorf("directory entries = %v, want only files %v and directories %v", entries, files, directories)
+	}
+	for name, want := range files {
+		got, err := os.ReadFile(filepath.Join(dir, name))
+		if err != nil || string(got) != want {
+			t.Errorf("%s = %q, %v; want %q", name, got, err, want)
+		}
+	}
+	for _, name := range directories {
+		info, err := os.Stat(filepath.Join(dir, name))
+		if err != nil || !info.IsDir() {
+			t.Errorf("%s directory missing: %v", name, err)
+		}
+	}
+}
