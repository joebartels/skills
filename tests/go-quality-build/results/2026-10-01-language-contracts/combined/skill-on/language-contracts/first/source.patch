+func TestCLIContracts(t *testing.T) {
+	dir := t.TempDir()
+	binary := filepath.Join(dir, "batchview")
+	cache := filepath.Join(dir, "gocache")
+	build := exec.Command("go", "build", "-o", binary, ".")
+	build.Env = withEnv(os.Environ(), "GOWORK", "off", "GOCACHE", cache)
+	build.Dir = "."
+	if output, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("build CLI: %v\n%s", err, output)
+	}
+
+	t.Run("success with dash-prefixed paths and prefix", func(t *testing.T) {
+		work := t.TempDir()
+		if err := os.WriteFile(filepath.Join(work, "-input"), []byte("# comment\na=one\nb=two\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		cmd := exec.Command(binary, "-input", "-output", "a")
+		cmd.Dir = work
+		var stdout, stderr strings.Builder
+		cmd.Stdout, cmd.Stderr = &stdout, &stderr
+		if err := cmd.Run(); err != nil {
+			t.Fatalf("run: %v; stderr=%q", err, stderr.String())
+		}
+		got, err := os.ReadFile(filepath.Join(work, "-output"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(got) != `[{"key":"a","tags":{"data":"b25l"}}]` || stdout.Len() != 0 || stderr.Len() != 0 {
+			t.Fatalf("output=%s stdout=%q stderr=%q", got, stdout.String(), stderr.String())
+		}
+	})
+
+	t.Run("writes prefix after malformed input", func(t *testing.T) {
+		work := t.TempDir()
+		if err := os.WriteFile(filepath.Join(work, "in"), []byte("a=one\nbroken\nc=three\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		cmd := exec.Command(binary, "in", "out", "a")
+		cmd.Dir = work
+		var stdout, stderr strings.Builder
+		cmd.Stdout, cmd.Stderr = &stdout, &stderr
+		err := cmd.Run()
+		if exit, ok := err.(*exec.ExitError); !ok || exit.ExitCode() != 1 {
+			t.Fatalf("run error = %v, want exit 1", err)
+		}
+		got, readErr := os.ReadFile(filepath.Join(work, "out"))
+		if readErr != nil {
+			t.Fatal(readErr)
+		}
+		if string(got) != `[{"key":"a","tags":{"data":"b25l"}}]` || !strings.Contains(stderr.String(), "malformed item") || stdout.Len() != 0 {
+			t.Fatalf("output=%s stdout=%q stderr=%q", got, stdout.String(), stderr.String())
+		}
+	})
+
+	t.Run("usage exits two", func(t *testing.T) {
+		cmd := exec.Command(binary, "only-one")
+		var stdout, stderr strings.Builder
+		cmd.Stdout, cmd.Stderr = &stdout, &stderr
+		err := cmd.Run()
+		if exit, ok := err.(*exec.ExitError); !ok || exit.ExitCode() != 2 {
+			t.Fatalf("run error = %v, want exit 2", err)
+		}
+		if stdout.Len() != 0 || !strings.Contains(stderr.String(), "usage: batchview INPUT OUTPUT [PREFIX]") {
+			t.Fatalf("stdout=%q stderr=%q", stdout.String(), stderr.String())
+		}
+	})
+
+	t.Run("output failure exits one", func(t *testing.T) {
+		work := t.TempDir()
+		if err := os.WriteFile(filepath.Join(work, "in"), []byte("a=one\n"), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Mkdir(filepath.Join(work, "out"), 0700); err != nil {
+			t.Fatal(err)
+		}
+		cmd := exec.Command(binary, "in", "out")
+		cmd.Dir = work
+		var stdout, stderr strings.Builder
+		cmd.Stdout, cmd.Stderr = &stdout, &stderr
+		err := cmd.Run()
+		if exit, ok := err.(*exec.ExitError); !ok || exit.ExitCode() != 1 {
+			t.Fatalf("run error = %v, want exit 1", err)
+		}
+		if stdout.Len() != 0 || stderr.Len() == 0 {
+			t.Fatalf("stdout=%q stderr=%q", stdout.String(), stderr.String())
+		}
+	})
+}
+
+func withEnv(env []string, key, value string, more ...string) []string {
+	updates := map[string]string{key: value}
+	for i := 0; i+1 < len(more); i += 2 {
+		updates[more[i]] = more[i+1]
+	}
+	out := make([]string, 0, len(env)+len(updates))
+	for _, entry := range env {
+		name, _, ok := strings.Cut(entry, "=")
+		if _, replace := updates[name]; !ok || !replace {
+			out = append(out, entry)
+		}
+	}
+	for name, value := range updates {
+		out = append(out, name+"="+value)
+	}
+	return out
+}
