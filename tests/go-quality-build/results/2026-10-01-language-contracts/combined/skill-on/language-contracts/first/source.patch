+// Load reads key=payload lines from r. Blank lines and lines beginning with
+// # are ignored. It returns the valid prefix when malformed input or a read
+// error stops the load. A non-EOF read error remains inspectable with
+// errors.Is. Bytes returned by r alongside an error are processed first.
+// The reader remains borrowed; Load does not close it.
 func Load(r io.Reader) ([]Item, error) {
-	data, err := io.ReadAll(r)
-	if err != nil {
-		return nil, err
+	data, readErr := io.ReadAll(r)
+	items, parseErr := parse(data)
+	if parseErr != nil && readErr != nil {
+		return items, errors.Join(parseErr, readErr)
 	}
+	if parseErr != nil {
+		return items, parseErr
+	}
+	return items, readErr
+}
+
+func parse(data []byte) ([]Item, error) {
 	var out []Item
 	for _, line := range strings.Split(string(data), "\n") {
-		if line == "" {
+		if line == "" || strings.HasPrefix(line, "#") {
 			continue
 		}
 		key, value, ok := strings.Cut(line, "=")
@@ -29,3 +42,32 @@ func Load(r io.Reader) ([]Item, error) {
 	}
 	return out, nil
 }
+
+// Select returns an independently editable snapshot of items whose keys have
+// prefix. An empty prefix selects every item. A nil input returns nil; a
+// non-nil input returns a non-nil slice even when nothing matches. Nested maps
+// and byte slices are copied so edits to either side do not affect the other.
+func Select(items []Item, prefix string) []Item {
+	if items == nil {
+		return nil
+	}
+	out := make([]Item, 0, len(items))
+	for _, item := range items {
+		if !strings.HasPrefix(item.Key, prefix) {
+			continue
+		}
+		copyItem := Item{Key: item.Key}
+		if item.Tags != nil {
+			copyItem.Tags = make(map[string][]byte, len(item.Tags))
+			for key, value := range item.Tags {
+				if value == nil {
+					copyItem.Tags[key] = nil
+					continue
+				}
+				copyItem.Tags[key] = append([]byte{}, value...)
+			}
+		}
+		out = append(out, copyItem)
+	}
+	return out
+}
