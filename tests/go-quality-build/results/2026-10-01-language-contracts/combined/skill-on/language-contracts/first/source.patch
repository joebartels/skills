+type bytesAndErrorReader struct {
+	data []byte
+	err  error
+}
+
+func (r bytesAndErrorReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, r.err
+	}
+	n := copy(p, r.data)
+	return n, r.err
+}
+
+func TestLoadProcessesBytesReturnedWithReadError(t *testing.T) {
+	cause := errors.New("source failed")
+	got, err := Load(bytesAndErrorReader{data: []byte("a=one\nb=two\n"), err: cause})
+	if len(got) != 2 || got[1].Key != "b" || !errors.Is(err, cause) {
+		t.Fatalf("Load() = %#v, %v; want both items and inspectable cause", got, err)
+	}
+}
