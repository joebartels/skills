diff --git a/cmd/batchview/main_test.go b/cmd/batchview/main_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..faf2677f1d574fcc5f4dcb958002ffceb3ac0c62
--- /dev/null
+++ b/cmd/batchview/main_test.go
@@ -0,0 +1,94 @@
+package main
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func captureStderr(t *testing.T, call func() int) (int, string) {
+	t.Helper()
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	old := os.Stderr
+	os.Stderr = write
+	code := call()
+	os.Stderr = old
+	if err := write.Close(); err != nil {
+		t.Fatal(err)
+	}
+	data, err := io.ReadAll(read)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := read.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return code, string(data)
+}
+
+func TestRunOptionalPrefixAndPartialOutputWithDashPaths(t *testing.T) {
+	oldwd, err := os.Getwd()
+	if err != nil {
+		t.Fatal(err)
+	}
+	dir := t.TempDir()
+	if err := os.Chdir(dir); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chdir(oldwd) })
+	if err := os.WriteFile("-input", []byte("# comment\napple=red\nberry=blue\ninvalid\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	code, stderr := captureStderr(t, func() int { return run([]string{"-input", "-output", "app"}) })
+	if code != 1 || stderr != "malformed item\n" {
+		t.Fatalf("run = %d, stderr %q", code, stderr)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, "-output"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := string(data), `[{"key":"apple","tags":{"data":"cmVk"}}]`; got != want {
+		t.Fatalf("output = %s, want %s", got, want)
+	}
+}
+
+func TestRunSuccessHasEmptyStderr(t *testing.T) {
+	dir := t.TempDir()
+	input := filepath.Join(dir, "in")
+	output := filepath.Join(dir, "out")
+	if err := os.WriteFile(input, []byte("apple=red\nberry=blue\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	code, stderr := captureStderr(t, func() int { return run([]string{input, output, "ber"}) })
+	if code != 0 || stderr != "" {
+		t.Fatalf("run = %d, stderr %q", code, stderr)
+	}
+	data, err := os.ReadFile(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := string(data), `[{"key":"berry","tags":{"data":"Ymx1ZQ=="}}]`; got != want {
+		t.Fatalf("output = %s, want %s", got, want)
+	}
+}
+
+func TestRunUsageAndOutputFailureStatuses(t *testing.T) {
+	code, stderr := captureStderr(t, func() int { return run([]string{"in"}) })
+	if code != 2 || !strings.HasPrefix(stderr, "usage: batchview INPUT OUTPUT [PREFIX]\n") {
+		t.Fatalf("usage run = %d, stderr %q", code, stderr)
+	}
+	dir := t.TempDir()
+	input := filepath.Join(dir, "in")
+	if err := os.WriteFile(input, []byte("a=one\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	code, stderr = captureStderr(t, func() int { return run([]string{input, dir}) })
+	if code != 1 || stderr == "" {
+		t.Fatalf("output failure run = %d, stderr %q", code, stderr)
+	}
+}
diff --git a/load.go b/load.go
index db3b41527426d3280fd4a1c4aa51d6b830378940..ae9547c5f42bea76502238b70e4a28fb9881abb4 100644
--- a/load.go
+++ b/load.go
@@ -11,21 +11,51 @@ type Item struct {
 	Tags map[string][]byte `json:"tags"`
 }
 
+// Load reads key=payload lines, ignoring blank lines and lines beginning with #.
+// It returns items parsed before malformed input or a reader error. When a
+// reader returns bytes and an error together, complete items in those bytes are
+// returned with that error. The reader remains borrowed, and payload bytes in
+// returned items are caller-owned. EOF indicates successful completion.
 func Load(r io.Reader) ([]Item, error) {
-	data, err := io.ReadAll(r)
-	if err != nil {
-		return nil, err
-	}
+	data, readErr := io.ReadAll(r)
 	var out []Item
 	for _, line := range strings.Split(string(data), "\n") {
-		if line == "" {
+		if line == "" || strings.HasPrefix(line, "#") {
 			continue
 		}
 		key, value, ok := strings.Cut(line, "=")
 		if !ok {
-			return out, errors.New("malformed item")
+			return out, errors.Join(errors.New("malformed item"), readErr)
 		}
 		out = append(out, Item{Key: key, Tags: map[string][]byte{"data": []byte(value)}})
 	}
-	return out, nil
+	return out, readErr
+}
+
+// Select returns items whose keys begin with prefix, preserving their order.
+// The result and each item's tag map and byte slices are independent snapshots.
+// A nil input produces nil; a non-nil input produces a non-nil result.
+func Select(items []Item, prefix string) []Item {
+	if items == nil {
+		return nil
+	}
+	out := make([]Item, 0, len(items))
+	for _, item := range items {
+		if !strings.HasPrefix(item.Key, prefix) {
+			continue
+		}
+		clone := Item{Key: item.Key}
+		if item.Tags != nil {
+			clone.Tags = make(map[string][]byte, len(item.Tags))
+			for key, value := range item.Tags {
+				if value == nil {
+					clone.Tags[key] = nil
+					continue
+				}
+				clone.Tags[key] = append([]byte{}, value...)
+			}
+		}
+		out = append(out, clone)
+	}
+	return out
 }
diff --git a/load_test.go b/load_test.go
index 31fb79f811112aa233cdc1cd7d0e19134a974883..d8035e919b0b0d947ae211cf2167408b96cf93df 100644
--- a/load_test.go
+++ b/load_test.go
@@ -1,6 +1,7 @@
 package batchview
 
 import (
+	"errors"
 	"strings"
 	"testing"
 )
@@ -11,3 +12,90 @@ func TestLoad(t *testing.T) {
 		t.Fatalf("%v %v", got, e)
 	}
 }
+
+type bytesAndError struct {
+	data []byte
+	err  error
+}
+
+func (r bytesAndError) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, r.err
+	}
+	n := copy(p, r.data)
+	return n, r.err
+}
+
+func TestLoadCommentsAndMalformedPrefix(t *testing.T) {
+	got, err := Load(strings.NewReader("# comment\na=one\n\ninvalid\nb=two\n"))
+	if err == nil || err.Error() != "malformed item" {
+		t.Fatalf("error = %v, want malformed item", err)
+	}
+	if len(got) != 1 || got[0].Key != "a" || string(got[0].Tags["data"]) != "one" {
+		t.Fatalf("items = %#v, want only a=one", got)
+	}
+}
+
+func TestLoadReturnsItemsAndCauseWhenReadReturnsBoth(t *testing.T) {
+	readErr := errors.New("source failed")
+	got, err := Load(bytesAndError{data: []byte("# c\na=one\n"), err: readErr})
+	if !errors.Is(err, readErr) {
+		t.Fatalf("error = %v, want wrapped read cause", err)
+	}
+	if len(got) != 1 || got[0].Key != "a" {
+		t.Fatalf("items = %#v, want parsed prefix", got)
+	}
+}
+
+func TestLoadMalformedAndReadErrorRemainInspectable(t *testing.T) {
+	readErr := errors.New("source failed")
+	got, err := Load(bytesAndError{data: []byte("a=one\ninvalid\n"), err: readErr})
+	if !errors.Is(err, readErr) || err.Error() != "malformed item\nsource failed" {
+		t.Fatalf("error = %v, want malformed item and read cause", err)
+	}
+	if len(got) != 1 || got[0].Key != "a" {
+		t.Fatalf("items = %#v, want parsed prefix", got)
+	}
+}
+
+func TestLoadEOFIsSuccess(t *testing.T) {
+	got, err := Load(strings.NewReader("# comment\na=one"))
+	if err != nil || len(got) != 1 || got[0].Key != "a" {
+		t.Fatalf("Load = %#v, %v", got, err)
+	}
+}
+
+func TestSelectReturnsDeepOrderedSnapshot(t *testing.T) {
+	input := []Item{
+		{Key: "ab", Tags: map[string][]byte{"data": []byte("one"), "nil": nil, "empty": {}}},
+		{Key: "ba", Tags: map[string][]byte{"data": []byte("skip")}},
+		{Key: "ac", Tags: map[string][]byte{"data": []byte("two")}},
+	}
+	got := Select(input, "a")
+	if len(got) != 2 || got[0].Key != "ab" || got[1].Key != "ac" {
+		t.Fatalf("Select = %#v", got)
+	}
+	got[0].Key = "changed"
+	got[0].Tags["data"][0] = 'X'
+	got[0].Tags["added"] = []byte("new")
+	input[2].Tags["data"][0] = 'Y'
+	if input[0].Key != "ab" || string(input[0].Tags["data"]) != "one" || len(input[0].Tags) != 3 {
+		t.Fatalf("output mutation reached input: %#v", input[0])
+	}
+	if string(got[1].Tags["data"]) != "two" || input[2].Tags["data"][0] != 'Y' {
+		t.Fatalf("input mutation reached output: %#v", got[1])
+	}
+	if got[0].Tags["nil"] != nil || got[0].Tags["empty"] == nil {
+		t.Fatalf("nil/empty tag distinction changed: %#v", got[0].Tags)
+	}
+}
+
+func TestSelectNilAndEmptyResults(t *testing.T) {
+	if got := Select(nil, "x"); got != nil {
+		t.Fatalf("Select(nil) = %#v, want nil", got)
+	}
+	got := Select([]Item{{Key: "a"}}, "z")
+	if got == nil || len(got) != 0 {
+		t.Fatalf("Select with no matches = %#v, want non-nil empty slice", got)
+	}
+}
