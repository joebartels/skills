@@ -1,6 +1,10 @@
 package accountlookup
 
-import "testing"
+import (
+	"errors"
+	"strings"
+	"testing"
+)
 
 type missingBackend struct{}
 
@@ -11,3 +15,39 @@ func TestMissing(t *testing.T) {
 		t.Fatal(err)
 	}
 }
+
+type recordingBackend struct {
+	called bool
+	err    error
+}
+
+func (b *recordingBackend) Find(string) (string, error) {
+	b.called = true
+	return "", b.err
+}
+
+func TestBlankKeyRejectedBeforeBackend(t *testing.T) {
+	backend := &recordingBackend{}
+	_, err := (Service{Backend: backend}).Lookup(" \t\n")
+	if err != ErrInvalidKey {
+		t.Fatalf("Lookup error = %v, want ErrInvalidKey", err)
+	}
+	if backend.called {
+		t.Fatal("backend called for blank key")
+	}
+}
+
+func TestUnavailableIncludesSafeLookupContext(t *testing.T) {
+	backend := &recordingBackend{err: errors.New("password=secret; SELECT * FROM users")}
+	_, err := (Service{Backend: backend}).Lookup("user-17")
+	if !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("Lookup error = %v, want ErrUnavailable", err)
+	}
+	message := err.Error()
+	if !strings.Contains(message, "lookup account \"user-17\"") {
+		t.Fatalf("Lookup error %q lacks operation/key context", message)
+	}
+	if strings.Contains(message, "secret") || strings.Contains(message, "SELECT") {
+		t.Fatalf("Lookup error exposed backend diagnostic: %q", message)
+	}
+}
