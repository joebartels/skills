@@ -2,18 +2,52 @@ package lineexport
 
 import (
 	"bufio"
+	"errors"
+	"fmt"
 	"io"
 )
 
+// Export copies all records from r to w and closes w exactly once. The reader
+// remains owned by the caller. The count includes only fully written records.
 func Export(r io.Reader, w io.WriteCloser) (int, error) {
-	defer w.Close()
+	return ExportLimit(r, w, 0)
+}
+
+// ExportLimit copies at most limit records from r to w. Zero means unlimited;
+// a negative limit fails before reading or writing. Empty records and a final
+// unterminated record count. Each accepted record is written with a newline.
+//
+// ExportLimit closes w exactly once on every path, including invalid limits.
+// A lone read, write, or close error is returned unchanged. If copying and
+// closing both fail, the returned error exposes both causes through errors.Is
+// and errors.As. The accepted prefix may remain in w after a failure.
+func ExportLimit(r io.Reader, w io.WriteCloser, limit int) (n int, err error) {
+	defer func() {
+		closeErr := w.Close()
+		if err == nil {
+			err = closeErr
+		} else if closeErr != nil {
+			err = errors.Join(err, closeErr)
+		}
+	}()
+	if limit < 0 {
+		return 0, fmt.Errorf("lineexport: limit must be nonnegative (got %d)", limit)
+	}
+
 	scanner := bufio.NewScanner(r)
-	n := 0
-	for scanner.Scan() {
-		if _, err := io.WriteString(w, scanner.Text()+"\n"); err != nil {
-			return n, err
+	for limit == 0 || n < limit {
+		if !scanner.Scan() {
+			return n, scanner.Err()
+		}
+		record := scanner.Text() + "\n"
+		written, writeErr := io.WriteString(w, record)
+		if writeErr != nil {
+			return n, writeErr
+		}
+		if written != len(record) {
+			return n, io.ErrShortWrite
 		}
 		n++
 	}
-	return n, scanner.Err()
+	return n, nil
 }
