index 0000000000000000000000000000000000000000..2ae88fcadfe43b47e068a1efa65fa3d25c4ae721
--- /dev/null
+++ b/contracts_test.go
@@ -0,0 +1,203 @@
+package lineexport_test
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"strings"
+	"testing"
+
+	"example.com/lineexport"
+)
+
+// Exercise the existing exported function type from an external package.
+var exportFunc func(io.Reader, io.WriteCloser) (int, error) = lineexport.Export
+
+type writer struct {
+	bytes.Buffer
+	writeErr error
+	closeErr error
+	closes   int
+	writes   int
+	failAt   int
+	short    bool
+}
+
+func (w *writer) Write(p []byte) (int, error) {
+	w.writes++
+	if w.failAt == w.writes {
+		if w.short {
+			return w.Buffer.Write(p[:len(p)-1])
+		}
+		return 0, w.writeErr
+	}
+	return w.Buffer.Write(p)
+}
+
+// Avoid inheriting bytes.Buffer.WriteString and bypassing Write's failure seam.
+func (w *writer) WriteString(s string) (int, error) { return w.Write([]byte(s)) }
+func (w *writer) Close() error {
+	w.closes++
+	return w.closeErr
+}
+
+type reader struct {
+	lines  []string
+	err    error
+	reads  int
+	closes int
+	w      *writer
+}
+
+func (r *reader) Read(p []byte) (int, error) {
+	if r.w != nil && r.reads != r.w.writes {
+		return 0, errors.New("read next record before writing previous record")
+	}
+	r.reads++
+	if len(r.lines) == 0 {
+		if r.err != nil {
+			return 0, r.err
+		}
+		return 0, io.EOF
+	}
+	line := r.lines[0]
+	n := copy(p, line)
+	if n < len(line) {
+		r.lines[0] = line[n:]
+	} else {
+		r.lines = r.lines[1:]
+	}
+	return n, nil
+}
+
+func (r *reader) Close() error { r.closes++; return nil }
+
+type writeFailure struct{}
+
+func (*writeFailure) Error() string { return "write failed" }
+
+type closeFailure struct{}
+
+func (*closeFailure) Error() string { return "close failed" }
+
+func TestExportLimitRecords(t *testing.T) {
+	tests := []struct {
+		name, input, want string
+		limit, count      int
+	}{
+		{"empty", "", "", 0, 0},
+		{"unlimited", "a\nb\nc", "a\nb\nc\n", 0, 3},
+		{"prefix", "a\nb\nc", "a\n", 1, 1},
+		{"exact", "a\nb", "a\nb\n", 2, 2},
+		{"larger", "a\nb", "a\nb\n", 5, 2},
+		{"empty records", "\na\n\n", "\na\n\n", 0, 3},
+		{"empty prefix", "\na\n", "\n", 1, 1},
+		{"CRLF compatibility", "a\r\nb\r\n", "a\nb\n", 0, 2},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			w := new(writer)
+			n, err := lineexport.ExportLimit(strings.NewReader(tt.input), w, tt.limit)
+			if n != tt.count || err != nil || w.String() != tt.want || w.closes != 1 {
+				t.Fatalf("got count=%d err=%v output=%q closes=%d", n, err, w.String(), w.closes)
+			}
+		})
+	}
+
+	w := new(writer)
+	n, err := exportFunc(strings.NewReader("a\nb"), w)
+	if n != 2 || err != nil || w.String() != "a\nb\n" || w.closes != 1 {
+		t.Fatalf("Export compatibility: count=%d err=%v output=%q closes=%d", n, err, w.String(), w.closes)
+	}
+}
+
+func TestExportLimitOrderingAndBoundary(t *testing.T) {
+	w := new(writer)
+	r := &reader{lines: []string{"a\n", "b\n"}, w: w}
+	n, err := lineexport.ExportLimit(r, w, 2)
+	if n != 2 || err != nil || r.reads != 2 || r.closes != 0 || w.closes != 1 {
+		t.Fatalf("count=%d err=%v reads=%d reader closes=%d writer closes=%d", n, err, r.reads, r.closes, w.closes)
+	}
+
+	w = new(writer)
+	r = &reader{lines: []string{"a\n"}, err: errors.New("must not read past limit")}
+	n, err = lineexport.ExportLimit(r, w, 1)
+	if n != 1 || err != nil || r.reads != 1 || w.closes != 1 {
+		t.Fatalf("limit boundary: count=%d err=%v reads=%d closes=%d", n, err, r.reads, w.closes)
+	}
+}
+
+func TestExportSingleErrorIdentity(t *testing.T) {
+	readErr := errors.New("read failed")
+	writeErr := &writeFailure{}
+	closeErr := &closeFailure{}
+	tests := []struct {
+		name string
+		r    io.Reader
+		w    *writer
+		want error
+		n    int
+	}{
+		{"read", &reader{lines: []string{"a\n"}, err: readErr}, new(writer), readErr, 1},
+		{"write", strings.NewReader("a\nb\n"), &writer{writeErr: writeErr, failAt: 2}, writeErr, 1},
+		{"close", strings.NewReader("a\n"), &writer{closeErr: closeErr}, closeErr, 1},
+		{"close empty", strings.NewReader(""), &writer{closeErr: closeErr}, closeErr, 0},
+		{"short write", strings.NewReader("a\n"), &writer{short: true, failAt: 1}, io.ErrShortWrite, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			n, err := lineexport.Export(tt.r, tt.w)
+			if n != tt.n || err != tt.want || tt.w.closes != 1 {
+				t.Fatalf("count=%d err=%v want identity=%v closes=%d", n, err, tt.want, tt.w.closes)
+			}
+		})
+	}
+}
+
+func TestExportIndependentCauses(t *testing.T) {
+	readErr := errors.New("read failed")
+	writeErr := &writeFailure{}
+	closeErr := &closeFailure{}
+	tests := []struct {
+		name string
+		r    io.Reader
+		w    *writer
+		want error
+	}{
+		{"read and close", &reader{lines: []string{"a\n"}, err: readErr}, &writer{closeErr: closeErr}, readErr},
+		{"write and close", strings.NewReader("a\nb\n"), &writer{writeErr: writeErr, failAt: 2, closeErr: closeErr}, writeErr},
+		{"short and close", strings.NewReader("a\nb\n"), &writer{short: true, failAt: 2, closeErr: closeErr}, io.ErrShortWrite},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			n, err := lineexport.Export(tt.r, tt.w)
+			if n != 1 || !errors.Is(err, tt.want) || !errors.Is(err, closeErr) || tt.w.closes != 1 {
+				t.Fatalf("count=%d err=%v closes=%d", n, err, tt.w.closes)
+			}
+			var gotClose *closeFailure
+			if !errors.As(err, &gotClose) || gotClose != closeErr {
+				t.Fatalf("close type lost: %v", err)
+			}
+			if tt.want == writeErr {
+				var gotWrite *writeFailure
+				if !errors.As(err, &gotWrite) || gotWrite != writeErr {
+					t.Fatalf("write type lost: %v", err)
+				}
+			}
+		})
+	}
+}
+
+func TestExportNegativeLimit(t *testing.T) {
+	for _, closeErr := range []error{nil, &closeFailure{}} {
+		w := &writer{closeErr: closeErr}
+		r := &reader{lines: []string{"a\n"}}
+		n, err := lineexport.ExportLimit(r, w, -1)
+		if n != 0 || err == nil || r.reads != 0 || r.closes != 0 || w.writes != 0 || w.closes != 1 {
+			t.Fatalf("count=%d err=%v reads=%d writes=%d closes=%d", n, err, r.reads, w.writes, w.closes)
+		}
+		if closeErr != nil && (!errors.Is(err, closeErr) || err == closeErr) {
+			t.Fatalf("invalid limit and close should both be visible: %v", err)
+		}
+	}
+}
