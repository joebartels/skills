@@ -0,0 +1,133 @@
+package main_test
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+var binary string
+
+func TestMain(m *testing.M) {
+	dir, err := os.MkdirTemp("", "lineexport-cli-test-")
+	if err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+	binary = filepath.Join(dir, "lineexport")
+	cmd := exec.Command("go", "build", "-o", binary, ".")
+	if output, err := cmd.CombinedOutput(); err != nil {
+		fmt.Fprintf(os.Stderr, "build CLI: %v\n%s", err, output)
+		os.RemoveAll(dir)
+		os.Exit(1)
+	}
+	code := m.Run()
+	os.RemoveAll(dir)
+	os.Exit(code)
+}
+
+func invoke(t *testing.T, dir string, wantCode int, args ...string) string {
+	t.Helper()
+	cmd := exec.Command(binary, args...)
+	cmd.Dir = dir
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &stdout, &stderr
+	err := cmd.Run()
+	code := 0
+	if err != nil {
+		var exitErr *exec.ExitError
+		if !errors.As(err, &exitErr) {
+			t.Fatalf("run CLI: %v", err)
+		}
+		code = exitErr.ExitCode()
+	}
+	if code != wantCode || stdout.Len() != 0 {
+		t.Fatalf("exit=%d want=%d stdout=%q stderr=%q", code, wantCode, stdout.String(), stderr.String())
+	}
+	if wantCode == 0 && stderr.Len() != 0 || wantCode != 0 && stderr.Len() == 0 {
+		t.Fatalf("unexpected stderr for exit %d: %q", code, stderr.String())
+	}
+	return stderr.String()
+}
+
+func putFile(t *testing.T, dir, name, content string) {
+	t.Helper()
+	if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func wantFile(t *testing.T, dir, name, want string) {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(dir, name))
+	if err != nil || string(data) != want {
+		t.Fatalf("file=%q content=%q want=%q err=%v", name, data, want, err)
+	}
+}
+
+func TestCLIExport(t *testing.T) {
+	for _, tt := range []struct {
+		name, limit, want string
+	}{
+		{"existing invocation", "", "a\n\nb\n"},
+		{"zero unlimited", "0", "a\n\nb\n"},
+		{"one", "1", "a\n"},
+		{"empty record counts", "2", "a\n\n"},
+		{"past EOF", "9", "a\n\nb\n"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			dir := t.TempDir()
+			putFile(t, dir, "-input", "a\n\nb")
+			args := []string{"-input", "-output"}
+			if tt.limit != "" {
+				args = append(args, tt.limit)
+			}
+			invoke(t, dir, 0, args...)
+			wantFile(t, dir, "-output", tt.want)
+		})
+	}
+}
+
+func TestCLIUsage(t *testing.T) {
+	for _, args := range [][]string{
+		nil,
+		{"input"},
+		{"input", "output", "1", "extra"},
+		{"input", "output", "-1"},
+		{"input", "output", "abc"},
+		{"input", "output", ""},
+		{"input", "output", "999999999999999999999999999999"},
+	} {
+		t.Run(strings.Join(args, "/"), func(t *testing.T) {
+			dir := t.TempDir()
+			putFile(t, dir, "input", "a\n")
+			putFile(t, dir, "output", "keep me")
+			stderr := invoke(t, dir, 2, args...)
+			if !strings.Contains(stderr, "usage: lineexport INPUT OUTPUT [LIMIT]") {
+				t.Fatalf("missing usage: %q", stderr)
+			}
+			wantFile(t, dir, "output", "keep me")
+		})
+	}
+}
+
+func TestCLIFailures(t *testing.T) {
+	dir := t.TempDir()
+	invoke(t, dir, 1, "missing", "output")
+	if _, err := os.Stat(filepath.Join(dir, "output")); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("input open failure created output: %v", err)
+	}
+	putFile(t, dir, "input", "a\n")
+	invoke(t, dir, 1, "input", "missing-dir/output")
+
+	// Preserve the existing Scanner size limit and verify an accepted prefix
+	// remains observable when a subsequent record fails.
+	putFile(t, dir, "input", "accepted\n"+strings.Repeat("x", 100000)+"\n")
+	invoke(t, dir, 1, "input", "output")
+	wantFile(t, dir, "output", "accepted\n")
+}
diff --git a/contracts_test.go b/contracts_test.go
