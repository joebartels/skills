diff --git a/export.go b/export.go
index 253cfc8701067540a8944bda6287062f8fa7af63..d08c1b75d8a3117138691e0784017f6901680267 100644
--- a/export.go
+++ b/export.go
@@ -2,18 +2,47 @@ package lineexport
 
 import (
 	"bufio"
+	"errors"
 	"io"
 )
 
+// Export copies every newline-separated record from r to w and closes w.
+// It returns the number of records successfully written.
 func Export(r io.Reader, w io.WriteCloser) (int, error) {
-	defer w.Close()
+	return ExportLimit(r, w, 0)
+}
+
+// ExportLimit copies up to limit newline-separated records from r to w and
+// closes w. A limit of zero means unlimited; a negative limit is rejected
+// before reading or writing. The writer is closed exactly once on every path.
+// If both copying and closing fail, the returned error matches both causes.
+func ExportLimit(r io.Reader, w io.WriteCloser, limit int) (n int, err error) {
+	defer func() {
+		closeErr := w.Close()
+		if err == nil {
+			err = closeErr
+		} else if closeErr != nil {
+			err = errors.Join(err, closeErr)
+		}
+	}()
+
+	if limit < 0 {
+		return 0, errors.New("lineexport: limit must not be negative")
+	}
+
 	scanner := bufio.NewScanner(r)
-	n := 0
 	for scanner.Scan() {
-		if _, err := io.WriteString(w, scanner.Text()+"\n"); err != nil {
-			return n, err
+		written, writeErr := io.WriteString(w, scanner.Text()+"\n")
+		if writeErr != nil {
+			return n, writeErr
+		}
+		if written != len(scanner.Text())+1 {
+			return n, io.ErrShortWrite
 		}
 		n++
+		if limit > 0 && n == limit {
+			return n, nil
+		}
 	}
 	return n, scanner.Err()
 }
diff --git a/export_test.go b/export_test.go
index 8093d63a48d447cf657a3bb38b0d189666141ae6..64dd6c8f2cd2fe7f2e9c8437580c1a8fb235839f 100644
--- a/export_test.go
+++ b/export_test.go
@@ -2,17 +2,89 @@ package lineexport
 
 import (
 	"bytes"
+	"errors"
+	"io"
 	"strings"
 	"testing"
 )
 
-type bufferCloser struct{ bytes.Buffer }
+type testWriter struct {
+	buffer   bytes.Buffer
+	closeErr error
+	writeErr error
+	closes   int
+}
+
+func (w *testWriter) Write(p []byte) (int, error) {
+	if w.writeErr != nil {
+		return 0, w.writeErr
+	}
+	return w.buffer.Write(p)
+}
+
+func (w *testWriter) Close() error {
+	w.closes++
+	return w.closeErr
+}
 
-func (*bufferCloser) Close() error { return nil }
 func TestExport(t *testing.T) {
-	w := new(bufferCloser)
+	w := new(testWriter)
 	n, err := Export(strings.NewReader("a\nb\n"), w)
-	if n != 2 || err != nil || w.String() != "a\nb\n" {
-		t.Fatalf("%d %v %q", n, err, w.String())
+	if n != 2 || err != nil || w.buffer.String() != "a\nb\n" || w.closes != 1 {
+		t.Fatalf("Export = (%d, %v), output %q, closes %d", n, err, w.buffer.String(), w.closes)
 	}
 }
+
+func TestExportReturnsCloseError(t *testing.T) {
+	closeErr := errors.New("close failed")
+	w := &testWriter{closeErr: closeErr}
+	n, err := Export(strings.NewReader("a\n"), w)
+	if n != 1 || err != closeErr || w.closes != 1 {
+		t.Fatalf("Export = (%d, %v), closes %d", n, err, w.closes)
+	}
+}
+
+func TestExportLimitStopsAfterLimit(t *testing.T) {
+	w := new(testWriter)
+	n, err := ExportLimit(strings.NewReader("a\nb\nc\n"), w, 2)
+	if n != 2 || err != nil || w.buffer.String() != "a\nb\n" || w.closes != 1 {
+		t.Fatalf("ExportLimit = (%d, %v), output %q, closes %d", n, err, w.buffer.String(), w.closes)
+	}
+}
+
+func TestExportLimitCountsEmptyAndUnterminatedRecords(t *testing.T) {
+	w := new(testWriter)
+	n, err := ExportLimit(strings.NewReader("\nlast"), w, 0)
+	if n != 2 || err != nil || w.buffer.String() != "\nlast\n" || w.closes != 1 {
+		t.Fatalf("ExportLimit = (%d, %v), output %q, closes %d", n, err, w.buffer.String(), w.closes)
+	}
+}
+
+func TestExportLimitRejectsNegativeAndCloses(t *testing.T) {
+	w := new(testWriter)
+	n, err := ExportLimit(strings.NewReader("untouched"), w, -1)
+	if n != 0 || err == nil || w.buffer.Len() != 0 || w.closes != 1 {
+		t.Fatalf("ExportLimit = (%d, %v), output %q, closes %d", n, err, w.buffer.String(), w.closes)
+	}
+}
+
+func TestExportLimitPreservesBothWriteAndCloseErrors(t *testing.T) {
+	writeErr := errors.New("write failed")
+	closeErr := errors.New("close failed")
+	w := &testWriter{writeErr: writeErr, closeErr: closeErr}
+	n, err := ExportLimit(strings.NewReader("a"), w, 0)
+	if n != 0 || !errors.Is(err, writeErr) || !errors.Is(err, closeErr) || w.closes != 1 {
+		t.Fatalf("ExportLimit = (%d, %v), closes %d", n, err, w.closes)
+	}
+}
+
+func TestExportLimitReturnsSingleWriteErrorDirectly(t *testing.T) {
+	writeErr := errors.New("write failed")
+	w := &testWriter{writeErr: writeErr}
+	n, err := ExportLimit(strings.NewReader("a"), w, 0)
+	if n != 0 || err != writeErr || w.closes != 1 {
+		t.Fatalf("ExportLimit = (%d, %v), closes %d", n, err, w.closes)
+	}
+}
+
+var _ io.WriteCloser = (*testWriter)(nil)
