 func Collect(rows Rows) ([]string, error) {
+	return CollectMatching(rows, nil)
+}
+
+// CollectMatching scans rows, returning values accepted by keep in cursor order.
+// A nil keep function accepts every value. CollectMatching closes rows once;
+// a scan or iteration error returns the successfully collected prefix.
+func CollectMatching(rows Rows, keep func(string) bool) ([]string, error) {
 	defer rows.Close()
 	var out []string
 	for rows.Next() {
@@ -15,7 +22,9 @@ func Collect(rows Rows) ([]string, error) {
 		if err := rows.Scan(&s); err != nil {
 			return out, err
 		}
-		out = append(out, s)
+		if keep == nil || keep(s) {
+			out = append(out, s)
+		}
 	}
-	return out, nil
+	return out, rows.Err()
 }
diff --git a/collect_test.go b/collect_test.go
index ba16dc5ed0dbb5d2d53deb68b4431686aa6559fe..973801fbe904f2bbc957f2bef4a80292210538c7 100644
--- a/collect_test.go
+++ b/collect_test.go
@@ -1,6 +1,11 @@
 package cursorload
 
-import "testing"
+import (
+	"errors"
+	"testing"
+)
+
+var _ func(Rows, func(string) bool) ([]string, error) = CollectMatching
 
 type oneRow struct{ done bool }
 
@@ -20,3 +25,54 @@ func TestCollect(t *testing.T) {
 		t.Fatal(got, err)
 	}
 }
+
+type testRows struct {
+	values   []string
+	index    int
+	scanErr  error
+	iterErr  error
+	closeErr error
+	closes   int
+}
+
+func (r *testRows) Next() bool { return r.index < len(r.values) }
+func (r *testRows) Scan(s *string) error {
+	if r.scanErr != nil && r.index == 1 {
+		return r.scanErr
+	}
+	*s = r.values[r.index]
+	r.index++
+	return nil
+}
+func (r *testRows) Err() error { return r.iterErr }
+func (r *testRows) Close() error {
+	r.closes++
+	return r.closeErr
+}
+
+func TestCollectMatchingFiltersInOrderAndCloses(t *testing.T) {
+	rows := &testRows{values: []string{"a", "bb", "c"}}
+	got, err := CollectMatching(rows, func(s string) bool { return len(s) == 1 })
+	if err != nil || len(got) != 2 || got[0] != "a" || got[1] != "c" || rows.closes != 1 {
+		t.Fatal(got, err, rows.closes)
+	}
+}
+
+func TestCollectMatchingNilFilterAndIterationError(t *testing.T) {
+	iterationErr := errors.New("iteration failed")
+	closeErr := errors.New("close failed")
+	rows := &testRows{values: []string{"a", "b"}, iterErr: iterationErr, closeErr: closeErr}
+	got, err := CollectMatching(rows, nil)
+	if err != iterationErr || len(got) != 2 || got[0] != "a" || got[1] != "b" || rows.closes != 1 {
+		t.Fatal(got, err, rows.closes)
+	}
+}
+
+func TestCollectMatchingScanErrorReturnsPrefix(t *testing.T) {
+	scanErr := errors.New("scan failed")
+	rows := &testRows{values: []string{"a", "b", "c"}, scanErr: scanErr}
+	got, err := CollectMatching(rows, nil)
+	if err != scanErr || len(got) != 1 || got[0] != "a" || rows.closes != 1 {
+		t.Fatal(got, err, rows.closes)
+	}
+}
