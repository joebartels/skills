 	"testing"
 )
@@ -11,3 +12,55 @@ func TestLoad(t *testing.T) {
 		t.Fatalf("%v %v", got, err)
 	}
 }
+
+func TestLoadCommentsAndLineError(t *testing.T) {
+	got, err := Load(strings.NewReader("# header\n\na=1\ninvalid\nb=2\n"))
+	var lineErr *LineError
+	if !errors.As(err, &lineErr) {
+		t.Fatalf("error = %v, want *LineError", err)
+	}
+	if lineErr.Line != 4 || lineErr.Text != "invalid" {
+		t.Fatalf("LineError = %+v", lineErr)
+	}
+	if len(got) != 1 || got[0] != (Record{Key: "a", Value: "1"}) {
+		t.Fatalf("records = %#v, want valid prefix", got)
+	}
+}
+
+type dataAndErrorReader struct {
+	data []byte
+	err  error
+}
+
+func (r *dataAndErrorReader) Read(p []byte) (int, error) {
+	if len(r.data) == 0 {
+		return 0, r.err
+	}
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	if len(r.data) == 0 {
+		return n, r.err
+	}
+	return n, nil
+}
+
+func TestLoadPreservesReaderErrorAndPartialResult(t *testing.T) {
+	wantErr := errors.New("source failed")
+	got, err := Load(&dataAndErrorReader{data: []byte("a=1\nb=2"), err: wantErr})
+	if !errors.Is(err, wantErr) {
+		t.Fatalf("error = %v, want wrapped reader error", err)
+	}
+	if len(got) != 2 || got[1] != (Record{Key: "b", Value: "2"}) {
+		t.Fatalf("records = %#v, want both records returned with read error", got)
+	}
+}
+
+func TestLoadEmptyAndEmptyFields(t *testing.T) {
+	got, err := Load(strings.NewReader("=\nkey=\n"))
+	if err != nil {
+		t.Fatalf("Load error = %v", err)
+	}
+	if got == nil || len(got) != 2 || got[0] != (Record{}) || got[1] != (Record{Key: "key"}) {
+		t.Fatalf("records = %#v", got)
+	}
+}
