@@ -1,28 +1,60 @@
 package recordload
 
 import (
+	"bufio"
+	"errors"
 	"fmt"
 	"io"
 	"strings"
 )
 
+// Record is one key/value pair read by Load.
 type Record struct{ Key, Value string }
 
+// LineError reports a malformed record on a one-based physical input line.
+type LineError struct {
+	Line int
+	Text string
+}
+
+func (e *LineError) Error() string {
+	return fmt.Sprintf("line %d: malformed record %q", e.Line, e.Text)
+}
+
+// Load reads key=value records in order. Blank lines and lines beginning with
+// # are ignored. On malformed input or a reader error, Load returns records
+// parsed before the error. Reader errors remain available through errors.Is
+// and errors.As.
 func Load(r io.Reader) ([]Record, error) {
-	data, err := io.ReadAll(r)
-	if err != nil {
-		return nil, err
-	}
+	reader := bufio.NewReader(r)
 	var records []Record
-	for n, text := range strings.Split(string(data), "\n") {
-		if text == "" {
-			continue
+	lineNumber := 0
+	for {
+		line, readErr := reader.ReadString('\n')
+		if len(line) > 0 {
+			lineNumber++
+			line = strings.TrimSuffix(line, "\n")
+			if err := parseLine(&records, lineNumber, line); err != nil {
+				return records, err
+			}
 		}
-		key, value, ok := strings.Cut(text, "=")
-		if !ok {
-			return records, fmt.Errorf("line %d: malformed record", n+1)
+		if readErr != nil {
+			if errors.Is(readErr, io.EOF) {
+				return records, nil
+			}
+			return records, fmt.Errorf("read records: %w", readErr)
 		}
-		records = append(records, Record{Key: key, Value: value})
 	}
-	return records, nil
+}
+
+func parseLine(records *[]Record, lineNumber int, text string) error {
+	if text == "" || strings.HasPrefix(text, "#") {
+		return nil
+	}
+	key, value, ok := strings.Cut(text, "=")
+	if !ok {
+		return &LineError{Line: lineNumber, Text: text}
+	}
+	*records = append(*records, Record{Key: key, Value: value})
+	return nil
 }
