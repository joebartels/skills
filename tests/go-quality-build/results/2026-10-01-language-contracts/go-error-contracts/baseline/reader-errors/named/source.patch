--- /dev/null
+++ b/api_contract_test.go
@@ -0,0 +1,23 @@
+package recordload_test
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"example.com/recordload"
+)
+
+func TestExportedLineErrorContract(t *testing.T) {
+	got, err := recordload.Load(strings.NewReader("first=1\nbroken\n"))
+	var lineErr *recordload.LineError
+	if !errors.As(err, &lineErr) {
+		t.Fatalf("error = %v, want *recordload.LineError", err)
+	}
+	if lineErr.Line != 2 || lineErr.Text != "broken" {
+		t.Fatalf("LineError = %+v", lineErr)
+	}
+	if len(got) != 1 || got[0] != (recordload.Record{Key: "first", Value: "1"}) {
+		t.Fatalf("records = %#v", got)
+	}
+}
