@@ -1,28 +1,48 @@
 package recordload
 
 import (
+	"errors"
 	"fmt"
 	"io"
 	"strings"
 )
 
+// Record is a key and value parsed from a single input line.
 type Record struct{ Key, Value string }
 
+// LineError describes a nonempty, noncomment line without an equals sign.
+type LineError struct {
+	Line int    // One-based physical line number, including blank and comment lines.
+	Text string // Original line text, excluding its newline separator.
+}
+
+func (e *LineError) Error() string {
+	return fmt.Sprintf("line %d: malformed record", e.Line)
+}
+
+// Load reads newline-separated key=value records in order. It ignores empty
+// lines and lines beginning with #. Keys and values are not trimmed.
+// On failure, Load returns the valid prefix and an error. Malformed lines are
+// inspectable as *LineError with errors.As; reader errors remain inspectable
+// with errors.Is and errors.As, including when both failures occur.
+// Load processes bytes returned with a read error, treats EOF as success, and
+// does not close r. It reads all input into memory without a fixed line limit.
 func Load(r io.Reader) ([]Record, error) {
-	data, err := io.ReadAll(r)
-	if err != nil {
-		return nil, err
-	}
+	data, readErr := io.ReadAll(r)
 	var records []Record
 	for n, text := range strings.Split(string(data), "\n") {
-		if text == "" {
+		if text == "" || strings.HasPrefix(text, "#") {
 			continue
 		}
 		key, value, ok := strings.Cut(text, "=")
 		if !ok {
-			return records, fmt.Errorf("line %d: malformed record", n+1)
+			lineErr := &LineError{Line: n + 1, Text: text}
+			if readErr != nil {
+				return records, errors.Join(lineErr, readErr)
+			}
+			return records, lineErr
 		}
 		records = append(records, Record{Key: key, Value: value})
 	}
-	return records, nil
+	return records, readErr
 }
