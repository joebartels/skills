-		t.Fatalf("%v %v", got, err)
+// Preserve the existing function type for callers that pass Load as a value.
+var _ func(io.Reader) ([]recordload.Record, error) = recordload.Load
+var _ error = &recordload.LineError{Line: 1, Text: "invalid"}
+
+func TestLoadRecords(t *testing.T) {
+	tests := []struct {
+		name string
+		text string
+		want []recordload.Record
+	}{
+		{"empty", "", nil},
+		{"blank and comments", "\n# comment\n#ignored=value\n\n", nil},
+		{"ordered", "a=1\nb=2\n", []recordload.Record{{Key: "a", Value: "1"}, {Key: "b", Value: "2"}}},
+		{"empty keys and values", "=value\nkey=\n=\n", []recordload.Record{{Value: "value"}, {Key: "key"}, {}}},
+		{"first equals and final line", "a=b=c\n# comment\nlast=value", []recordload.Record{{Key: "a", Value: "b=c"}, {Key: "last", Value: "value"}}},
+		{"preserve whitespace", " key = value ", []recordload.Record{{Key: " key ", Value: " value "}}},
+		{"long line", "key=" + strings.Repeat("x", 128*1024), []recordload.Record{{Key: "key", Value: strings.Repeat("x", 128*1024)}}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := recordload.Load(strings.NewReader(tt.text))
+			if err != nil {
+				t.Fatalf("Load() error = %v, want nil interface", err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("Load() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestLoadMalformed(t *testing.T) {
+	tests := []struct {
+		name string
+		text string
+		line int
+		bad  string
+		want []recordload.Record
+	}{
+		{"first line", "broken\na=1", 1, "broken", nil},
+		{"physical line", "a=1\n\n# comment\nbroken\nlater=2", 4, "broken", []recordload.Record{{Key: "a", Value: "1"}}},
+		{"comments start at column one", " # comment", 1, " # comment", nil},
+		{"whitespace is not blank", " \t ", 1, " \t ", nil},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := recordload.Load(strings.NewReader(tt.text))
+			var lineErr *recordload.LineError
+			if !errors.As(err, &lineErr) {
+				t.Fatalf("Load() error = %v, want *LineError", err)
+			}
+			if lineErr.Line != tt.line || lineErr.Text != tt.bad {
+				t.Fatalf("LineError = %+v, want Line %d, Text %q", lineErr, tt.line, tt.bad)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("Load() = %v, want prefix %v", got, tt.want)
+			}
+		})
+	}
+}
+
+type readerStep struct {
+	data string
+	err  error
+}
+
+type stepReader struct {
+	steps  []readerStep
+	closed bool
+}
+
+func (r *stepReader) Read(p []byte) (int, error) {
+	if len(r.steps) == 0 {
+		return 0, io.EOF
+	}
+	step := &r.steps[0]
+	n := copy(p, step.data)
+	step.data = step.data[n:]
+	if step.data != "" {
+		return n, nil
+	}
+	err := step.err
+	r.steps = r.steps[1:]
+	return n, err
+}
+
+func (r *stepReader) Close() error {
+	r.closed = true
+	return nil
+}
+
+func TestLoadReadErrors(t *testing.T) {
+	readErr := errors.New("reader failed")
+	tests := []struct {
+		name  string
+		steps []readerStep
+		want  []recordload.Record
+		err   error
+	}{
+		{"failure without data", []readerStep{{err: readErr}}, nil, readErr},
+		{"bytes with failure", []readerStep{{data: "a=1\n# comment\nb=2", err: readErr}}, []recordload.Record{{Key: "a", Value: "1"}, {Key: "b", Value: "2"}}, readErr},
+		{"failure after data", []readerStep{{data: "a=1\n"}, {err: readErr}}, []recordload.Record{{Key: "a", Value: "1"}}, readErr},
+		{"bytes with EOF", []readerStep{{data: "a=1", err: io.EOF}}, []recordload.Record{{Key: "a", Value: "1"}}, nil},
+		{"split line", []readerStep{{data: "a="}, {data: "1\n"}, {data: "b=2", err: readErr}}, []recordload.Record{{Key: "a", Value: "1"}, {Key: "b", Value: "2"}}, readErr},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := &stepReader{steps: append([]readerStep(nil), tt.steps...)}
+			got, err := recordload.Load(r)
+			if !errors.Is(err, tt.err) {
+				t.Fatalf("Load() error = %v, want %v", err, tt.err)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Fatalf("Load() = %v, want prefix %v", got, tt.want)
+			}
+			if r.closed {
+				t.Fatal("Load closed its borrowed reader")
+			}
+		})
+	}
+}
+
+func TestLoadMalformedWithReadError(t *testing.T) {
+	readErr := errors.New("reader failed")
+	r := &stepReader{steps: []readerStep{{data: "a=1\n# comment\nbroken\nlater=2", err: readErr}}}
+	got, err := recordload.Load(r)
+	var lineErr *recordload.LineError
+	if !errors.As(err, &lineErr) || lineErr.Line != 3 || lineErr.Text != "broken" {
+		t.Fatalf("Load() error = %v, want LineError for line 3", err)
+	}
+	if !errors.Is(err, readErr) {
+		t.Fatalf("Load() error = %v, want inspectable reader error", err)
+	}
+	if !reflect.DeepEqual(got, []recordload.Record{{Key: "a", Value: "1"}}) {
+		t.Fatalf("Load() = %v, want prefix before malformed line", got)
+	}
+}
+
+type readerError struct{}
+
+func (*readerError) Error() string { return "typed reader failure" }
+
+func TestLoadPreservesReaderErrorType(t *testing.T) {
+	readErr := &readerError{}
+	for _, text := range []string{"a=1", "a=1\nbroken"} {
+		r := &stepReader{steps: []readerStep{{data: text, err: readErr}}}
+		_, err := recordload.Load(r)
+		var got *readerError
+		if !errors.As(err, &got) || got != readErr {
+			t.Fatalf("Load(%q) error = %v, want original typed reader error", text, err)
+		}
 	}
 }
