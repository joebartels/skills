-package recordload
+package recordload_test
 
 import (
+	"errors"
+	"io"
+	"reflect"
 	"strings"
 	"testing"
+
+	"example.com/recordload"
 )
 
-func TestLoad(t *testing.T) {
-	got, err := Load(strings.NewReader("a=1\nb=2\n"))
