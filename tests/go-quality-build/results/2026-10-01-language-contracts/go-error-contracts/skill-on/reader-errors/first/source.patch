--- /dev/null
+++ b/api_test.go
@@ -0,0 +1,23 @@
+package recordload_test
+
+import (
+	"errors"
+	"strings"
+	"testing"
+
+	"example.com/recordload"
+)
+
+func TestExportedLineErrorContract(t *testing.T) {
+	got, err := recordload.Load(strings.NewReader("ok=value\nmalformed\n"))
+	var lineErr *recordload.LineError
+	if !errors.As(err, &lineErr) {
+		t.Fatalf("Load() error = %v, want *recordload.LineError", err)
+	}
+	if lineErr.Line != 2 || lineErr.Text != "malformed" {
+		t.Fatalf("LineError = %#v", lineErr)
+	}
+	if len(got) != 1 || got[0] != (recordload.Record{Key: "ok", Value: "value"}) {
+		t.Fatalf("Load() prefix = %#v", got)
+	}
+}
