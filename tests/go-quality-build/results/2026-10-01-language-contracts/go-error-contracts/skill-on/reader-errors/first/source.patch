 	"io"
 	"strings"
@@ -8,21 +9,37 @@ import (
 
 type Record struct{ Key, Value string }
 
+// LineError reports a malformed record on a physical input line.
+type LineError struct {
+	Line int
+	Text string
+}
+
+func (e *LineError) Error() string {
+	return fmt.Sprintf("line %d: malformed record %q", e.Line, e.Text)
+}
+
+// Load reads key=value records in order. Blank lines and lines beginning with
+// # are ignored. It returns the valid prefix if the input contains a malformed
+// record or the reader fails. A reader error remains inspectable with
+// errors.Is/errors.As; if malformed input and a reader error occur together,
+// both errors are returned.
 func Load(r io.Reader) ([]Record, error) {
 	data, err := io.ReadAll(r)
-	if err != nil {
-		return nil, err
-	}
 	var records []Record
 	for n, text := range strings.Split(string(data), "\n") {
-		if text == "" {
+		if text == "" || strings.HasPrefix(text, "#") {
 			continue
 		}
 		key, value, ok := strings.Cut(text, "=")
 		if !ok {
-			return records, fmt.Errorf("line %d: malformed record", n+1)
+			lineErr := &LineError{Line: n + 1, Text: text}
+			if err != nil {
+				return records, errors.Join(lineErr, err)
+			}
+			return records, lineErr
 		}
 		records = append(records, Record{Key: key, Value: value})
 	}
-	return records, nil
+	return records, err
 }
diff --git a/load_test.go b/load_test.go
index e378a0b616ae2bca00ba850d450e2fef7bda2d20..e7ff4749137b00725a64b2af32767169c6adaf36 100644
--- a/load_test.go
+++ b/load_test.go
@@ -1,6 +1,8 @@
 package recordload
 
 import (
+	"errors"
+	"io"
 	"strings"
 	"testing"
 )
@@ -11,3 +13,76 @@ func TestLoad(t *testing.T) {
 		t.Fatalf("%v %v", got, err)
 	}
 }
+
+func TestLoadCommentsAndBlankLines(t *testing.T) {
+	got, err := Load(strings.NewReader("# heading\n\na=1\n# between\nb=2\n"))
+	if err != nil || len(got) != 2 || got[0] != (Record{Key: "a", Value: "1"}) || got[1] != (Record{Key: "b", Value: "2"}) {
+		t.Fatalf("Load() = %#v, %v", got, err)
+	}
+}
+
+func TestLoadMalformedLineReturnsValidPrefix(t *testing.T) {
+	got, err := Load(strings.NewReader("# heading\na=1\n\nbroken\nc=3\n"))
+	var lineErr *LineError
+	if !errors.As(err, &lineErr) {
+		t.Fatalf("Load() error = %v, want *LineError", err)
+	}
+	if lineErr.Line != 4 || lineErr.Text != "broken" {
+		t.Fatalf("LineError = %#v, want line 4 and text %q", lineErr, "broken")
+	}
+	if len(got) != 1 || got[0] != (Record{Key: "a", Value: "1"}) {
+		t.Fatalf("Load() prefix = %#v, want one valid record", got)
+	}
+}
+
+type dataAndErrorReader struct {
+	data []byte
+	err  error
+}
+
+func (r dataAndErrorReader) Read(p []byte) (int, error) {
+	return copy(p, r.data), r.err
+}
+
+func TestLoadProcessesBytesReturnedWithReadError(t *testing.T) {
+	readErr := errors.New("source failed")
+	got, err := Load(dataAndErrorReader{data: []byte("a=1\nb=2\n"), err: readErr})
+	if !errors.Is(err, readErr) {
+		t.Fatalf("Load() error = %v, want wrapped source error", err)
+	}
+	if len(got) != 2 || got[1] != (Record{Key: "b", Value: "2"}) {
+		t.Fatalf("Load() records = %#v, want both records from returned bytes", got)
+	}
+}
+
+func TestLoadPreservesMalformedAndReadErrors(t *testing.T) {
+	readErr := errors.New("source failed")
+	got, err := Load(dataAndErrorReader{data: []byte("a=1\nbroken\nc=3\n"), err: readErr})
+	var lineErr *LineError
+	if !errors.Is(err, readErr) || !errors.As(err, &lineErr) {
+		t.Fatalf("Load() error = %v, want source error and *LineError", err)
+	}
+	if lineErr.Line != 2 || len(got) != 1 {
+		t.Fatalf("Load() = %#v, %#v, want line 2 and one-record prefix", got, lineErr)
+	}
+}
+
+func TestLoadReadFailureReturnsValidPrefix(t *testing.T) {
+	readErr := errors.New("source failed")
+	got, err := Load(readerThenError{reader: strings.NewReader("a=1\n"), err: readErr})
+	if !errors.Is(err, readErr) || len(got) != 1 {
+		t.Fatalf("Load() = %#v, %v, want one record and source error", got, err)
+	}
+}
+
+type readerThenError struct {
+	reader io.Reader
+	err    error
+}
+
+func (r readerThenError) Read(p []byte) (int, error) {
+	if stringsReader, ok := r.reader.(*strings.Reader); ok && stringsReader.Len() > 0 {
+		return stringsReader.Read(p)
+	}
+	return 0, r.err
+}
