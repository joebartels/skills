+++ b/cmd/lineexport/main_test.go
@@ -0,0 +1,112 @@
+package main
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestCLIHelperProcess(t *testing.T) {
+	if os.Getenv("LINEEXPORT_HELPER") != "1" {
+		return
+	}
+	sep := 0
+	for i, arg := range os.Args {
+		if arg == "--" {
+			sep = i
+			break
+		}
+	}
+	os.Args = append([]string{"lineexport"}, os.Args[sep+1:]...)
+	main()
+	os.Exit(0)
+}
+
+func runCLI(t *testing.T, dir string, args ...string) ([]byte, []byte, error) {
+	t.Helper()
+	cmd := exec.Command(os.Args[0], "-test.run=^TestCLIHelperProcess$", "--")
+	cmd.Args = append(cmd.Args, args...)
+	cmd.Dir = dir
+	cmd.Env = append(os.Environ(), "LINEEXPORT_HELPER=1")
+	var stdout, stderr strings.Builder
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	err := cmd.Run()
+	return []byte(stdout.String()), []byte(stderr.String()), err
+}
+
+func TestCLIOptionalLimitAndStreams(t *testing.T) {
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	output := filepath.Join(dir, "output")
+	if err := os.WriteFile(input, []byte("a\nb\nc\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	stdout, stderr, err := runCLI(t, dir, input, output, "2")
+	if err != nil || len(stdout) != 0 || len(stderr) != 0 {
+		t.Fatalf("CLI output: stdout %q, stderr %q, err %v", stdout, stderr, err)
+	}
+	got, err := os.ReadFile(output)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "a\nb\n" {
+		t.Fatalf("output = %q, want %q", got, "a\nb\n")
+	}
+}
+
+func TestCLIInvalidUsageAndOperationalFailure(t *testing.T) {
+	dir := t.TempDir()
+	stdout, stderr, err := runCLI(t, dir, "only-one-argument")
+	if exitCode(err) != 2 || len(stdout) != 0 || !strings.Contains(string(stderr), "usage: lineexport INPUT OUTPUT [LIMIT]") {
+		t.Fatalf("invalid usage: stdout %q, stderr %q, err %v", stdout, stderr, err)
+	}
+
+	stdout, stderr, err = runCLI(t, dir, filepath.Join(dir, "missing"), filepath.Join(dir, "output"))
+	if exitCode(err) != 1 || len(stdout) != 0 || len(stderr) == 0 {
+		t.Fatalf("operational failure: stdout %q, stderr %q, err %v", stdout, stderr, err)
+	}
+
+	stdout, stderr, err = runCLI(t, dir, "input", "output", "many")
+	if exitCode(err) != 2 || len(stdout) != 0 || !strings.Contains(string(stderr), "usage:") {
+		t.Fatalf("invalid limit: stdout %q, stderr %q, err %v", stdout, stderr, err)
+	}
+	input := filepath.Join(dir, "negative-input")
+	if writeErr := os.WriteFile(input, []byte("record\n"), 0600); writeErr != nil {
+		t.Fatal(writeErr)
+	}
+	stdout, stderr, err = runCLI(t, dir, input, filepath.Join(dir, "negative-output"), "-1")
+	if exitCode(err) != 1 || len(stdout) != 0 || len(stderr) == 0 {
+		t.Fatalf("negative limit: stdout %q, stderr %q, err %v", stdout, stderr, err)
+	}
+}
+
+func TestCLIPathsBeginningWithDashRemainPositional(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "-input"), []byte("record\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	stdout, stderr, err := runCLI(t, dir, "-input", "-output")
+	if err != nil || len(stdout) != 0 || len(stderr) != 0 {
+		t.Fatalf("CLI output: stdout %q, stderr %q, err %v", stdout, stderr, err)
+	}
+	got, err := os.ReadFile(filepath.Join(dir, "-output"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "record\n" {
+		t.Fatalf("output = %q, want %q", got, "record\n")
+	}
+}
+
+func exitCode(err error) int {
+	if err == nil {
+		return 0
+	}
+	if exitErr, ok := err.(*exec.ExitError); ok {
+		return exitErr.ExitCode()
+	}
+	return -1
+}
