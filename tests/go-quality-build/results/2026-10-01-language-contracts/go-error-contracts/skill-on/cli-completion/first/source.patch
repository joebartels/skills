+// ErrInvalidLimit is returned when ExportLimit receives a negative limit.
+var ErrInvalidLimit = errors.New("lineexport: limit must not be negative")
+
+// Export copies every newline-separated record from r to w. It always closes
+// w exactly once and returns the number of records written.
 func Export(r io.Reader, w io.WriteCloser) (int, error) {
-	defer w.Close()
-	scanner := bufio.NewScanner(r)
-	n := 0
-	for scanner.Scan() {
-		if _, err := io.WriteString(w, scanner.Text()+"\n"); err != nil {
-			return n, err
+	return ExportLimit(r, w, 0)
+}
+
+// ExportLimit copies at most limit newline-separated records from r to w.
+// A zero limit copies all records. A negative limit is rejected before reading
+// or writing. In all cases, ExportLimit closes w exactly once.
+func ExportLimit(r io.Reader, w io.WriteCloser, limit int) (int, error) {
+	var operationErr error
+	if limit < 0 {
+		operationErr = ErrInvalidLimit
+	} else {
+		scanner := bufio.NewScanner(r)
+		n := 0
+		for scanner.Scan() {
+			if _, err := io.WriteString(w, scanner.Text()+"\n"); err != nil {
+				operationErr = err
+				break
+			}
+			n++
+			if limit > 0 && n >= limit {
+				break
+			}
+		}
+		if operationErr == nil {
+			operationErr = scanner.Err()
 		}
-		n++
+		return finish(w, n, operationErr)
+	}
+	return finish(w, 0, operationErr)
+}
+
+func finish(w io.WriteCloser, n int, operationErr error) (int, error) {
+	closeErr := w.Close()
+	if operationErr == nil {
+		return n, closeErr
+	}
+	if closeErr == nil {
+		return n, operationErr
 	}
-	return n, scanner.Err()
+	return n, errors.Join(operationErr, closeErr)
 }
