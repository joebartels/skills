@@ -1,5 +1,6 @@
 package cursorload
 
+// Rows is an owned cursor of strings. Collect and CollectMatching close it.
 type Rows interface {
 	Next() bool
 	Scan(*string) error
@@ -7,7 +8,17 @@ type Rows interface {
 	Close() error
 }
 
+// Collect returns every string scanned from rows. It returns a valid prefix
+// with any scan or iteration error. Close is best-effort.
 func Collect(rows Rows) ([]string, error) {
+	return CollectMatching(rows, nil)
+}
+
+// CollectMatching returns scanned strings for which keep returns true, in
+// cursor order. A nil keep function retains every string. It returns a valid
+// prefix with any scan or iteration error. The cursor is closed once; a close
+// error is ignored, and does not replace a scan or iteration error.
+func CollectMatching(rows Rows, keep func(string) bool) ([]string, error) {
 	defer rows.Close()
 	var out []string
 	for rows.Next() {
@@ -15,7 +26,9 @@ func Collect(rows Rows) ([]string, error) {
 		if err := rows.Scan(&s); err != nil {
 			return out, err
 		}
-		out = append(out, s)
+		if keep == nil || keep(s) {
+			out = append(out, s)
+		}
 	}
-	return out, nil
+	return out, rows.Err()
 }
