diff --git a/pages.go b/pages.go
index ca34bfffc56e9c72818486cabcc5482ecc473377..2860f4ee08f108eb33bea1119e12ba9b6ae1441d 100644
--- a/pages.go
+++ b/pages.go
@@ -1,3 +1,9 @@
 package paging
 
-func pages(items, size int) int { return items/size + 1 }
+func pages(items, size int) int {
+	pageCount := items / size
+	if items%size != 0 {
+		pageCount++
+	}
+	return pageCount
+}
diff --git a/pages_test.go b/pages_test.go
index 41fd0962a88958b99662aa78e71f8196d30090bd..c43daa9d9eff5f6ac67111fd7ec8a1aa349b272c 100644
--- a/pages_test.go
+++ b/pages_test.go
@@ -2,8 +2,24 @@ package paging
 
 import "testing"
 
-func TestPartial(t *testing.T) {
-	if pages(3, 2) != 2 {
-		t.Fatal("partial page")
+func TestPages(t *testing.T) {
+	tests := []struct {
+		name  string
+		items int
+		size  int
+		want  int
+	}{
+		{name: "zero items", items: 0, size: 2, want: 0},
+		{name: "partial page", items: 3, size: 2, want: 2},
+		{name: "exact multiple", items: 4, size: 2, want: 2},
+		{name: "one exact page", items: 2, size: 2, want: 1},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := pages(tt.items, tt.size); got != tt.want {
+				t.Fatalf("pages(%d, %d) = %d, want %d", tt.items, tt.size, got, tt.want)
+			}
+		})
 	}
 }
