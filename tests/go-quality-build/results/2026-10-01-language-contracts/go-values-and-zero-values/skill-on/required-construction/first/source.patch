+
+func TestCountConcurrentWithSign(t *testing.T) {
+	c, err := New([]byte("sixteen-byte-key!"))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	const calls = 100
+	var wg sync.WaitGroup
+	wg.Add(calls * 2)
+	for range calls {
+		go func() {
+			defer wg.Done()
+			c.Sign(nil)
+		}()
+		go func() {
+			defer wg.Done()
+			_ = c.Count()
+		}()
+	}
+	wg.Wait()
+	if got := c.Count(); got != calls {
+		t.Fatalf("Count() = %d, want %d", got, calls)
+	}
 }
