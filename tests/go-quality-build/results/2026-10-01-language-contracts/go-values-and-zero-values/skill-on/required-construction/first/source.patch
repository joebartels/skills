diff --git a/counter.go b/counter.go
index 4fb3daa00d41e7366140193136f352d0fbe2e35e..2455569871c324fe32c111c268854937786883d5 100644
--- a/counter.go
+++ b/counter.go
@@ -30,3 +30,11 @@ func (c *Counter) Sign(data []byte) []byte {
 	m.Write(data)
 	return m.Sum(nil)
 }
+
+// Count returns the number of Sign calls made on c.
+// It is safe to call concurrently with Sign and other Count calls.
+func (c *Counter) Count() uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.count
+}
