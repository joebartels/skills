+
+// NewWithLimit creates a formatter that shows at most limit items. A limit of
+// zero means that all items are shown. Negative limits are invalid.
+func NewWithLimit(limit int) (Formatter, error) {
+	if limit < 0 {
+		return Formatter{}, errors.New("reportview: limit must not be negative")
+	}
+	return Formatter{limit: limit, configured: true}, nil
+}
+
+// Format returns JSON for items, which it borrows without modifying.
+func (f Formatter) Format(items []string) ([]byte, error) {
+	limit := f.limit
+	if !f.configured {
+		limit = 10
+	}
+	if limit > 0 && len(items) > limit {
+		items = items[:limit]
 	}
 	return json.Marshal(struct {
 		Items []string `json:"items"`
diff --git a/view_test.go b/view_test.go
index 845ddf8c2bf07aefe2be79c4a891d50394fc770b..52b4ee0da61eda4fbea0d4e5334a8075f9a3303a 100644
--- a/view_test.go
+++ b/view_test.go
@@ -9,3 +9,57 @@ func TestDefault(t *testing.T) {
 		t.Fatalf("%s %v", b, err)
 	}
 }
+
+func TestNewPreservesFactoryTypeAndDefaultLimit(t *testing.T) {
+	var factory func() Formatter = New
+	b, err := factory().Format([]string{"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k"})
+	if err != nil || string(b) != `{"items":["a","b","c","d","e","f","g","h","i","j"]}` {
+		t.Fatalf("%s %v", b, err)
+	}
+}
+
+func TestNewWithLimit(t *testing.T) {
+	items := []string{"a", "b", "c"}
+	f, err := NewWithLimit(2)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := f.Format(items)
+	if err != nil || string(b) != `{"items":["a","b"]}` {
+		t.Fatalf("%s %v", b, err)
+	}
+	if len(items) != 3 || items[2] != "c" {
+		t.Fatalf("Format changed borrowed input: %#v", items)
+	}
+
+	f, err = NewWithLimit(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err = f.Format(items)
+	if err != nil || string(b) != `{"items":["a","b","c"]}` {
+		t.Fatalf("unlimited format = %s, %v", b, err)
+	}
+}
+
+func TestNewWithLimitRejectsNegative(t *testing.T) {
+	if _, err := NewWithLimit(-1); err == nil {
+		t.Fatal("NewWithLimit(-1) succeeded")
+	}
+}
+
+func TestNilAndEmptyJSONRepresentations(t *testing.T) {
+	f, err := NewWithLimit(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		items []string
+		want  string
+	}{{nil, `{"items":null}`}, {[]string{}, `{"items":[]}`}} {
+		got, err := f.Format(tc.items)
+		if err != nil || string(got) != tc.want {
+			t.Errorf("Format(%#v) = %s, %v; want %s", tc.items, got, err, tc.want)
+		}
+	}
+}
