+import (
+	"testing"
+
+	"example.com/editgraph"
+)
+
+func TestForkFromExternalConsumer(t *testing.T) {
+	var _ interface{ Fork() editgraph.Graph } = editgraph.Graph{}
+
+	root := &editgraph.Node{Name: "original"}
+	fork := (editgraph.Graph{Root: root}).Fork()
+	fork.Root.Name = "draft"
+	if root.Name != "original" {
+		t.Fatal("external caller could not edit a fork independently")
+	}
+}
