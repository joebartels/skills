+func TestForkPreservesGraphShapeAndSeparatesMutableData(t *testing.T) {
+	shared := &Node{
+		Name:   "shared",
+		Values: map[string][]byte{"payload": make([]byte, len("original"), len("original")+4)},
+	}
+	copy(shared.Values["payload"], "original")
+	links := make([]*Node, 3, 5)
+	root := &Node{
+		Name:   "root",
+		Values: map[string][]byte{"root": make([]byte, len("value"), len("value")+4)},
+		Links:  links,
+	}
+	copy(root.Values["root"], "value")
+	root.Links[0], root.Links[1] = shared, shared
+	shared.Links = []*Node{root}
+
+	fork := (Graph{Root: root}).Fork()
+	if fork.Root == root {
+		t.Fatal("Fork reused the root")
+	}
+	if fork.Root.Links[0] != fork.Root.Links[1] {
+		t.Fatal("Fork did not preserve shared links")
+	}
+	if fork.Root.Links[0].Links[0] != fork.Root {
+		t.Fatal("Fork did not preserve the cycle")
+	}
+	if fork.Root.Links[2] != nil {
+		t.Fatal("Fork did not preserve a nil link")
+	}
+
+	fork.Root.Name = "fork root"
+	fork.Root.Values["root"][0] = 'V'
+	fork.Root.Values["new"] = []byte("fork only")
+	fork.Root.Links[0].Name = "fork shared"
+	fork.Root.Links[0].Values["payload"][0] = 'F'
+	fork.Root.Values["root"] = append(fork.Root.Values["root"], '!')
+	fork.Root.Links[0].Values["payload"] = append(fork.Root.Links[0].Values["payload"], '!')
+	fork.Root.Links = append(fork.Root.Links, &Node{Name: "fork link"})
+	fork.Root.Links[0].Values["extra"] = []byte("fork only")
+	if root.Name != "root" || string(root.Values["root"]) != "value" {
+		t.Fatal("editing the fork changed original root data")
+	}
+	if _, ok := root.Values["new"]; ok {
+		t.Fatal("editing the fork added an entry to the original root")
+	}
+	if shared.Name != "shared" || string(shared.Values["payload"]) != "original" {
+		t.Fatal("editing the fork changed original linked-node data")
+	}
+	if _, ok := shared.Values["extra"]; ok {
+		t.Fatal("editing the fork added an entry to the original linked node")
+	}
+	if len(root.Links) != 3 || len(root.Values["root"]) != len("value") || len(shared.Values["payload"]) != len("original") {
+		t.Fatal("appending to the fork changed an original collection")
+	}
+
+	root.Name = "changed original"
+	root.Values["root"][1] = 'X'
+	root.Values["original only"] = []byte("original")
+	root.Links = append(root.Links, &Node{Name: "original link"})
+	shared.Name = "changed original shared"
+	shared.Values["payload"][1] = 'X'
+	if fork.Root.Name != "fork root" || string(fork.Root.Values["root"]) != "Value!" {
+		t.Fatal("editing original root data changed the fork")
+	}
+	if _, ok := fork.Root.Values["original only"]; ok || len(fork.Root.Links) != 4 {
+		t.Fatal("editing original root collections changed the fork")
+	}
+	if fork.Root.Links[0].Name != "fork shared" || string(fork.Root.Links[0].Values["payload"]) != "Friginal!" {
+		t.Fatal("editing original linked-node data changed the fork")
+	}
+}
+
+func TestForkPreservesNilAndEmptyCollections(t *testing.T) {
+	root := &Node{
+		Values: map[string][]byte{
+			"nil":   nil,
+			"empty": {},
+		},
+		Links: []*Node{},
+	}
+	fork := (Graph{Root: root}).Fork()
+	if fork.Root.Values == nil || fork.Root.Links == nil {
+		t.Fatal("Fork changed non-nil empty collections to nil")
+	}
+	if fork.Root.Values["nil"] != nil {
+		t.Fatal("Fork changed a nil byte slice")
+	}
+	if fork.Root.Values["empty"] == nil || len(fork.Root.Values["empty"]) != 0 {
+		t.Fatal("Fork changed a non-nil empty byte slice")
+	}
+
+	nilCollections := (&Node{}).Links
+	if nilCollections != nil {
+		t.Fatal("test setup expected nil links")
+	}
+	if got := (Graph{Root: &Node{}}).Fork().Root; got.Links != nil || got.Values != nil {
+		t.Fatal("Fork changed nil collections to non-nil")
+	}
+}
