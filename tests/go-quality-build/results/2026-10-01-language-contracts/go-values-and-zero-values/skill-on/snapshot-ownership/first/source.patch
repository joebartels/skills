-// RootView returns the original node for caller-owned in-place editing.
+// RootView returns the original root node. The returned node is borrowed, so
+// edits through it modify the graph and may be observed by other Graph values
+// that refer to the same node.
 func (g Graph) RootView() *Node { return g.Root }
+
+// Fork returns an independently editable copy of the graph reachable from g.
+// It preserves sharing and cycles within the graph while copying node data,
+// maps, links, and byte slices. A nil root remains nil.
+func (g Graph) Fork() Graph {
+	if g.Root == nil {
+		return Graph{}
+	}
+	return Graph{Root: cloneNode(g.Root, make(map[*Node]*Node))}
+}
+
+func cloneNode(node *Node, clones map[*Node]*Node) *Node {
+	if node == nil {
+		return nil
+	}
+	if clone, ok := clones[node]; ok {
+		return clone
+	}
+
+	clone := &Node{Name: node.Name}
+	clones[node] = clone
+
+	if node.Values != nil {
+		clone.Values = make(map[string][]byte, len(node.Values))
+		for key, value := range node.Values {
+			if value != nil {
+				clone.Values[key] = append([]byte{}, value...)
+			} else {
+				clone.Values[key] = nil
+			}
+		}
+	}
+	if node.Links != nil {
+		clone.Links = make([]*Node, len(node.Links))
+		for i, link := range node.Links {
+			clone.Links[i] = cloneNode(link, clones)
+		}
+	}
+	return clone
+}
