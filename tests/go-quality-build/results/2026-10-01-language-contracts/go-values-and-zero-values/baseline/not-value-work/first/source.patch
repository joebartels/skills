diff --git a/pages.go b/pages.go
index ca34bfffc56e9c72818486cabcc5482ecc473377..7d7f81438b84f6b1cfb4c45c61aa37115c496ef2 100644
--- a/pages.go
+++ b/pages.go
@@ -1,3 +1,9 @@
 package paging
 
-func pages(items, size int) int { return items/size + 1 }
+func pages(items, size int) int {
+	count := items / size
+	if items%size != 0 {
+		count++
+	}
+	return count
+}
