index 4dbc80098fda1eb492f2ea9a0ac8c09552bffcdf..d1964c0d3b45f24d0d85fe04539afc281f084ddb 100644
--- a/graph.go
+++ b/graph.go
@@ -7,8 +7,47 @@ type Node struct {
 }
 type Graph struct{ Root *Node }
 
-// RootView returns the original node for caller-owned in-place editing.
+// RootView returns the borrowed original node for caller-owned in-place editing.
 func (g Graph) RootView() *Node { return g.Root }
+
+// Fork returns an independently editable copy of the graph reachable from g.
+// Shared links and cycles are preserved within the fork. The returned graph
+// owns its nodes, maps, link slices, and byte payloads.
+func (g Graph) Fork() Graph {
+	if g.Root == nil {
+		return Graph{}
+	}
+	return Graph{Root: cloneNode(g.Root, make(map[*Node]*Node))}
+}
+
+func cloneNode(n *Node, clones map[*Node]*Node) *Node {
+	if n == nil {
+		return nil
+	}
+	if clone, ok := clones[n]; ok {
+		return clone
+	}
+	clone := &Node{Name: n.Name}
+	clones[n] = clone
+	if n.Values != nil {
+		clone.Values = make(map[string][]byte, len(n.Values))
+		for key, value := range n.Values {
+			if value != nil {
+				clone.Values[key] = append([]byte{}, value...)
+			} else {
+				clone.Values[key] = nil
+			}
+		}
+	}
+	if n.Links != nil {
+		clone.Links = make([]*Node, len(n.Links))
+		for i, link := range n.Links {
+			clone.Links[i] = cloneNode(link, clones)
+		}
+	}
+	return clone
+}
