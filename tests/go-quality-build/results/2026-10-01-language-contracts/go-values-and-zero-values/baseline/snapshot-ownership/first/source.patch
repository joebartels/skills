+func TestForkPreservesLayoutAndOwnsMutableData(t *testing.T) {
+	shared := &Node{Name: "shared", Values: map[string][]byte{"payload": {1, 2}}}
+	root := &Node{
+		Name:   "root",
+		Values: map[string][]byte{"empty": {}, "nil": nil},
+		Links:  []*Node{shared, shared, nil},
+	}
+	shared.Links = []*Node{root}
+
+	original := Graph{Root: root}
+	fork := original.Fork()
+	if fork.Root == root || fork.Root.Links[0] != fork.Root.Links[1] {
+		t.Fatal("fork did not preserve independent node identity and sharing")
+	}
+	if fork.Root.Links[0].Links[0] != fork.Root || fork.Root.Links[2] != nil {
+		t.Fatal("fork did not preserve cycle or nil link")
+	}
+	if fork.Root.Values["empty"] == nil || fork.Root.Values["nil"] != nil {
+		t.Fatal("fork changed nil versus non-nil empty map values")
+	}
+
+	fork.Root.Name = "draft"
+	fork.Root.Values["new"] = []byte{3}
+	fork.Root.Values["empty"] = append(fork.Root.Values["empty"], 4)
+	fork.Root.Links[0].Values["payload"][0] = 9
+	fork.Root.Links[0].Name = "draft shared"
+	if root.Name != "root" || root.Values["new"] != nil || len(root.Values["empty"]) != 0 || shared.Values["payload"][0] != 1 || shared.Name != "shared" {
+		t.Fatal("editing the fork changed the original graph")
+	}
+
+	root.Name = "source edit"
+	root.Values["payload"] = []byte{5}
+	shared.Links = nil
+	if fork.Root.Name != "draft" || fork.Root.Links[0].Values["payload"][0] != 9 || fork.Root.Links[0].Links[0] != fork.Root {
+		t.Fatal("editing the original graph changed the fork")
+	}
+}
+
+func TestForkNilAndEmptyCollections(t *testing.T) {
+	var zero Graph
+	if got := zero.Fork(); got.Root != nil {
+		t.Fatal("fork of zero graph has a root")
+	}
+	nilCollections := (Graph{Root: &Node{}}).Fork().Root
+	if nilCollections == nil || nilCollections.Values != nil || nilCollections.Links != nil {
+		t.Fatal("fork changed nil collections")
+	}
+
+	original := Graph{Root: &Node{Values: map[string][]byte{}, Links: []*Node{}}}
+	fork := original.Fork()
+	if fork.Root == original.Root || fork.Root.Values == nil || fork.Root.Links == nil {
+		t.Fatal("fork did not preserve independently owned empty collections")
+	}
+	fork.Root.Values["x"] = []byte{1}
+	fork.Root.Links = append(fork.Root.Links, &Node{})
+	if len(original.Root.Values) != 0 || len(original.Root.Links) != 0 {
+		t.Fatal("editing fork collections changed the original")
+	}
