 	count uint64
 }
 
+// Count returns the number of Sign calls made on c.
+// It is safe to call concurrently with Sign and other Count calls.
+func (c *Counter) Count() uint64 {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if len(c.key) == 0 {
+		panic("signedcounter: use New")
+	}
+	return c.count
+}
