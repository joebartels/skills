diff --git a/counter_test.go b/counter_test.go
index 4cbf261677209547a2cace18d11eccc2fe919a26..a3ba567541b7de45bee675cb69ebf5c3336a383b 100644
--- a/counter_test.go
+++ b/counter_test.go
@@ -2,6 +2,42 @@ package signedcounter
 
 import "testing"
 
+func TestCount(t *testing.T) {
+	c, err := New([]byte("sixteen-byte-key!"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := c.Count(); got != 0 {
+		t.Fatalf("Count() before Sign = %d, want 0", got)
+	}
+	c.Sign(nil)
+	if got := c.Count(); got != 1 {
+		t.Fatalf("Count() after Sign = %d, want 1", got)
+	}
+}
+
+func TestCountConcurrent(t *testing.T) {
+	c, err := New([]byte("sixteen-byte-key!"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	const calls = 100
+	done := make(chan struct{})
+	for i := 0; i < calls; i++ {
+		go func() {
+			c.Sign(nil)
+			done <- struct{}{}
+		}()
+	}
+	for i := 0; i < calls; i++ {
+		_ = c.Count()
+		<-done
+	}
+	if got := c.Count(); got != calls {
+		t.Fatalf("Count() after concurrent Sign calls = %d, want %d", got, calls)
+	}
+}
+
