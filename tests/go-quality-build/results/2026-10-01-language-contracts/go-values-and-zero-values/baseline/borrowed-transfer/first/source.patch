diff --git a/frames_test.go b/frames_test.go
index 934208793bebb63ef7a53495ae8a2c669dd7c839..9658586a15167f1bbeee0740069cb9abca55a127 100644
--- a/frames_test.go
+++ b/frames_test.go
@@ -1,6 +1,8 @@
 package framecollect
 
 import (
+	"bytes"
+	"errors"
 	"io"
 	"testing"
 )
@@ -8,9 +10,75 @@ import (
 type empty struct{}
 
 func (empty) Next() ([]byte, error) { return nil, io.EOF }
+
+var (
+	_ func(Source) ([][]byte, error)                    = Collect
+	_ func(Source, func([]byte) bool) ([][]byte, error) = CollectMatching
+)
+
 func TestEmpty(t *testing.T) {
 	b, err := Collect(empty{})
 	if len(b) != 0 || err != nil {
 		t.Fatalf("%v %v", b, err)
 	}
 }
+
+type sequence struct {
+	frames [][]byte
+	index  int
+	err    error
+}
+
+func (s *sequence) Next() ([]byte, error) {
+	if s.index < len(s.frames) {
+		frame := s.frames[s.index]
+		s.index++
+		return frame, nil
+	}
+	if s.err != nil {
+		return nil, s.err
+	}
+	return nil, io.EOF
+}
+
+func TestCollectMatchingFiltersBorrowedFramesAndOwnsResults(t *testing.T) {
+	buffer := []byte("one")
+	src := &sequence{frames: [][]byte{buffer, nil, []byte{}, []byte("skip")}}
+	got, err := CollectMatching(src, func(frame []byte) bool {
+		if len(frame) == 0 {
+			return true
+		}
+		// The predicate sees the source's borrowed bytes directly.
+		if &frame[0] != &buffer[0] && bytes.Equal(frame, []byte("one")) {
+			t.Fatal("predicate received a copied frame")
+		}
+		return !bytes.Equal(frame, []byte("skip"))
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 3 || !bytes.Equal(got[0], []byte("one")) || got[1] != nil || got[2] == nil || len(got[2]) != 0 {
+		t.Fatalf("unexpected retained frames: %#v", got)
+	}
+	copy(buffer, []byte("new"))
+	if !bytes.Equal(got[0], []byte("one")) {
+		t.Fatalf("returned frame changed with source buffer: %q", got[0])
+	}
+}
+
+func TestCollectMatchingNilPredicateKeepsAllFrames(t *testing.T) {
+	got, err := CollectMatching(&sequence{frames: [][]byte{nil, []byte{}}}, nil)
+	if err != nil || len(got) != 2 || got[0] != nil || got[1] == nil {
+		t.Fatalf("got %#v, %v", got, err)
+	}
+}
+
+func TestCollectMatchingReturnsAcceptedPrefixAndOriginalError(t *testing.T) {
+	wantErr := errors.New("source failed")
+	got, err := CollectMatching(&sequence{frames: [][]byte{[]byte("keep"), []byte("drop")}, err: wantErr}, func(frame []byte) bool {
+		return bytes.Equal(frame, []byte("keep"))
+	})
+	if err != wantErr || len(got) != 1 || string(got[0]) != "keep" {
+		t.Fatalf("got %#v, %v", got, err)
+	}
+}
