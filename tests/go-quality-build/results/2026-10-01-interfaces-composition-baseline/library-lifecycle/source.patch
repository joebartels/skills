+package refreshkit_test
+
+import (
+	"context"
+	"errors"
+	refreshkit "example.com/library-lifecycle"
+	"fmt"
+	"time"
+)
+
+func ExamplePeriodicRun_orderlyShutdown() {
+	newRefresher := func() *refreshkit.Refresher {
+		r, err := refreshkit.New(func(ctx context.Context) error {
+			<-ctx.Done()
+			return ctx.Err()
+		})
+		if err != nil {
+			panic(err)
+		}
+		return r
+	}
+
+	first, err := newRefresher().StartPeriodic(context.Background(), time.Minute)
+	if err != nil {
+		panic(err)
+	}
+	second, err := newRefresher().StartPeriodic(context.Background(), 5*time.Minute)
+	if err != nil {
+		first.Stop()
+		_ = first.Wait()
+		panic(err)
+	}
+
+	first.Stop()
+	second.Stop()
+	if err := first.Wait(); !errors.Is(err, context.Canceled) {
+		panic(err)
+	}
+	if err := second.Wait(); !errors.Is(err, context.Canceled) {
+		panic(err)
+	}
+	fmt.Println("both refreshers stopped; callback resources can be released")
+
+	// Output: both refreshers stopped; callback resources can be released
+}
