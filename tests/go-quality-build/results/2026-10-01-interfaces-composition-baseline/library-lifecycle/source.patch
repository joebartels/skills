 func (r *Refresher) Refresh(ctx context.Context) error { return r.refresh(ctx) }
+
+// StartPeriodic starts one periodic refresh run. The first refresh begins
+// immediately; later refreshes begin interval after the preceding successful
+// refresh completes. A run never overlaps its own refresh callbacks.
+//
+// The caller should call Stop and then Wait before releasing resources used by
+// the callback. A Refresher can have only one active periodic run; starting a
+// second run before the first finishes returns an error. A run may be started
+// again after Wait has returned.
+func (r *Refresher) StartPeriodic(ctx context.Context, interval time.Duration) (*PeriodicRun, error) {
+	if interval <= 0 {
+		return nil, fmt.Errorf("periodic refresh interval must be positive")
+	}
+
+	r.mu.Lock()
+	if r.running {
+		r.mu.Unlock()
+		return nil, errors.New("periodic refresh already running")
+	}
+	r.running = true
+	r.mu.Unlock()
+
+	runCtx, cancel := context.WithCancel(ctx)
+	run := &PeriodicRun{cancel: cancel, done: make(chan struct{})}
+	go func() {
+		defer func() {
+			cancel()
+			r.mu.Lock()
+			r.running = false
+			r.mu.Unlock()
+			close(run.done)
+		}()
+
+		for {
+			if err := runCtx.Err(); err != nil {
+				run.err = context.Canceled
+				return
+			}
+			if err := r.refresh(runCtx); err != nil {
+				run.err = err
+				return
+			}
+
+			timer := time.NewTimer(interval)
+			select {
+			case <-runCtx.Done():
+				if !timer.Stop() {
+					<-timer.C
+				}
+				run.err = context.Canceled
+				return
+			case <-timer.C:
+			}
+		}
+	}()
+	return run, nil
+}
+
+// PeriodicRun controls and observes a periodic refresh started by
+// Refresher.StartPeriodic.
+type PeriodicRun struct {
+	cancel context.CancelFunc
+	done   chan struct{}
+	err    error
+}
+
+// Stop requests cancellation of the active refresh, if any. It is safe to call
+// Stop more than once. Stop does not wait for the callback to return; call Wait
+// before releasing callback resources.
+func (run *PeriodicRun) Stop() { run.cancel() }
+
+// Wait blocks until the periodic run finishes. It returns context.Canceled
+// when Stop or the parent context ends the run, the callback error unchanged
+// when a refresh fails, and nil only if the run were otherwise terminated.
+func (run *PeriodicRun) Wait() error {
+	<-run.done
+	return run.err
+}
