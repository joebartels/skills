+func TestPeriodicStopWaitsForActiveRefresh(t *testing.T) {
+	started := make(chan struct{})
+	finished := make(chan struct{})
+	r, err := refreshkit.New(func(ctx context.Context) error {
+		close(started)
+		<-ctx.Done()
+		close(finished)
+		return ctx.Err()
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	run, err := r.StartPeriodic(context.Background(), time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	<-started
+	run.Stop()
+	if err := run.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("Wait error = %v, want context.Canceled", err)
+	}
+	select {
+	case <-finished:
+	default:
+		t.Fatal("Wait returned before active callback finished")
+	}
+}
+
+func TestPeriodicInstancesAreIndependent(t *testing.T) {
+	firstStarted := make(chan struct{})
+	secondStarted := make(chan struct{})
+	first, err := refreshkit.New(func(ctx context.Context) error {
+		close(firstStarted)
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := refreshkit.New(func(ctx context.Context) error {
+		close(secondStarted)
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstRun, err := first.StartPeriodic(context.Background(), time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondRun, err := second.StartPeriodic(context.Background(), time.Hour)
+	if err != nil {
+		firstRun.Stop()
+		_ = firstRun.Wait()
+		t.Fatal(err)
+	}
+	<-firstStarted
+	<-secondStarted
+
+	firstRun.Stop()
+	if err := firstRun.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("first Wait error = %v", err)
+	}
+	select {
+	case err := <-waitResult(secondRun):
+		t.Fatalf("second run stopped with first: %v", err)
+	default:
+	}
+
+	secondRun.Stop()
+	if err := secondRun.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("second Wait error = %v", err)
+	}
+}
+
+func TestPeriodicRefreshError(t *testing.T) {
+	want := errors.New("periodic refresh failed")
+	calls := 0
+	r, err := refreshkit.New(func(context.Context) error {
+		calls++
+		return want
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	run, err := r.StartPeriodic(context.Background(), time.Millisecond)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := run.Wait(); err != want {
+		t.Fatalf("Wait error = %v, want original error %v", err, want)
+	}
+	if calls != 1 {
+		t.Fatalf("callback calls = %d, want 1", calls)
+	}
+}
+
+func TestPeriodicRejectsInvalidIntervalAndDuplicateRun(t *testing.T) {
+	r, err := refreshkit.New(func(ctx context.Context) error {
+		<-ctx.Done()
+		return ctx.Err()
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.StartPeriodic(context.Background(), 0); err == nil {
+		t.Fatal("zero interval accepted")
+	}
+	run, err := r.StartPeriodic(context.Background(), time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := r.StartPeriodic(context.Background(), time.Hour); err == nil {
+		run.Stop()
+		_ = run.Wait()
+		t.Fatal("duplicate run accepted")
+	}
+	run.Stop()
+	if err := run.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("Wait error = %v", err)
+	}
+}
+
+func waitResult(run *refreshkit.PeriodicRun) <-chan error {
+	result := make(chan error, 1)
+	go func() { result <- run.Wait() }()
+	return result
+}
