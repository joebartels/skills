--- a/batches.go
+++ b/batches.go
@@ -1,3 +1,9 @@
 package batches
 
-func batchCount(items, size int) int { return items / size }
+func batchCount(items, size int) int {
+	count := items / size
+	if items%size != 0 {
+		count++
+	}
+	return count
+}
