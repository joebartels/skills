+func TestTwoSendersCanSendConcurrently(t *testing.T) {
+	type received struct {
+		authorization string
+		id            string
+	}
+	requests := make(chan received, 2)
+	entered := make(chan struct{}, 2)
+	release := make(chan struct{})
+	newClient := func(token, endpoint string) *http.Client {
+		return &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+			r.Header.Set("Authorization", "Bearer "+token)
+			if r.Method != http.MethodPost || r.URL.String() != endpoint || r.Header.Get("Content-Type") != "application/json" {
+				t.Errorf("unexpected request: %s %s", r.Method, r.URL)
+			}
+			if r.Header.Get("Authorization") != "Bearer "+token {
+				t.Errorf("authorization = %q, want tenant %q", r.Header.Get("Authorization"), token)
+			}
+			var payload struct {
+				ID string `json:"id"`
+			}
+			if err := json.NewDecoder(r.Body).Decode(&payload); err != nil {
+				return nil, err
+			}
+			requests <- received{authorization: r.Header.Get("Authorization"), id: payload.ID}
+			entered <- struct{}{}
+			<-release
+			return &http.Response{StatusCode: http.StatusNoContent, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+		})}
+	}
+	const endpointA = "https://tenant-a.invalid/receipts"
+	const endpointB = "https://tenant-b.invalid/receipts"
+	senderA := NewSender(endpointA, newClient("tenant-a", endpointA))
+	senderB := NewSender(endpointB, newClient("tenant-b", endpointB))
+
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for _, call := range []struct {
+		sender Sender
+		id     string
+	}{{senderA, `a"\id`}, {senderB, "tenant-b-id"}} {
+		wg.Add(1)
+		go func(sender Sender, id string) {
+			defer wg.Done()
+			<-start
+			if err := sender.Send(context.Background(), id); err != nil {
+				t.Errorf("Send(%q): %v", id, err)
+			}
+		}(call.sender, call.id)
+	}
+	close(start)
+	<-entered
+	<-entered
+	close(release)
+	wg.Wait()
+	close(requests)
+
+	got := make(map[string]received)
+	for request := range requests {
+		got[request.authorization] = request
+	}
+	if got["Bearer tenant-a"].id != `a"\id` || got["Bearer tenant-b"].id != "tenant-b-id" {
+		t.Fatalf("tenant requests were not routed with their own client policies: %#v", got)
 	}
 }
+
+func TestSendHonorsPerCallCancellation(t *testing.T) {
+	entered := make(chan struct{})
+	client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+		close(entered)
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})}
+	sender := NewSender("https://receipts.invalid/send", client)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- sender.Send(ctx, "abc") }()
+	<-entered
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil || !strings.Contains(err.Error(), context.Canceled.Error()) {
+			t.Fatalf("Send error = %v, want context canceled", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("Send did not return after context cancellation")
+	}
+}
+
+func TestSendRejectsNon2xx(t *testing.T) {
+	client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: http.StatusBadGateway, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+	})}
+	err := NewSender("https://receipts.invalid/send", client).Send(context.Background(), "abc")
+	if err == nil || !strings.Contains(err.Error(), "502") {
+		t.Fatalf("Send error = %v, want status 502", err)
+	}
+}
+
+func TestSendRequiresClient(t *testing.T) {
+	if err := NewSender("https://receipts.invalid/send", nil).Send(context.Background(), "abc"); err == nil {
+		t.Fatal("Send with nil client succeeded")
+	}
+}
