+func TestCSVQuoting(t *testing.T) {
+	r := reportkit.Report{Encoder: reportkit.CSV{}}
+	got, err := r.Render([]reportkit.Record{{Name: "a,b", Value: "say \"hi\"\nnext"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "name,value\n\"a,b\",\"say \"\"hi\"\"\nnext\"\n"
+	if string(got) != want {
+		t.Fatalf("report = %q, want %q", got, want)
+	}
+}
+
+func TestCSVEmptyInputHasHeader(t *testing.T) {
+	r := reportkit.Report{Encoder: reportkit.CSV{}}
+	got, err := r.Render(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "name,value\n" {
+		t.Fatalf("report = %q", got)
+	}
+}
+
+type failingWriter struct{ err error }
+
+func (w failingWriter) Write([]byte) (int, error) { return 0, w.err }
+
+func TestCSVEncodingFailure(t *testing.T) {
+	wantErr := errors.New("disk full")
+	if err := (reportkit.CSV{}).Encode(failingWriter{err: wantErr}, []reportkit.Record{{Name: "x", Value: "y"}}); !errors.Is(err, wantErr) {
+		t.Fatalf("Encode error = %v, want %v", err, wantErr)
+	}
+}
+
+type hostEncoder struct{}
+
+func (hostEncoder) Encode(w io.Writer, records []reportkit.Record) error {
+	for _, record := range records {
+		if _, err := fmt.Fprintf(w, "%s=%s\n", record.Name, record.Value); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func ExampleReport_hostEncoder() {
+	r := reportkit.Report{Encoder: hostEncoder{}}
+	got, err := r.Render([]reportkit.Record{{Name: "total", Value: "7"}})
+	if err != nil {
+		panic(err)
+	}
+	fmt.Print(string(got))
+	// Output: total=7
+}
