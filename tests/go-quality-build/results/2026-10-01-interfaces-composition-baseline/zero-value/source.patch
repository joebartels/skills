+var ErrLimitReached = errors.New("bag: distinct-key limit reached")
+
+// Bag accumulates counts by key. Its zero value is ready for use and has no
+// distinct-key limit. Configure a limit with SetLimit before adding keys.
+type Bag struct {
+	counts map[string]int
+	limit  int
+}
+
+// SetLimit configures the maximum number of distinct keys. A limit of zero
+// means unlimited. Negative limits are rejected without changing the Bag.
+func (b *Bag) SetLimit(limit int) error {
+	if limit < 0 {
+		return errors.New("bag: limit must be nonnegative")
+	}
+	b.limit = limit
+	return nil
+}
+
+// Add increments the count for key, or returns ErrLimitReached if key is new
+// and the configured distinct-key limit has already been reached.
+func (b *Bag) Add(key string) error {
+	if _, exists := b.counts[key]; !exists && b.limit > 0 && len(b.counts) >= b.limit {
+		return ErrLimitReached
+	}
 	if b.counts == nil {
 		b.counts = make(map[string]int)
 	}
 	b.counts[key]++
+	return nil
 }
+
 func (b *Bag) Count(key string) int { return b.counts[key] }
+
+// Clear removes all counts and retains the configured limit.
+func (b *Bag) Clear() { b.counts = nil }
