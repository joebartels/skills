+func TestLimitAndClear(t *testing.T) {
+	var b Bag
+	if err := b.SetLimit(2); err != nil {
+		t.Fatal(err)
+	}
+	if err := b.Add("jobs"); err != nil {
+		t.Fatal(err)
+	}
+	if err := b.Add("jobs"); err != nil {
+		t.Fatalf("existing key at limit: %v", err)
+	}
+	if err := b.Add("errors"); err != nil {
+		t.Fatal(err)
+	}
+	if err := b.Add("new"); err != ErrLimitReached {
+		t.Fatalf("new key at limit error = %v, want %v", err, ErrLimitReached)
+	}
+	if got := b.Count("new"); got != 0 {
+		t.Fatalf("rejected key count = %d, want 0", got)
+	}
+	if got := b.Count("jobs"); got != 2 {
+		t.Fatalf("existing count after rejection = %d, want 2", got)
+	}
+
+	b.Clear()
+	if got := b.Count("jobs"); got != 0 {
+		t.Fatalf("count after clear = %d, want 0", got)
+	}
+	if err := b.Add("again"); err != nil {
+		t.Fatalf("first key after clear: %v", err)
+	}
+	if err := b.Add("second"); err != nil {
+		t.Fatalf("second key after clear: %v", err)
+	}
+	if err := b.Add("third"); err != ErrLimitReached {
+		t.Fatalf("third key after clear error = %v, want %v", err, ErrLimitReached)
+	}
+}
+
+func TestSetLimitRejectsNegative(t *testing.T) {
+	var b Bag
+	if err := b.SetLimit(-1); err == nil {
+		t.Fatal("SetLimit(-1) succeeded")
+	}
+	if err := b.Add("unlimited"); err != nil {
+		t.Fatalf("negative limit changed zero value: %v", err)
+	}
+}
