+++ b/store/file.go
@@ -0,0 +1,16 @@
+package store
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+)
+
+// File stores the existing queued record format in Dir.
+type File struct {
+	Dir string
+}
+
+func (f File) Save(_ context.Context, id string) error {
+	return os.WriteFile(filepath.Join(f.Dir, id), []byte("queued\n"), 0600)
+}
