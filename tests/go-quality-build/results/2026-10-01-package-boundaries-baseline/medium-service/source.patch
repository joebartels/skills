@@ -0,0 +1,53 @@
+package main
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"example.com/dispatch"
+	"example.com/dispatch/notify"
+	"example.com/dispatch/store"
+)
+
+func main() {
+	if err := run(context.Background(), os.Args[1:], os.Getenv); err != nil {
+		log.Fatal(err)
+	}
+}
+
+func run(ctx context.Context, args []string, getenv func(string) string) error {
+	if len(args) != 1 {
+		return errors.New("usage: replay FILE")
+	}
+	f, err := os.Open(args[0])
+	if err != nil {
+		return fmt.Errorf("open batch: %w", err)
+	}
+	defer f.Close()
+
+	s := dispatch.Service{
+		Store:    store.File{Dir: getenv("RECORD_DIR")},
+		Notifier: notify.HTTP{URL: getenv("NOTIFY_URL"), Client: &http.Client{Timeout: 5 * time.Second}},
+	}
+	scan := bufio.NewScanner(f)
+	for line := 1; scan.Scan(); line++ {
+		id := strings.TrimSpace(scan.Text())
+		if id == "" {
+			continue
+		}
+		if err := s.Submit(ctx, id); err != nil {
+			return fmt.Errorf("line %d: %w", line, err)
+		}
+	}
+	if err := scan.Err(); err != nil {
+		return fmt.Errorf("read batch: %w", err)
+	}
+	return nil
+}
diff --git a/cmd/replay/main_test.go b/cmd/replay/main_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/replay/main_test.go
@@ -0,0 +1,106 @@
+package main
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+func TestReplayProcessesTrimmedLinesInOrder(t *testing.T) {
+	var ids []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		ids = append(ids, string(body))
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	file := filepath.Join(t.TempDir(), "batch.txt")
+	if err := os.WriteFile(file, []byte("  a  \n\n b\t\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := run(context.Background(), []string{file}, env(dir, ts.URL)); err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(ids, []string{"a", "b"}) {
+		t.Fatalf("notifications = %q", ids)
+	}
+	for _, id := range ids {
+		body, err := os.ReadFile(filepath.Join(dir, id))
+		if err != nil || string(body) != "queued\n" {
+			t.Fatalf("record %s = %q, %v", id, body, err)
+		}
+	}
+}
+
+func TestReplayStopsOnInvalidID(t *testing.T) {
+	var ids []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		ids = append(ids, string(body))
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	file := filepath.Join(t.TempDir(), "batch.txt")
+	if err := os.WriteFile(file, []byte("a\n../bad\nb\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := run(context.Background(), []string{file}, env(dir, ts.URL)); err == nil {
+		t.Fatal("invalid ID reported as success")
+	}
+	if !reflect.DeepEqual(ids, []string{"a"}) {
+		t.Fatalf("notifications = %q", ids)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "b")); !os.IsNotExist(err) {
+		t.Fatalf("later record exists or stat failed: %v", err)
+	}
+}
+
+func TestReplayStopsOnNotificationFailure(t *testing.T) {
+	var ids []string
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		ids = append(ids, string(body))
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer ts.Close()
+	dir := t.TempDir()
+	file := filepath.Join(t.TempDir(), "batch.txt")
+	if err := os.WriteFile(file, []byte("a\nb\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := run(context.Background(), []string{file}, env(dir, ts.URL)); err == nil {
+		t.Fatal("notification failure reported as success")
+	}
+	if !reflect.DeepEqual(ids, []string{"a"}) {
+		t.Fatalf("notifications = %q", ids)
+	}
+	if body, err := os.ReadFile(filepath.Join(dir, "a")); err != nil || string(body) != "queued\n" {
+		t.Fatalf("failed notification record = %q, %v", body, err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "b")); !os.IsNotExist(err) {
+		t.Fatalf("later record exists or stat failed: %v", err)
+	}
+}
+
+func env(dir, url string) func(string) string {
+	return func(key string) string {
+		switch key {
+		case "RECORD_DIR":
+			return dir
+		case "NOTIFY_URL":
+			return url
+		default:
+			return ""
+		}
+	}
+}
