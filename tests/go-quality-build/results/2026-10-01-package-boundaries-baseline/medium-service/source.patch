+func TestServeHTTPPreservesResponses(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer ts.Close()
+	s := Service{Store: store.File{Dir: t.TempDir()}, Notifier: notify.HTTP{URL: ts.URL, Client: ts.Client()}}
+	for _, tc := range []struct {
+		method, target string
+		status         int
+		body           string
+	}{
+		{"GET", "/?id=a", http.StatusMethodNotAllowed, ""},
+		{"POST", "/?id=../bad", http.StatusBadRequest, "submission failed\n"},
+		{"POST", "/?id=a", http.StatusNoContent, ""},
+	} {
+		rec := httptest.NewRecorder()
+		s.ServeHTTP(rec, httptest.NewRequest(tc.method, tc.target, nil))
+		if rec.Code != tc.status || rec.Body.String() != tc.body {
+			t.Fatalf("%s %s = %d %q, want %d %q", tc.method, tc.target, rec.Code, rec.Body.String(), tc.status, tc.body)
+		}
+	}
+}
diff --git a/notify/http.go b/notify/http.go
new file mode 100644
--- /dev/null
+++ b/notify/http.go
@@ -0,0 +1,30 @@
+package notify
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strings"
+)
+
+// HTTP sends IDs to the notification API.
+type HTTP struct {
+	URL    string
+	Client *http.Client
+}
+
+func (n HTTP) Notify(ctx context.Context, id string) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, n.URL, strings.NewReader(id))
+	if err != nil {
+		return err
+	}
+	resp, err := n.Client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusNoContent {
+		return fmt.Errorf("notification status %d", resp.StatusCode)
+	}
+	return nil
+}
