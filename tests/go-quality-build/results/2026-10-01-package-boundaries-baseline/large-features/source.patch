diff --git a/internal/billing/row.go b/internal/billing/row.go
new file mode 100644
--- /dev/null
+++ b/internal/billing/row.go
@@ -0,0 +1,70 @@
+package billing
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+)
+
+// Invoice is one billing ledger record.
+type Invoice struct {
+	ID    string
+	Cents int
+}
+
+func validateInvoice(v Invoice) error {
+	if v.ID == "" || strings.ContainsAny(v.ID, ",\r\n") || v.Cents <= 0 {
+		return fmt.Errorf("invalid invoice")
+	}
+	return nil
+}
+
+// EncodeRow returns the ledger's ID,CENTS newline format.
+func EncodeRow(v Invoice) ([]byte, error) {
+	if err := validateInvoice(v); err != nil {
+		return nil, err
+	}
+	return []byte(v.ID + "," + strconv.Itoa(v.Cents) + "\n"), nil
+}
+
+// DecodeRow parses one row without its terminating newline.
+func DecodeRow(row string) (Invoice, error) {
+	id, amount, ok := strings.Cut(row, ",")
+	if !ok || amount == "" {
+		return Invoice{}, fmt.Errorf("invalid invoice row %q", row)
+	}
+	cents, err := strconv.Atoi(amount)
+	if err != nil {
+		return Invoice{}, fmt.Errorf("invalid invoice amount %q: %w", amount, err)
+	}
+	v := Invoice{ID: id, Cents: cents}
+	if err := validateInvoice(v); err != nil {
+		return Invoice{}, fmt.Errorf("invalid invoice row %q: %w", row, err)
+	}
+	return v, nil
+}
+
+// RowReader reads settlement input or a billing ledger one row at a time.
+type RowReader struct {
+	r *bufio.Reader
+}
+
+func NewRowReader(r io.Reader) *RowReader { return &RowReader{r: bufio.NewReader(r)} }
+
+// NewLedgerReader decodes existing billing ledger rows with the same codec.
+func NewLedgerReader(r io.Reader) *RowReader { return NewRowReader(r) }
+
+// Next returns io.EOF after the last row. A final row need not end in newline.
+func (r *RowReader) Next() (Invoice, error) {
+	line, err := r.r.ReadString('\n')
+	if err != nil && err != io.EOF {
+		return Invoice{}, err
+	}
+	if err == io.EOF && line == "" {
+		return Invoice{}, io.EOF
+	}
+	line = strings.TrimSuffix(line, "\n")
+	return DecodeRow(line)
+}
diff --git a/internal/billing/row_test.go b/internal/billing/row_test.go
new file mode 100644
--- /dev/null
+++ b/internal/billing/row_test.go
@@ -0,0 +1,46 @@
+package billing
+
+import (
+	"io"
+	"strings"
+	"testing"
+)
+
+func TestRowCodec(t *testing.T) {
+	for _, v := range []Invoice{{ID: "a", Cents: 1}, {ID: "id with space", Cents: 4200}} {
+		row, err := EncodeRow(v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got, err := DecodeRow(strings.TrimSuffix(string(row), "\n"))
+		if err != nil || got != v {
+			t.Fatalf("round trip %q: %+v, %v", row, got, err)
+		}
+	}
+}
+
+func TestRowCodecRejectsMalformed(t *testing.T) {
+	for _, row := range []string{"", "a", ",1", "a,", "a,0", "a,-1", "a,no", "a,1,2", "a,1\r", "a\nb,1"} {
+		if _, err := DecodeRow(row); err == nil {
+			t.Errorf("accepted %q", row)
+		}
+	}
+	for _, v := range []Invoice{{ID: "", Cents: 1}, {ID: "a,b", Cents: 1}, {ID: "a\nb", Cents: 1}, {ID: "a\rb", Cents: 1}, {ID: "a", Cents: 0}} {
+		if _, err := EncodeRow(v); err == nil {
+			t.Errorf("encoded %+v", v)
+		}
+	}
+}
+
+func TestRowReader(t *testing.T) {
+	r := NewLedgerReader(strings.NewReader("a,1\nb,2"))
+	for _, want := range []Invoice{{ID: "a", Cents: 1}, {ID: "b", Cents: 2}} {
+		got, err := r.Next()
+		if err != nil || got != want {
+			t.Fatalf("got %+v, %v; want %+v", got, err, want)
+		}
+	}
+	if _, err := r.Next(); err != io.EOF {
+		t.Fatalf("want EOF, got %v", err)
+	}
+}
diff --git a/internal/gateway/http.go b/internal/gateway/http.go
new file mode 100644
--- /dev/null
+++ b/internal/gateway/http.go
@@ -0,0 +1,31 @@
+// Package gateway owns the payment gateway's HTTP protocol.
+package gateway
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+type Client struct {
+	HTTPClient *http.Client
+	URL        string
+}
+
+func (c Client) Charge(ctx context.Context, id string, cents int) error {
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.URL, strings.NewReader(id+","+strconv.Itoa(cents)))
+	if err != nil {
+		return err
+	}
+	resp, err := c.HTTPClient.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusNoContent {
+		return fmt.Errorf("gateway status %d", resp.StatusCode)
+	}
+	return nil
+}
