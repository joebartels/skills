diff --git a/cmd/settle/main.go b/cmd/settle/main.go
new file mode 100644
--- /dev/null
+++ b/cmd/settle/main.go
@@ -0,0 +1,60 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"example.com/commerce/internal/billing"
+	"example.com/commerce/internal/gateway"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+)
+
+func settle(ctx context.Context, input io.Reader, service *billing.Service) error {
+	rows := billing.NewRowReader(input)
+	for rowNumber := 1; ; rowNumber++ {
+		invoice, err := rows.Next()
+		if errors.Is(err, io.EOF) {
+			return nil
+		}
+		if err != nil {
+			return fmt.Errorf("row %d: %w", rowNumber, err)
+		}
+		if err := service.Charge(ctx, invoice.ID, invoice.Cents); err != nil {
+			return fmt.Errorf("row %d: %w", rowNumber, err)
+		}
+	}
+}
+
+func run(args []string) error {
+	if len(args) != 1 {
+		return fmt.Errorf("usage: settle FILE")
+	}
+	input, err := os.Open(args[0])
+	if err != nil {
+		return err
+	}
+	defer input.Close()
+	ledger, err := os.OpenFile(os.Getenv("LEDGER"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	defer ledger.Close()
+	service := billing.Service{
+		Ledger: ledger,
+		Gateway: gateway.Client{
+			HTTPClient: &http.Client{Timeout: 5 * time.Second},
+			URL:        os.Getenv("GATEWAY_URL"),
+		},
+	}
+	return settle(context.Background(), input, &service)
+}
+
+func main() {
+	if err := run(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
