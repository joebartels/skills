+
+type fakeGateway struct {
+	calls []string
+	fail  string
+}
+
+func (g *fakeGateway) Charge(_ context.Context, id string, _ int) error {
+	g.calls = append(g.calls, id)
+	if id == g.fail {
+		return errors.New("declined")
+	}
+	return nil
+}
+
+func TestSettleStopsOnMalformedRow(t *testing.T) {
+	var ledger bytes.Buffer
+	g := &fakeGateway{}
+	s := &billing.Service{Ledger: &ledger, Gateway: g}
+	err := settle(context.Background(), strings.NewReader("a,1\nbad\nc,3\n"), s)
+	if err == nil || !strings.Contains(err.Error(), "row 2") {
+		t.Fatalf("error: %v", err)
+	}
+	if ledger.String() != "a,1\n" || len(g.calls) != 1 || g.calls[0] != "a" {
+		t.Fatalf("ledger %q, calls %+v", ledger.String(), g.calls)
+	}
+}
+
+func TestSettleStopsOnChargeFailure(t *testing.T) {
+	var ledger bytes.Buffer
+	g := &fakeGateway{fail: "b"}
+	s := &billing.Service{Ledger: &ledger, Gateway: g}
+	err := settle(context.Background(), strings.NewReader("a,1\nb,2\nc,3\n"), s)
+	if err == nil || !strings.Contains(err.Error(), "row 2") {
+		t.Fatalf("error: %v", err)
+	}
+	if ledger.String() != "a,1\n" || strings.Join(g.calls, ",") != "a,b" {
+		t.Fatalf("ledger %q, calls %+v", ledger.String(), g.calls)
+	}
+}
+
+func TestRunUsesConfiguredLedgerAndGateway(t *testing.T) {
+	var requests []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error(err)
+		}
+		requests = append(requests, string(body))
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	dir := t.TempDir()
+	input := filepath.Join(dir, "input")
+	ledger := filepath.Join(dir, "ledger")
+	if err := os.WriteFile(input, []byte("a,1\nb,2\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("LEDGER", ledger)
+	t.Setenv("GATEWAY_URL", server.URL)
+	if err := run([]string{input}); err != nil {
+		t.Fatal(err)
+	}
+	got, err := os.ReadFile(ledger)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "a,1\nb,2\n" || strings.Join(requests, ";") != "a,1;b,2" {
+		t.Fatalf("ledger %q, requests %+v", got, requests)
+	}
+}
