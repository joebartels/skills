+		if err == nil {
+			return body, nil
+		}
+		lastErr = err
+		if stopErr := ctx.Err(); stopErr != nil {
+			return nil, errors.Join(err, stopErr, context.Cause(ctx))
+		}
+		if !retry || attempt+1 == attempts {
+			return nil, err
+		}
+		timer := time.NewTimer(retryBackoff)
