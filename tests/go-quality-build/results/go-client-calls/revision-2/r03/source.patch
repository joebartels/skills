+	ctx, cancel := context.WithTimeout(ctx, fetchBudget)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
 	req, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, boundError(err)
+	}
+	if c.breakers == nil {
+		data, _, err := c.fetch(req)
