+func TestCommitTotalBudgetIncludesNativeRetries(t *testing.T) {
+	var attempts atomic.Int32
+	deadlines := make(chan time.Time, 3)
+	finished := make(chan struct{}, 1)
+	conn := newConn(t, func(ctx context.Context, _ *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+		deadline, _ := ctx.Deadline()
+		deadlines <- deadline
+		if attempts.Add(1) == 1 {
+			grpc.SetTrailer(ctx, metadata.Pairs("grpc-retry-pushback-ms", "150"))
+			return nil, status.Error(codes.Unavailable, "retry before commitment")
+		}
+		<-ctx.Done()
+		finished <- struct{}{}
+		return nil, status.FromContextError(ctx.Err()).Err()
+	}, grpc.WithDefaultServiceConfig(retryConfig))
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	start := time.Now()
+	got, err := client.Commit(ctx, conn, "budget-id", nil)
+	elapsed := time.Since(start)
+	if got != nil || status.Code(err) != codes.DeadlineExceeded {
+		t.Fatalf("Commit = %q, %v; want nil, DeadlineExceeded", got, err)
+	}
+	if elapsed < 400*time.Millisecond || elapsed > 1200*time.Millisecond {
+		t.Errorf("elapsed = %v, want approximately 500ms", elapsed)
+	}
+	if attempts.Load() != 2 {
+		t.Fatalf("attempts = %d, want 2", attempts.Load())
+	}
+	first, second := <-deadlines, <-deadlines
+	for _, deadline := range []time.Time{first, second} {
+		if budget := deadline.Sub(start); budget < 400*time.Millisecond || budget > 600*time.Millisecond {
+			t.Errorf("server deadline budget = %v, want approximately 500ms", budget)
+		}
+	}
+	if delta := second.Sub(first); delta < -30*time.Millisecond || delta > 30*time.Millisecond {
+		t.Errorf("retry shifted total deadline by %v", delta)
+	}
+	select {
+	case <-finished:
+	case <-time.After(3 * time.Second):
+		t.Fatal("handler did not observe deadline")
+	}
+}
+
+func TestCommitEarlierDeadlineAndCancellation(t *testing.T) {
+	t.Run("earlier deadline", func(t *testing.T) {
+		observed := make(chan time.Time, 1)
+		finished := make(chan struct{}, 1)
+		conn := newConn(t, func(ctx context.Context, _ *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+			deadline, _ := ctx.Deadline()
+			observed <- deadline
+			<-ctx.Done()
+			finished <- struct{}{}
+			return nil, status.FromContextError(ctx.Err()).Err()
+		})
+		deadline := time.Now().Add(100 * time.Millisecond)
+		ctx, cancel := context.WithDeadline(context.Background(), deadline)
+		defer cancel()
+		got, err := client.Commit(ctx, conn, "deadline-id", nil)
+		if got != nil || status.Code(err) != codes.DeadlineExceeded {
+			t.Fatalf("Commit = %q, %v; want nil, DeadlineExceeded", got, err)
+		}
+		select {
+		case actual := <-observed:
+			if delta := actual.Sub(deadline); delta < -30*time.Millisecond || delta > 30*time.Millisecond {
+				t.Errorf("server deadline differs from caller by %v", delta)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("handler did not start")
+		}
+		select {
+		case <-finished:
+		case <-time.After(3 * time.Second):
+			t.Fatal("handler did not observe deadline")
+		}
+	})
+	t.Run("in-flight cancellation", func(t *testing.T) {
+		started, finished := make(chan struct{}), make(chan struct{})
+		conn := newConn(t, func(ctx context.Context, _ *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+			close(started)
+			<-ctx.Done()
+			close(finished)
+			return nil, status.FromContextError(ctx.Err()).Err()
+		})
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		done := make(chan struct{})
+		var commitErr error
+		go func() {
+			_, commitErr = client.Commit(ctx, conn, "cancel-id", nil)
+			close(done)
+		}()
+		t.Cleanup(func() {
+			cancel()
+			select {
+			case <-done:
+			case <-time.After(3 * time.Second):
+				t.Error("Commit did not finish")
+			}
+		})
+		select {
+		case <-started:
+		case <-done:
+			t.Fatalf("Commit finished before handler started: %v", commitErr)
+		case <-time.After(3 * time.Second):
+			t.Fatal("handler did not start")
+		}
+		cancel()
+		select {
+		case <-done:
+			if status.Code(commitErr) != codes.Canceled {
+				t.Errorf("code = %v, want Canceled: %v", status.Code(commitErr), commitErr)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("Commit did not return after cancellation")
+		}
+		select {
+		case <-finished:
+		case <-time.After(3 * time.Second):
+			t.Fatal("handler did not observe cancellation")
+		}
+	})
+}
