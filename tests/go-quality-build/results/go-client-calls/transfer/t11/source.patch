+package client_test
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"reflect"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	client "example.invalid/grpc-transfer"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	pb "google.golang.org/grpc/interop/grpc_testing"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+	"google.golang.org/grpc/test/bufconn"
+)
+
+var _ func(context.Context, *grpc.ClientConn, string, []byte) ([]byte, error) = client.Commit
+
+const retryConfig = `{"methodConfig":[{"name":[{"service":"grpc.testing.TestService","method":"UnaryCall"}],"retryPolicy":{"maxAttempts":3,"initialBackoff":"0.001s","maxBackoff":"0.001s","backoffMultiplier":1,"retryableStatusCodes":["UNAVAILABLE"]}}]}`
+
+type unaryServer struct {
+	pb.UnimplementedTestServiceServer
+	call func(context.Context, *pb.SimpleRequest) (*pb.SimpleResponse, error)
+}
+
+func (s unaryServer) UnaryCall(ctx context.Context, req *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+	return s.call(ctx, req)
+}
+
+func newConn(t *testing.T, call func(context.Context, *pb.SimpleRequest) (*pb.SimpleResponse, error), opts ...grpc.DialOption) *grpc.ClientConn {
+	t.Helper()
+	listener := bufconn.Listen(1 << 20)
+	t.Cleanup(func() { listener.Close() })
+	server := grpc.NewServer()
+	pb.RegisterTestServiceServer(server, unaryServer{call: call})
+	served := make(chan error, 1)
+	go func() { served <- server.Serve(listener) }()
+	t.Cleanup(func() {
+		server.Stop()
+		select {
+		case err := <-served:
+			if err != nil && err != grpc.ErrServerStopped {
+				t.Errorf("serve: %v", err)
+			}
+		case <-time.After(3 * time.Second):
+			t.Error("server did not stop")
+		}
+	})
+	opts = append([]grpc.DialOption{
+		grpc.WithTransportCredentials(insecure.NewCredentials()),
+		grpc.WithContextDialer(func(ctx context.Context, _ string) (net.Conn, error) {
+			return listener.DialContext(ctx)
+		}),
+		grpc.WithBlock(),
+	}, opts...)
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	conn, err := grpc.DialContext(ctx, "passthrough:///local", opts...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	return conn
+}
+
+type requestObservation struct {
+	md   metadata.MD
+	body []byte
+}
+
+func observeRequest(ctx context.Context, req *pb.SimpleRequest) requestObservation {
+	md, _ := metadata.FromIncomingContext(ctx)
+	return requestObservation{md: md, body: bytes.Clone(req.GetPayload().GetBody())}
+}
+
+func checkRequest(t *testing.T, observed requestObservation, identity string, payload []byte) {
+	t.Helper()
+	if got := observed.md.Get("operation-id"); !reflect.DeepEqual(got, []string{identity}) {
+		t.Errorf("operation-id = %q, want [%q]", got, identity)
+	}
+	if !bytes.Equal(observed.body, payload) {
+		t.Errorf("request body = %v, want %v", observed.body, payload)
+	}
+}
+
+func TestCommitPayloadMetadataAndBorrowedConnection(t *testing.T) {
+	observed := make(chan requestObservation, 2)
+	result := []byte{9, 0, 8}
+	conn := newConn(t, func(ctx context.Context, req *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+		observed <- observeRequest(ctx, req)
+		return &pb.SimpleResponse{Payload: &pb.Payload{Body: result}}, nil
+	})
+	ctx := metadata.NewOutgoingContext(context.Background(), metadata.Pairs("operation-id", "stale", "trace-id", "base"))
+	ctx = metadata.AppendToOutgoingContext(ctx, "trace-id", "appended")
+	before, _ := metadata.FromOutgoingContext(ctx)
+	payload := []byte{0, 1, 255}
+	for _, identity := range []string{"op-1", "op-2"} {
+		got, err := client.Commit(ctx, conn, identity, payload)
+		if err != nil || !bytes.Equal(got, result) {
+			t.Fatalf("Commit = %v, %v; want %v, nil", got, err, result)
+		}
+		request := <-observed
+		checkRequest(t, request, identity, payload)
+		if got := request.md.Get("trace-id"); !reflect.DeepEqual(got, []string{"base", "appended"}) {
+			t.Errorf("trace-id = %q, want [base appended]", got)
+		}
+	}
+	after, _ := metadata.FromOutgoingContext(ctx)
+	if !reflect.DeepEqual(after, before) {
+		t.Errorf("caller metadata changed: got %v, want %v", after, before)
+	}
+}
+
+func TestCommitRejectsEmptyIdentityBeforeCalling(t *testing.T) {
+	got, err := client.Commit(context.Background(), nil, "", []byte("payload"))
+	if got != nil || status.Code(err) != codes.InvalidArgument {
+		t.Fatalf("Commit = %v, %v; want nil, InvalidArgument", got, err)
+	}
+}
+
+func TestCommitConnectionRetryPolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		opts     []grpc.DialOption
+		code     codes.Code
+		attempts int32
+		wantCode codes.Code
+	}{
+		{"no configured retry", nil, codes.Unavailable, 1, codes.Unavailable},
+		{"configured retry", []grpc.DialOption{grpc.WithDefaultServiceConfig(retryConfig)}, codes.Unavailable, 2, codes.OK},
+		{"disabled retry", []grpc.DialOption{grpc.WithDefaultServiceConfig(retryConfig), grpc.WithDisableRetry()}, codes.Unavailable, 1, codes.Unavailable},
+		{"nonretryable status", []grpc.DialOption{grpc.WithDefaultServiceConfig(retryConfig)}, codes.PermissionDenied, 1, codes.PermissionDenied},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var attempts, invocations atomic.Int32
+			observed := make(chan requestObservation, 3)
+			result := []byte("stored result")
+			opts := append(tc.opts, grpc.WithUnaryInterceptor(func(ctx context.Context, method string, req, reply any, cc *grpc.ClientConn, invoke grpc.UnaryInvoker, options ...grpc.CallOption) error {
+				invocations.Add(1)
+				return invoke(ctx, method, req, reply, cc, options...)
+			}))
+			conn := newConn(t, func(ctx context.Context, req *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+				observed <- observeRequest(ctx, req)
+				if attempts.Add(1) == 1 {
+					return nil, status.Error(tc.code, "acknowledgement lost")
+				}
+				return &pb.SimpleResponse{Payload: &pb.Payload{Body: result}}, nil
+			}, opts...)
+			payload := []byte("request")
+			got, err := client.Commit(context.Background(), conn, "stable-id", payload)
+			if status.Code(err) != tc.wantCode {
+				t.Fatalf("code = %v, want %v: %v", status.Code(err), tc.wantCode, err)
+			}
+			if tc.wantCode == codes.OK && !bytes.Equal(got, result) {
+				t.Errorf("result = %q, want %q", got, result)
+			}
+			if tc.wantCode != codes.OK && got != nil {
+				t.Errorf("failed result = %q, want nil", got)
+			}
+			if got := attempts.Load(); got != tc.attempts {
+				t.Errorf("server attempts = %d, want %d", got, tc.attempts)
+			}
+			if got := invocations.Load(); got != 1 {
+				t.Errorf("application invocations = %d, want 1", got)
+			}
+			for range tc.attempts {
+				checkRequest(t, <-observed, "stable-id", payload)
+			}
+		})
+	}
+}
+
+func TestCommitHeadersStopReplayAndCallerCanRepeat(t *testing.T) {
+	var attempts, effects, invocations atomic.Int32
+	observed := make(chan requestObservation, 3)
+	result := []byte("effect result")
+	conn := newConn(t, func(ctx context.Context, req *pb.SimpleRequest) (*pb.SimpleResponse, error) {
+		observed <- observeRequest(ctx, req)
+		if attempts.Add(1) == 1 {
+			effects.Add(1)
+			if err := grpc.SendHeader(ctx, metadata.Pairs("effect", "accepted")); err != nil {
+				return nil, err
+			}
+			return nil, status.Error(codes.Unavailable, "acknowledgement lost after effect")
+		}
+		return &pb.SimpleResponse{Payload: &pb.Payload{Body: result}}, nil
+	}, grpc.WithDefaultServiceConfig(retryConfig), grpc.WithUnaryInterceptor(func(ctx context.Context, method string, req, reply any, cc *grpc.ClientConn, invoke grpc.UnaryInvoker, options ...grpc.CallOption) error {
+		invocations.Add(1)
+		return invoke(ctx, method, req, reply, cc, options...)
+	}))
+	payload := []byte("request")
+	got, err := client.Commit(context.Background(), conn, "repeat-id", payload)
+	if got != nil || status.Code(err) != codes.Unavailable {
+		t.Fatalf("first Commit = %q, %v; want nil, Unavailable", got, err)
+	}
+	if attempts.Load() != 1 || effects.Load() != 1 || invocations.Load() != 1 {
+		t.Fatalf("after failed acknowledgement: attempts=%d effects=%d invocations=%d, want 1 each", attempts.Load(), effects.Load(), invocations.Load())
+	}
+	checkRequest(t, <-observed, "repeat-id", payload)
+	got, err = client.Commit(context.Background(), conn, "repeat-id", payload)
+	if err != nil || !bytes.Equal(got, result) {
+		t.Fatalf("second Commit = %q, %v; want %q, nil", got, err, result)
+	}
+	checkRequest(t, <-observed, "repeat-id", payload)
+	if attempts.Load() != 2 || effects.Load() != 1 || invocations.Load() != 2 {
+		t.Errorf("after caller repeat: attempts=%d effects=%d invocations=%d; want 2, 1, 2", attempts.Load(), effects.Load(), invocations.Load())
+	}
+}
