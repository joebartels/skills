+type statusTransport struct {
+	base   http.RoundTripper
+	status int
+}
+
+func (t *statusTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	resp, err := t.base.RoundTrip(req)
+	if err == nil && resp != nil {
+		t.status = resp.StatusCode
