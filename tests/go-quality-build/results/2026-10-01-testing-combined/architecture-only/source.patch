+		{"watch"}, {"watch", "--url", "ftp://host/x", "--file", "x", "--interval", "1s"},
+		{"watch", "--url", "http:///missing-host", "--file", "x", "--interval", "1s"},
+		{"watch", "--url", "http://:80", "--file", "x", "--interval", "1s"},
