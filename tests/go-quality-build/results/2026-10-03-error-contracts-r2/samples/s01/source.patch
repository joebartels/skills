+
+type readFailure []string
+
+func (e readFailure) Error() string { return strings.Join(e, ": ") }
+
+type failingReader struct {
+	data              string
+	readErr, finalErr error
+	closed            bool
+}
+
+func (r *failingReader) Read(p []byte) (int, error) {
+	if r.data == "" {
+		return 0, r.finalErr
+	}
+	n := copy(p, r.data)
+	r.data = r.data[n:]
+	if r.data == "" {
+		return n, r.readErr
+	}
+	return n, nil
+}
+
+func (r *failingReader) Close() error {
+	r.closed = true
+	return nil
+}
