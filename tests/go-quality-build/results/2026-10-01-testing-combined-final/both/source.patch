+func TestRefreshRejectsRedirectWithoutChangingClient(t *testing.T) {
+	t.Parallel()
+	var requests, policyCalls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
