+				if err := os.WriteFile(filepath.Join(target, "prior"), []byte("directory bytes"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			var reader io.Reader = strings.NewReader("[]")
+			if stage == "read" {
+				reader = &failingReader{strings.NewReader("[]"), readErr}
