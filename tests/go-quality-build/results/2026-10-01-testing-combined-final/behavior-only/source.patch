+					t.Errorf("request = %#v", r)
+				}
+				return &http.Response{StatusCode: 200, Body: body, Header: make(http.Header)}, nil
+			})}
+			if err := indexer.Refresh(ctx, client, "https://records.test/data", path); err != nil {
+				t.Fatal(err)
