+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls, releases := 0, 0
+			err := indexer.Serve(ctx, time.Hour, func(got context.Context) error {
