+		calls, releases := 0, 0
+		err := indexer.Serve(context.Background(), interval, func(context.Context) error { calls++; return nil }, func() error { releases++; return nil })
+		if !errors.Is(err, indexer.ErrInvalidInterval) || calls != 0 || releases != 0 {
