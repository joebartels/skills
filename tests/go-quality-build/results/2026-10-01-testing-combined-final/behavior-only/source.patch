+		calls, releases := 0, 0
+		err := indexer.Serve(ctx, time.Millisecond, func(context.Context) error { calls++; return nil }, func() error { releases++; return releaseErr })
+		if calls != 0 || releases != 1 {
+			t.Fatalf("calls %d, releases %d", calls, releases)
