+func TestParse(t *testing.T) {
+	var parse func(string) (int, error) = Parse
+	tests := []struct {
+		input string
+		want  int
+		bad   bool
+	}{
+		{input: "0", want: 0},
+		{input: "00080", want: 80},
+		{input: "8080", want: 8080},
+		{input: "65535", want: 65535},
+		{input: "", bad: true},
+		{input: "+80", bad: true},
+		{input: "-0", bad: true},
+		{input: " 80", bad: true},
+		{input: "80 ", bad: true},
+		{input: "8x", bad: true},
+		{input: "65536", bad: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			got, err := parse(tt.input)
+			if tt.bad {
+				if err == nil || got != 0 {
+					t.Fatalf("Parse(%q) = (%d, %v), want (0, error)", tt.input, got, err)
+				}
+				return
+			}
+			if err != nil || got != tt.want {
+				t.Fatalf("Parse(%q) = (%d, %v), want (%d, nil)", tt.input, got, err, tt.want)
+			}
+		})
 	}
 }
