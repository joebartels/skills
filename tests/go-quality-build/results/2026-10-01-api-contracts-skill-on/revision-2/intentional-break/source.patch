+func TestRun(t *testing.T) {
+	tests := []struct {
+		name     string
+		args     []string
+		wantCode int
+		wantOut  string
+		wantErr  string
+	}{
+		{name: "success", args: []string{"080"}, wantOut: "80\n"},
+		{name: "invalid", args: []string{"+80"}, wantCode: 2, wantErr: "invalid port \"+80\"\n"},
+		{name: "wrong argument count", wantCode: 2, wantErr: "usage: portcheck PORT\n"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var stdout, stderr bytes.Buffer
+			if got := run(tt.args, &stdout, &stderr); got != tt.wantCode {
+				t.Fatalf("run exit = %d, want %d", got, tt.wantCode)
+			}
+			if stdout.String() != tt.wantOut || stderr.String() != tt.wantErr {
+				t.Fatalf("run output = stdout %q, stderr %q; want stdout %q, stderr %q", stdout.String(), stderr.String(), tt.wantOut, tt.wantErr)
+			}
+		})
+	}
+}
