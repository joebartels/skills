 // Package portnum parses numeric port settings.
 package portnum
 
-import "strconv"
+import (
+	"errors"
+	"strconv"
+)
 
-// Parse returns the port, or zero when text is invalid.
-func Parse(text string) int {
+var errInvalidPort = errors.New("invalid port")
+
+// Parse returns a port in the range 0..65535. Input must contain one or more
+// ASCII decimal digits. Leading zeros are accepted. On failure, Parse returns
+// zero and an error.
+func Parse(text string) (int, error) {
+	if len(text) == 0 {
+		return 0, errInvalidPort
+	}
+	for i := 0; i < len(text); i++ {
+		if text[i] < '0' || text[i] > '9' {
+			return 0, errInvalidPort
+		}
+	}
 	n, err := strconv.Atoi(text)
-	if err != nil || n < 0 || n > 65535 {
-		return 0
+	if err != nil || n > 65535 {
+		return 0, errInvalidPort
 	}
-	return n
+	return n, nil
 }
