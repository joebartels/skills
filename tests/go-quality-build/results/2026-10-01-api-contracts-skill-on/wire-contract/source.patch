+func TestListFiltersByExactState(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "jobs.json")
+	input := `[{"id":"first","state":"ready"},{"id":"second","state":"ready-ish"},{"id":"third","state":""}]`
+	if err := os.WriteFile(path, []byte(input), 0600); err != nil {
+		t.Fatal(err)
+	}
+
+	tests := []struct {
+		name string
+		args []string
+		want string
+	}{
+		{
+			name: "flag omitted lists all",
+			args: []string{path},
+			want: `{"jobs":[{"id":"first","state":"ready"},{"id":"second","state":"ready-ish"},{"id":"third","state":""}]}` + "\n",
+		},
+		{
+			name: "exact nonempty state",
+			args: []string{"--state", "ready", path},
+			want: `{"jobs":[{"id":"first","state":"ready"}]}` + "\n",
+		},
+		{
+			name: "explicit empty state",
+			args: []string{"--state", "", path},
+			want: `{"jobs":[{"id":"third","state":""}]}` + "\n",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, diag bytes.Buffer
+			if code := run(tt.args, &out, &diag); code != 0 {
+				t.Fatalf("exit %d: %s", code, &diag)
+			}
+			if got := out.String(); got != tt.want {
+				t.Fatalf("output = %q, want %q", got, tt.want)
+			}
+			if diag.Len() != 0 {
+				t.Fatalf("unexpected diagnostic: %s", &diag)
+			}
+		})
+	}
+}
