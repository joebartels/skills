+func TestStateFilter(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "jobs.json")
+	if err := os.WriteFile(path, []byte(`[{"id":"a","state":"ready"},{"id":"b","state":"done"},{"id":"c","state":""}]`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	tests := []struct {
+		name string
+		args []string
+		want string
+	}{
+		{name: "flag before file", args: []string{"--state", "ready", path}, want: `{"jobs":[{"id":"a","state":"ready"}]}` + "\n"},
+		{name: "flag after file", args: []string{path, "--state=done"}, want: `{"jobs":[{"id":"b","state":"done"}]}` + "\n"},
+		{name: "explicit empty", args: []string{"--state=", path}, want: `{"jobs":[{"id":"c","state":""}]}` + "\n"},
+		{name: "unmatched returns null jobs", args: []string{"--state", "missing", path}, want: "{\"jobs\":null}\n"},
+		{name: "omitted lists all", args: []string{path}, want: `{"jobs":[{"id":"a","state":"ready"},{"id":"b","state":"done"},{"id":"c","state":""}]}` + "\n"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var out, diag bytes.Buffer
+			if code := run(tt.args, &out, &diag); code != 0 {
+				t.Fatalf("exit %d: %s", code, &diag)
+			}
+			if got := out.String(); got != tt.want {
+				t.Fatalf("output = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestInvalidStateFlagUsage(t *testing.T) {
+	for _, args := range [][]string{{"--state"}, {"--state", "ready", "--state=done", "jobs.json"}} {
+		var out, diag bytes.Buffer
+		if code := run(args, &out, &diag); code != 2 {
+			t.Fatalf("run(%q) exit = %d, want 2", args, code)
+		}
+		if out.Len() != 0 || diag.Len() == 0 {
+			t.Fatalf("run(%q) stdout=%q stderr=%q", args, out.String(), diag.String())
+		}
+	}
+}
