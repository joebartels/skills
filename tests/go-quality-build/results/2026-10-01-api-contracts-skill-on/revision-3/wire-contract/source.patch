+func parseArgs(args []string) (path, state string, filterState, ok bool) {
+	// Preserve the old one-argument form, including file names that look like flags.
+	if len(args) == 1 {
+		return args[0], "", false, true
+	}
+	var positional []string
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		switch {
+		case arg == "--":
+			positional = append(positional, args[i+1:]...)
+			return onePath(positional, state, filterState)
+		case arg == "--state":
+			if filterState || i+1 == len(args) {
+				return "", "", false, false
+			}
+			filterState = true
+			i++
+			state = args[i]
+		case len(arg) >= len("--state=") && arg[:len("--state=")] == "--state=":
+			if filterState {
+				return "", "", false, false
+			}
+			filterState = true
+			state = arg[len("--state="):]
+		default:
+			positional = append(positional, arg)
+		}
+	}
+	return onePath(positional, state, filterState)
+}
+
+func onePath(positional []string, state string, filterState bool) (string, string, bool, bool) {
+	if len(positional) != 1 {
+		return "", "", false, false
+	}
+	return positional[0], state, filterState, true
+}
+
 func main() { os.Exit(run(os.Args[1:], os.Stdout, os.Stderr)) }
