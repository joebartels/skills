-		t.Fatalf("Parse = %d", got)
+var _ func(string) (int, error) = Parse
+
+func TestParseAcceptedValues(t *testing.T) {
+	for _, tc := range []struct {
+		text string
+		want int
+	}{
+		{text: "0", want: 0},
+		{text: "00000", want: 0},
+		{text: "00080", want: 80},
+		{text: "8080", want: 8080},
+		{text: "65535", want: 65535},
+	} {
+		t.Run(tc.text, func(t *testing.T) {
+			got, err := Parse(tc.text)
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v", tc.text, err)
+			}
+			if got != tc.want {
+				t.Fatalf("Parse(%q) = %d, want %d", tc.text, got, tc.want)
+			}
+		})
 	}
 }
+
+func TestParseRejectsInvalidValues(t *testing.T) {
+	for _, text := range []string{"", "+80", "-1", " 80", "80 ", "1.0", "８０", "65536", "999999999999999999999999999999999999999"} {
+		t.Run(text, func(t *testing.T) {
+			got, err := Parse(text)
+			if err == nil {
+				t.Fatalf("Parse(%q) error = nil", text)
+			}
+			if got != 0 {
+				t.Fatalf("Parse(%q) = %d, want 0 on error", text, got)
+			}
+		})
+	}
+}
