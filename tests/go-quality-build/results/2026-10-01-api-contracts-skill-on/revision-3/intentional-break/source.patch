 // Package portnum parses numeric port settings.
 package portnum
 
-import "strconv"
+import "errors"
 
-// Parse returns the port, or zero when text is invalid.
-func Parse(text string) int {
-	n, err := strconv.Atoi(text)
-	if err != nil || n < 0 || n > 65535 {
-		return 0
+var errInvalidPort = errors.New("port must be an ASCII decimal integer in range 0..65535")
+
+// Parse returns the port represented by text. Text must contain one or more
+// ASCII decimal digits and represent a value in the range 0..65535. Leading
+// zeros are accepted. If parsing fails, Parse returns zero and a non-nil error.
+func Parse(text string) (int, error) {
+	if text == "" {
+		return 0, errInvalidPort
 	}
-	return n
+
+	port := 0
+	for i := 0; i < len(text); i++ {
+		c := text[i]
+		if c < '0' || c > '9' {
+			return 0, errInvalidPort
+		}
+		digit := int(c - '0')
+		if port > (65535-digit)/10 {
+			return 0, errInvalidPort
+		}
+		port = port*10 + digit
+	}
+	return port, nil
 }
