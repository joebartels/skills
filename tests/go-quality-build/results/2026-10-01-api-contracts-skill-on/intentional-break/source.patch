-		return 0
+// Parse parses one or more ASCII decimal digits as a port in the range 0..65535.
+// Leading zeros are accepted. On failure, Parse returns zero and a non-nil error.
+func Parse(text string) (int, error) {
+	if text == "" {
+		return 0, errors.New("port must contain decimal digits")
 	}
-	return n
+	for _, b := range []byte(text) {
+		if b < '0' || b > '9' {
+			return 0, errors.New("port must contain only ASCII decimal digits")
+		}
+	}
+
+	n, err := strconv.ParseUint(text, 10, 16)
+	if err != nil {
+		return 0, errors.New("port must be in the range 0..65535")
+	}
+	return int(n), nil
 }
