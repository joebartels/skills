+func TestParseValidDecimal(t *testing.T) {
+	for _, tc := range []struct {
+		input string
+		want  int
+	}{
+		{input: "0", want: 0},
+		{input: "00080", want: 80},
+		{input: "8080", want: 8080},
+		{input: "65535", want: 65535},
+	} {
+		t.Run(tc.input, func(t *testing.T) {
+			got, err := Parse(tc.input)
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v", tc.input, err)
+			}
+			if got != tc.want {
+				t.Fatalf("Parse(%q) = %d, want %d", tc.input, got, tc.want)
+			}
+		})
 	}
 }
+
+func TestParseInvalidInput(t *testing.T) {
+	for _, input := range []string{"", "+80", "-1", " 80", "80 ", "8.0", "８０", "65536", "999999999999999999999999999999"} {
+		t.Run(input, func(t *testing.T) {
+			got, err := Parse(input)
+			if err == nil {
+				t.Fatalf("Parse(%q) error = nil", input)
+			}
+			if got != 0 {
+				t.Fatalf("Parse(%q) = %d, want zero on failure", input, got)
+			}
+		})
+	}
