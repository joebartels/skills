+func TestStateFilterIsExact(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "jobs.json")
+	if err := os.WriteFile(path, []byte(`[{"id":"a","state":"Ready"},{"id":"b","state":"ready"},{"id":"c","state":"ready-now"}]`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var out, diag bytes.Buffer
+	if code := run([]string{"--state", "ready", path}, &out, &diag); code != 0 {
+		t.Fatalf("exit %d: %s", code, &diag)
+	}
+	if got, want := out.String(), "{\"jobs\":[{\"id\":\"b\",\"state\":\"ready\"}]}\n"; got != want {
+		t.Fatalf("output = %q, want %q", got, want)
+	}
+}
+
+func TestExplicitEmptyStateFilter(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "jobs.json")
+	if err := os.WriteFile(path, []byte(`[{"id":"a","state":""},{"id":"b","state":"ready"}]`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var out, diag bytes.Buffer
+	if code := run([]string{"--state", "", path}, &out, &diag); code != 0 {
+		t.Fatalf("exit %d: %s", code, &diag)
+	}
+	if got, want := out.String(), "{\"jobs\":[{\"id\":\"a\",\"state\":\"\"}]}\n"; got != want {
+		t.Fatalf("output = %q, want %q", got, want)
+	}
+}
