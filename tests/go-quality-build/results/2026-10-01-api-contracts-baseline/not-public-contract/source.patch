+++ b/internal/cache/expiry_test.go
@@ -3,6 +3,9 @@
 import "testing"
 
 func TestExpired(t *testing.T) {
+	if !expired(10, 10) {
+		t.Fatal("entry is live at its deadline")
+	}
 	if !expired(12, 10) {
 		t.Fatal("past deadline is live")
 	}
