--- a/format.go
+++ b/format.go
@@ -1,11 +1,23 @@
 // Package recordfmt formats records for text reports.
 package recordfmt
 
-// Formatter formats key/value records with a prefix.
-type Formatter struct{ prefix string }
+// Formatter formats key/value records with a prefix and separator.
+type Formatter struct {
+	prefix    string
+	separator string
+}
 
 // New creates a formatter with the supplied prefix.
-func New(prefix string) *Formatter { return &Formatter{prefix: prefix} }
+// Records use ":" between the key and value.
+func New(prefix string) *Formatter { return NewWithSeparator(prefix, ":") }
+
+// NewWithSeparator creates a formatter with the supplied prefix and key/value
+// separator. The separator may be empty.
+func NewWithSeparator(prefix, separator string) *Formatter {
+	return &Formatter{prefix: prefix, separator: separator}
+}
 
 // Format returns one record without a trailing newline.
-func (f *Formatter) Format(key, value string) string { return f.prefix + key + ":" + value }
+func (f *Formatter) Format(key, value string) string {
+	return f.prefix + key + f.separator + value
+}
