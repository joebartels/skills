 // Package portnum parses numeric port settings.
 package portnum
 
-import "strconv"
+import "errors"
 
-// Parse returns the port, or zero when text is invalid.
-func Parse(text string) int {
-	n, err := strconv.Atoi(text)
-	if err != nil || n < 0 || n > 65535 {
-		return 0
+// ErrInvalidPort is returned when text is not an ASCII decimal port in range.
+var ErrInvalidPort = errors.New("invalid port")
+
+// Parse parses one or more ASCII decimal digits as a port in the range 0..65535.
+// Leading zeros are accepted. On failure it returns zero and a non-nil error.
+func Parse(text string) (int, error) {
+	if len(text) == 0 {
+		return 0, ErrInvalidPort
 	}
-	return n
+
+	n := 0
+	for i := 0; i < len(text); i++ {
+		c := text[i]
+		if c < '0' || c > '9' {
+			return 0, ErrInvalidPort
+		}
+		digit := int(c - '0')
+		if n > (65535-digit)/10 {
+			return 0, ErrInvalidPort
+		}
+		n = n*10 + digit
+	}
+	return n, nil
 }
