+func TestParse(t *testing.T) {
+	tests := []struct {
+		input string
+		want  int
+	}{
+		{input: "0", want: 0},
+		{input: "00080", want: 80},
+		{input: "65535", want: 65535},
+	}
+	for _, tt := range tests {
+		t.Run(tt.input, func(t *testing.T) {
+			got, err := Parse(tt.input)
+			if err != nil {
+				t.Fatalf("Parse(%q) error = %v", tt.input, err)
+			}
+			if got != tt.want {
+				t.Fatalf("Parse(%q) = %d, want %d", tt.input, got, tt.want)
+			}
+		})
 	}
 }
+
+func TestParseRejectsInvalidInput(t *testing.T) {
+	for _, input := range []string{"", "-1", "+1", " 1", "1 ", "1x", "65536", "999999999999999999999999999999999999999999999999999999999"} {
+		t.Run(input, func(t *testing.T) {
+			got, err := Parse(input)
+			if !errors.Is(err, ErrInvalidPort) {
+				t.Fatalf("Parse(%q) error = %v, want ErrInvalidPort", input, err)
+			}
+			if got != 0 {
+				t.Fatalf("Parse(%q) = %d, want 0 on error", input, got)
+			}
+		})
