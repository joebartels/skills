+func TestCompletionRelativeRecurrence(t *testing.T) {
+	t.Parallel()
+	const interval = 30 * time.Millisecond
+	ctx, cancel := context.WithCancel(context.Background())
+	started := make(chan cycleEvent, 4)
+	completed := make(chan cycleEvent, 4)
+	firstRelease := make(chan struct{})
+	secondRelease := make(chan struct{})
+	var calls, active atomic.Int32
+	want := errors.New("three cycles complete")
+	run := startPoll(t, ctx, cancel, interval, func(callbackCtx context.Context) error {
+		cycle := calls.Add(1)
+		concurrent := active.Add(1) != 1
+		defer func() {
+			active.Add(-1)
+			// This final event precedes actual return, conservatively checking
+			// the minimum interval. A release gate is not completion.
+			completed <- cycleEvent{cycle: cycle, at: time.Now()}
+		}()
+		started <- cycleEvent{cycle: cycle, at: time.Now()}
+		if concurrent {
+			return errors.New("overlapping callbacks")
+		}
+		var release <-chan struct{}
+		switch cycle {
+		case 1:
+			release = firstRelease
+		case 2:
+			release = secondRelease
+		default:
+			return want
+		}
+		select {
+		case <-release:
+		case <-callbackCtx.Done():
+		}
+		return nil
+	})
+
+	first := nextCycle(t, started, "first callback start")
+	if first.cycle != 1 {
+		t.Fatalf("first cycle = %d, want 1", first.cycle)
+	}
+	// Readiness is observed before holding this callback beyond one interval.
+	hold := time.NewTimer(2 * interval)
+	t.Cleanup(func() { hold.Stop() })
+	select {
+	case event := <-started:
+		t.Fatalf("cycle %d started while the first callback was blocked", event.cycle)
+	case <-hold.C:
+	}
+	close(firstRelease)
+	firstDone := nextCycle(t, completed, "first callback completion")
+	second := nextCycle(t, started, "second callback start")
+	if firstDone.cycle != 1 || second.cycle != 2 {
+		t.Fatalf("completion/start cycles = %d/%d, want 1/2", firstDone.cycle, second.cycle)
+	}
+	if elapsed := second.at.Sub(firstDone.at); elapsed < interval {
+		t.Fatalf("second callback started %v after completion, want at least %v", elapsed, interval)
+	}
+	close(secondRelease)
+	secondDone := nextCycle(t, completed, "second callback completion")
+	third := nextCycle(t, started, "third callback start")
+	if secondDone.cycle != 2 || third.cycle != 3 {
+		t.Fatalf("completion/start cycles = %d/%d, want 2/3", secondDone.cycle, third.cycle)
+	}
+	if elapsed := third.at.Sub(secondDone.at); elapsed < interval {
+		t.Fatalf("third callback started %v after completion, want at least %v", elapsed, interval)
+	}
+	if err := run.wait(t); err != want {
+		t.Fatalf("Poll = %v, want %v", err, want)
+	}
+	if got := calls.Load(); got != 3 {
+		t.Fatalf("callback calls = %d, want 3", got)
+	}
+}
