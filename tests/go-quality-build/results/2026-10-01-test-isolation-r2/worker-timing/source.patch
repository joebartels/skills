+func TestInvalidInterval(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name     string
+		interval time.Duration
+	}{
+		{name: "zero", interval: 0},
+		{name: "negative", interval: -time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			ctx, cancel := context.WithCancel(context.Background())
+			var calls atomic.Int32
+			run := startPoll(t, ctx, cancel, tc.interval, func(context.Context) error {
+				calls.Add(1)
+				return errors.New("unexpected callback")
+			})
+			if err := run.wait(t); err == nil {
+				t.Fatal("Poll accepted a nonpositive interval")
+			}
+			if got := calls.Load(); got != 0 {
+				t.Fatalf("callback calls = %d, want 0", got)
+			}
+		})
+	}
+}
