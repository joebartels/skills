+func TestFixtureCleanupOnReturn(t *testing.T) {
+	t.Parallel()
+	var fixture *os.File
+	var path string
+	var callbackErr error
+	cleanupFinished := make(chan struct{})
+	if !t.Run("owned", func(t *testing.T) {
+		var err error
+		fixture, err = os.CreateTemp(t.TempDir(), "cleanup-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		path = fixture.Name()
+		var run *pollRun
+		t.Cleanup(func() {
+			if run != nil {
+				select {
+				case <-run.finished:
+				default:
+					t.Error("Poll still running; fixture cannot safely close")
+					return
+				}
+			}
+			if err := fixture.Close(); err != nil {
+				t.Errorf("close fixture: %v", err)
+			}
+		})
+		ctx, cancel := context.WithCancel(context.Background())
+		started := make(chan struct{})
+		run = startPoll(t, ctx, cancel, time.Hour, func(context.Context) error {
+			close(started)
+			<-ctx.Done()
+			_, callbackErr = fixture.WriteString("teardown used the open fixture\n")
+			close(cleanupFinished)
+			return callbackErr
+		})
+		waitEvent(t, started, "callback borrowing fixture")
+		// Return with the callback active. Cleanup itself must cancel and join
+		// it before closing the file or removing its directory.
+	}) {
+		return
+	}
+	waitEvent(t, cleanupFinished, "callback cleanup during subtest teardown")
+	if callbackErr != nil {
+		t.Fatalf("callback cleanup could not use its fixture: %v", callbackErr)
+	}
+	if _, err := fixture.Stat(); !errors.Is(err, os.ErrClosed) {
+		t.Fatalf("fixture after teardown = %v, want closed", err)
+	}
+	if _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("fixture path after teardown = %v, want removed", err)
+	}
+}
