+// Bounds diagnose stalled work; callback events establish readiness.
+const waitLimit = 5 * time.Second
+
+type pollRun struct {
+	finished chan struct{}
+	err      error // Read only after finished closes.
+}
+
+func startPoll(t *testing.T, ctx context.Context, cancel context.CancelFunc, interval time.Duration, callback func(context.Context) error) *pollRun {
+	t.Helper()
+	run := &pollRun{finished: make(chan struct{})}
+	// Own cancellation and joining before starting work or making assertions.
+	t.Cleanup(func() {
+		cancel()
+		timer := time.NewTimer(waitLimit)
+		defer timer.Stop()
+		select {
+		case <-run.finished:
+		case <-timer.C:
+			t.Error("Poll did not finish during cleanup")
+		}
+	})
+	go func() {
+		run.err = poller.Poll(ctx, interval, callback)
+		close(run.finished)
+	}()
+	return run
+}
+
+func (run *pollRun) wait(t *testing.T) error {
+	t.Helper()
+	waitEvent(t, run.finished, "Poll completion")
+	return run.err
+}
+
+func waitEvent(t *testing.T, event <-chan struct{}, name string) {
+	t.Helper()
+	timer := time.NewTimer(waitLimit)
+	defer timer.Stop()
+	select {
+	case <-event:
+	case <-timer.C:
+		t.Fatalf("timed out waiting for %s", name)
+	}
+}
