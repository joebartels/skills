+func TestIndependentInvocations(t *testing.T) {
+	t.Parallel()
+	firstCtx, cancelFirst := context.WithCancel(context.Background())
+	secondCtx, cancelSecond := context.WithCancel(context.Background())
+	firstStarted := make(chan struct{})
+	secondStarted := make(chan struct{})
+	secondRelease := make(chan struct{})
+	want := errors.New("second invocation complete")
+	first := startPoll(t, firstCtx, cancelFirst, time.Hour, func(context.Context) error {
+		close(firstStarted)
+		<-firstCtx.Done()
+		return nil
+	})
+	second := startPoll(t, secondCtx, cancelSecond, time.Hour, func(context.Context) error {
+		close(secondStarted)
+		select {
+		case <-secondRelease:
+			return want
+		case <-secondCtx.Done():
+			return nil
+		}
+	})
+	waitEvent(t, firstStarted, "first invocation")
+	waitEvent(t, secondStarted, "second invocation")
+	cancelFirst()
+	if err := first.wait(t); err != nil {
+		t.Fatalf("first Poll = %v, want nil", err)
+	}
+	observation := time.NewTimer(20 * time.Millisecond)
+	t.Cleanup(func() { observation.Stop() })
+	select {
+	case <-second.finished:
+		t.Fatal("second Poll stopped when the first invocation was canceled")
+	case <-observation.C:
+	}
+	close(secondRelease)
+	if err := second.wait(t); err != want {
+		t.Fatalf("second Poll = %v, want its callback error %v", err, want)
+	}
+	if err := secondCtx.Err(); err != nil {
+		t.Fatalf("second caller context = %v, want uncanceled", err)
+	}
+}
