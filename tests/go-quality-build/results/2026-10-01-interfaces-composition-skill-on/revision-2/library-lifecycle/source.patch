+func TestStartWaitsAfterSuccessfulCompletion(t *testing.T) {
+	const interval = 80 * time.Millisecond
+	entered := make(chan time.Time, 3)
+	release := make(chan struct{})
+	firstFinished := make(chan time.Time, 1)
+	var calls atomic.Int32
+	r, _ := refreshkit.New(func(context.Context) error {
+		call := calls.Add(1)
+		entered <- time.Now()
+		if call == 1 {
+			<-release
+			firstFinished <- time.Now()
+		}
+		return nil
+	})
+	run, err := r.Start(context.Background(), interval)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = receiveTime(t, entered)
+	time.Sleep(interval + 20*time.Millisecond)
+	close(release)
+	second := receiveTime(t, entered)
+	finished := receiveTime(t, firstFinished)
+	if elapsed := second.Sub(finished); elapsed < interval {
+		t.Fatalf("second callback started after %v, want at least %v after first completed", elapsed, interval)
+	}
+	run.Stop()
+	if err := run.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("Wait error = %v, want context.Canceled", err)
+	}
+}
+
+func TestStopWaitsForActiveRefreshAndCallbackErrorWins(t *testing.T) {
+	callbackErr := errors.New("refresh failed")
+	started := make(chan struct{})
+	cleanup := make(chan struct{})
+	r, _ := refreshkit.New(func(ctx context.Context) error {
+		close(started)
+		<-ctx.Done()
+		<-cleanup
+		return callbackErr
+	})
+	run, err := r.Start(context.Background(), time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	receive(t, started)
+	run.Stop()
+	waitReturned := make(chan error, 1)
+	go func() { waitReturned <- run.Wait() }()
+	select {
+	case err := <-waitReturned:
+		t.Fatalf("Wait returned before callback cleanup: %v", err)
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(cleanup)
+	if err := receiveErr(t, waitReturned); err != callbackErr {
+		t.Fatalf("Wait error = %v, want callback error", err)
+	}
+}
+
+func TestRunsAreIndependent(t *testing.T) {
+	var callsA, callsB atomic.Int32
+	a, _ := refreshkit.New(func(context.Context) error { callsA.Add(1); return nil })
+	b, _ := refreshkit.New(func(context.Context) error { callsB.Add(1); return nil })
+	runA, err := a.Start(context.Background(), 20*time.Millisecond)
+	if err != nil {
+		t.Fatal(err)
+	}
+	runB, err := b.Start(context.Background(), 20*time.Millisecond)
+	if err != nil {
+		runA.Stop()
+		_ = runA.Wait()
+		t.Fatal(err)
+	}
+	defer func() { runA.Stop(); runB.Stop(); _ = runA.Wait(); _ = runB.Wait() }()
+	waitFor(t, func() bool { return callsA.Load() >= 2 && callsB.Load() >= 2 })
+	runA.Stop()
+	if err := runA.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("A Wait error = %v", err)
+	}
+	afterA := callsA.Load()
+	before := callsB.Load()
+	waitFor(t, func() bool { return callsB.Load() > before })
+	if callsA.Load() != afterA {
+		t.Fatalf("A calls changed after join: from %d to %d", afterA, callsA.Load())
+	}
+}
+
+func TestStartRejectsNonpositiveInterval(t *testing.T) {
+	r, _ := refreshkit.New(func(context.Context) error { return nil })
+	for _, interval := range []time.Duration{0, -time.Second} {
+		if _, err := r.Start(context.Background(), interval); err == nil {
+			t.Fatalf("Start(%v) succeeded", interval)
+		}
+	}
+}
+
+func TestCallbackErrorStopsRun(t *testing.T) {
+	want := errors.New("refresh failed")
+	var calls atomic.Int32
+	r, _ := refreshkit.New(func(context.Context) error { calls.Add(1); return want })
+	run, err := r.Start(context.Background(), time.Millisecond)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := receiveErr(t, errorWaiter(run)); err != want {
+		t.Fatalf("Wait error = %v, want callback error", err)
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("calls = %d, want 1", calls.Load())
+	}
+}
+
+func receive(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting")
+	}
+}
+
+func receiveTime(t *testing.T, ch <-chan time.Time) time.Time {
+	t.Helper()
+	select {
+	case value := <-ch:
+		return value
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for refresh")
+		return time.Time{}
+	}
+}
+
+func receiveErr(t *testing.T, ch <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-ch:
+		return err
+	case <-time.After(time.Second):
+		t.Fatal("timed out waiting for run")
+		return nil
+	}
+}
+
+func errorWaiter(run interface{ Wait() error }) <-chan error {
+	ch := make(chan error, 1)
+	go func() { ch <- run.Wait() }()
+	return ch
+}
+
+func waitFor(t *testing.T, ready func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for !ready() {
+		if time.Now().After(deadline) {
+			t.Fatal("timed out waiting for condition")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
