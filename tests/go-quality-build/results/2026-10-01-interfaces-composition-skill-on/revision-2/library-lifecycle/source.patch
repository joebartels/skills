 func (r *Refresher) Refresh(ctx context.Context) error { return r.refresh(ctx) }
+
+// Start begins a periodic run. It calls the callback immediately and, after
+// each successful completion, waits interval before starting the next call.
+// At most one callback runs at a time. A nonpositive interval is an error.
+// The caller owns resources used by the callback and must wait for the returned
+// Run to finish before releasing them.
+func (r *Refresher) Start(ctx context.Context, interval time.Duration) (*Run, error) {
+	if interval <= 0 {
+		return nil, errors.New("refresh interval must be positive")
+	}
+	runCtx, cancel := context.WithCancel(ctx)
+	run := &Run{cancel: cancel, done: make(chan struct{})}
+	go run.loop(runCtx, r.refresh, interval)
+	return run, nil
+}
+
+// Run represents one periodic refresh operation.
+type Run struct {
+	cancel context.CancelFunc
+	done   chan struct{}
+	err    error
+}
+
+// Stop requests cancellation of the run. It does not wait for the active
+// callback to return; call Wait before releasing resources used by callbacks.
+func (run *Run) Stop() { run.cancel() }
+
+// Wait blocks until the run finishes and returns its result. Callback errors
+// take precedence over cancellation. If callbacks return nil after the run's
+// context is canceled, Wait returns the context cancellation error.
+func (run *Run) Wait() error {
+	<-run.done
+	return run.err
+}
+
+func (run *Run) loop(ctx context.Context, refresh func(context.Context) error, interval time.Duration) {
+	defer close(run.done)
+	defer run.cancel()
+	for {
+		if err := refresh(ctx); err != nil {
+			run.err = err
+			return
+		}
+		if err := ctx.Err(); err != nil {
+			run.err = err
+			return
+		}
+		timer := time.NewTimer(interval)
+		select {
+		case <-ctx.Done():
+			if !timer.Stop() {
+				select {
+				case <-timer.C:
+				default:
+				}
+			}
+			run.err = ctx.Err()
+			return
+		case <-timer.C:
+		}
+	}
+}
