 func (r *Refresher) Refresh(ctx context.Context) error { return r.refresh(ctx) }
+
+// Start begins periodic refreshes. The first refresh begins immediately; later
+// refreshes begin interval after the previous refresh completes successfully.
+// The supplied context controls the run and is passed to every callback.
+// A run stops on its first callback error. Start rejects nonpositive intervals
+// and a second start while this Refresher already has an active run.
+func (r *Refresher) Start(ctx context.Context, interval time.Duration) (*Run, error) {
+	if interval <= 0 {
+		return nil, errors.New("refresh interval must be positive")
+	}
+	if ctx == nil {
+		return nil, errors.New("nil context")
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.active {
+		return nil, errors.New("periodic refresh already running")
+	}
+	r.active = true
+
+	ctx, cancel := context.WithCancel(ctx)
+	run := &Run{cancel: cancel, done: make(chan struct{})}
+	go func() {
+		defer close(run.done)
+		defer cancel()
+		defer func() {
+			r.mu.Lock()
+			r.active = false
+			r.mu.Unlock()
+		}()
+		run.err = r.loop(ctx, interval)
+	}()
+	return run, nil
+}
+
+// Run controls one periodic refresh run. Call Stop to request cancellation,
+// then Wait before releasing resources used by the callback. Wait returns the
+// first callback error unchanged, including context.Canceled if the callback
+// returns it in response to stopping. Parent-context cancellation also stops
+// the run; Wait returns the callback's resulting error, if any.
+type Run struct {
+	cancel context.CancelFunc
+	done   chan struct{}
+	err    error
+}
+
+// Stop requests cancellation and returns without waiting for callback cleanup.
+func (run *Run) Stop() { run.cancel() }
+
+// Wait blocks until the callback and periodic loop have fully stopped.
+func (run *Run) Wait() error {
+	<-run.done
+	return run.err
+}
+
+func (r *Refresher) loop(ctx context.Context, interval time.Duration) error {
+	for {
+		if err := r.refresh(ctx); err != nil {
+			return err
+		}
+		timer := time.NewTimer(interval)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
