+func TestPeriodicStopWaitsForActiveRefresh(t *testing.T) {
+	entered := make(chan struct{})
+	cleaning := make(chan struct{})
+	release := make(chan struct{})
+	r, _ := refreshkit.New(func(ctx context.Context) error {
+		close(entered)
+		<-ctx.Done()
+		close(cleaning)
+		<-release
+		return ctx.Err()
+	})
+	run, err := r.Start(context.Background(), time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("refresh did not start")
+	}
+	run.Stop()
+	select {
+	case <-cleaning:
+	case <-time.After(time.Second):
+		t.Fatal("callback did not receive cancellation")
+	}
+	joined := make(chan error, 1)
+	go func() { joined <- run.Wait() }()
+	select {
+	case <-joined:
+		t.Fatal("Wait returned before callback cleanup")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	if err := <-joined; !errors.Is(err, context.Canceled) {
+		t.Fatalf("Wait error = %v", err)
+	}
+}
+
+func TestPeriodicInstancesAreIndependent(t *testing.T) {
+	var aCalls, bCalls atomic.Int32
+	makeRefresher := func(calls *atomic.Int32) *refreshkit.Refresher {
+		r, err := refreshkit.New(func(context.Context) error { calls.Add(1); return nil })
+		if err != nil {
+			t.Fatal(err)
+		}
+		return r
+	}
+	a, b := makeRefresher(&aCalls), makeRefresher(&bCalls)
+	ar, err := a.Start(context.Background(), 20*time.Millisecond)
+	if err != nil {
+		t.Fatal(err)
+	}
+	br, err := b.Start(context.Background(), 20*time.Millisecond)
+	if err != nil {
+		ar.Stop()
+		_ = ar.Wait()
+		t.Fatal(err)
+	}
+	waitFor(t, func() bool { return aCalls.Load() >= 2 && bCalls.Load() >= 2 })
+	ar.Stop()
+	if err := ar.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+	before := bCalls.Load()
+	waitFor(t, func() bool { return bCalls.Load() > before })
+	br.Stop()
+	if err := br.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
+
+func TestPeriodicRefreshError(t *testing.T) {
+	want := errors.New("periodic refresh failed")
+	var calls atomic.Int32
+	r, _ := refreshkit.New(func(context.Context) error { calls.Add(1); return want })
+	run, err := r.Start(context.Background(), time.Millisecond)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := run.Wait(); got != want {
+		t.Fatalf("Wait error = %v", got)
+	}
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("calls = %d", got)
+	}
+}
+
+func TestPeriodicWaitsIntervalAfterCompletion(t *testing.T) {
+	started := make(chan time.Time, 2)
+	release := make(chan struct{})
+	var calls atomic.Int32
+	r, _ := refreshkit.New(func(context.Context) error {
+		n := calls.Add(1)
+		started <- time.Now()
+		if n == 1 {
+			<-release
+		}
+		return nil
+	})
+	interval := 40 * time.Millisecond
+	run, err := r.Start(context.Background(), interval)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := <-started
+	time.Sleep(interval + 20*time.Millisecond)
+	select {
+	case <-started:
+		t.Fatal("overlapping/early refresh")
+	default:
+	}
+	close(release)
+	second := <-started
+	if elapsed := second.Sub(first); elapsed < interval+20*time.Millisecond {
+		t.Fatalf("second started too soon: %v", elapsed)
+	}
+	run.Stop()
+	if err := run.Wait(); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
+
+func waitFor(t *testing.T, condition func() bool) {
+	t.Helper()
+	deadline := time.After(time.Second)
+	for !condition() {
+		select {
+		case <-deadline:
+			t.Fatal("condition not reached")
+		default:
+			time.Sleep(time.Millisecond)
+		}
+	}
+}
