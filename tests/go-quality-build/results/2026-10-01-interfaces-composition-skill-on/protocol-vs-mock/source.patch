+func TestReportReturnsNoBytesOnEncodingFailure(t *testing.T) {
+	want := errors.New("encode failed")
+	r := reportkit.Report{Encoder: failingEncoder{err: want}}
+	got, err := r.Render(nil)
+	if !errors.Is(err, want) {
+		t.Fatalf("error = %v, want %v", err, want)
+	}
+	if got != nil {
+		t.Fatalf("bytes = %q, want nil", got)
+	}
+}
