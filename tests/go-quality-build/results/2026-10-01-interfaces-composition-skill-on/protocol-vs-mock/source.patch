 func (JSON) Encode(w io.Writer, records []Record) error { return json.NewEncoder(w).Encode(records) }
 
+// CSV writes records as name,value rows, preceded by a header.
+type CSV struct{}
+
+func (CSV) Encode(w io.Writer, records []Record) error {
+	writer := csv.NewWriter(w)
+	if err := writer.Write([]string{"name", "value"}); err != nil {
+		return err
+	}
+	for _, record := range records {
+		if err := writer.Write([]string{record.Name, record.Value}); err != nil {
+			return err
+		}
+	}
+	writer.Flush()
+	return writer.Error()
+}
