+
+type tabEncoder struct{}
+
+func (tabEncoder) Encode(w io.Writer, records []reportkit.Record) error {
+	for _, record := range records {
+		if _, err := io.WriteString(w, record.Name+"\t"+record.Value+"\n"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func Example_hostDefinedEncoder() {
+	report := reportkit.Report{Encoder: tabEncoder{}}
+	got, err := report.Render([]reportkit.Record{{Name: "total", Value: "7"}})
+	if err != nil {
+		panic(err)
+	}
+	fmt.Print(string(got))
+	// Output: total	7
+}
