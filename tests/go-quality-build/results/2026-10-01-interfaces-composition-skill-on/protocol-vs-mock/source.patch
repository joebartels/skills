+func TestCSVReportQuotesFields(t *testing.T) {
+	r := reportkit.Report{Encoder: reportkit.CSV{}}
+	got, err := r.Render([]reportkit.Record{{Name: "last, first", Value: "said \"hello\"\nagain"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := "name,value\n\"last, first\",\"said \"\"hello\"\"\nagain\"\n"
+	if string(got) != want {
+		t.Fatalf("report = %q, want %q", got, want)
+	}
+}
+
+func TestCSVReportEmptyInput(t *testing.T) {
+	r := reportkit.Report{Encoder: reportkit.CSV{}}
+	got, err := r.Render(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "name,value\n" {
+		t.Fatalf("report = %q", got)
+	}
+}
