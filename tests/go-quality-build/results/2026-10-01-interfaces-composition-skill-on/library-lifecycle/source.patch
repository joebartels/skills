 func (r *Refresher) Refresh(ctx context.Context) error { return r.refresh(ctx) }
+
+// RunPeriodic refreshes immediately, then waits interval after each successful
+// refresh before starting the next one. It returns the first callback error.
+// A nonpositive interval is rejected before the callback is invoked. The
+// caller controls the run through ctx; when canceled, RunPeriodic returns
+// ctx.Err() after the active callback has returned. The callback must honor
+// cancellation for shutdown to complete promptly. RunPeriodic blocks until
+// completion, so the host can wait for it before releasing resources borrowed
+// by the callback. A Refresher must not have concurrent periodic runs.
+func (r *Refresher) RunPeriodic(ctx context.Context, interval time.Duration) error {
+	if interval <= 0 {
+		return errors.New("refresh interval must be positive")
+	}
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := r.Refresh(ctx); err != nil {
+			return err
+		}
+		timer := time.NewTimer(interval)
+		select {
+		case <-ctx.Done():
+			if !timer.Stop() {
+				select {
+				case <-timer.C:
+				default:
+				}
+			}
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
