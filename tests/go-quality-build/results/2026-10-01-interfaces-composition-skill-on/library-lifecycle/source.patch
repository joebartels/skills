+func TestRunPeriodicStopsAfterActiveRefreshReturns(t *testing.T) {
+	entered := make(chan struct{})
+	cleaning := make(chan struct{})
+	release := make(chan struct{})
+	r, _ := refreshkit.New(func(ctx context.Context) error {
+		close(entered)
+		<-ctx.Done()
+		close(cleaning)
+		<-release
+		return nil
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- r.RunPeriodic(ctx, time.Hour) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("refresh did not start")
+	}
+	cancel()
+	select {
+	case <-cleaning:
+	case <-time.After(time.Second):
+		t.Fatal("active refresh did not receive cancellation")
+	}
+	select {
+	case err := <-done:
+		t.Fatalf("run returned before callback cleanup: %v", err)
+	default:
+	}
+	close(release)
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("error = %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("run did not finish")
+	}
+}
+
+func TestRunPeriodicInstancesAreIndependent(t *testing.T) {
+	var aCalls, bCalls atomic.Int32
+	bSecond := make(chan struct{})
+	a, _ := refreshkit.New(func(context.Context) error { aCalls.Add(1); return nil })
+	b, _ := refreshkit.New(func(context.Context) error {
+		if bCalls.Add(1) == 2 {
+			close(bSecond)
+		}
+		return nil
+	})
+	ctxA, stopA := context.WithCancel(context.Background())
+	ctxB, stopB := context.WithCancel(context.Background())
+	doneA, doneB := make(chan error, 1), make(chan error, 1)
+	go func() { doneA <- a.RunPeriodic(ctxA, 10*time.Millisecond) }()
+	go func() { doneB <- b.RunPeriodic(ctxB, 10*time.Millisecond) }()
+	stopA()
+	if err := <-doneA; !errors.Is(err, context.Canceled) {
+		t.Fatalf("A error = %v", err)
+	}
+	select {
+	case <-bSecond:
+	case <-time.After(time.Second):
+		t.Fatal("stopping A prevented B from refreshing")
+	}
+	stopB()
+	if err := <-doneB; !errors.Is(err, context.Canceled) {
+		t.Fatalf("B error = %v", err)
+	}
+}
+
+func TestRunPeriodicReturnsRefreshError(t *testing.T) {
+	want := errors.New("periodic failure")
+	calls := 0
+	r, _ := refreshkit.New(func(context.Context) error { calls++; return want })
+	err := r.RunPeriodic(context.Background(), time.Millisecond)
+	if err != want {
+		t.Fatalf("error = %v", err)
+	}
+	if calls != 1 {
+		t.Fatalf("calls = %d", calls)
+	}
+}
+
+func ExampleRefresher_RunPeriodic() {
+	makeRefresher := func() *refreshkit.Refresher {
+		r, _ := refreshkit.New(func(ctx context.Context) error { <-ctx.Done(); return nil })
+		return r
+	}
+	refresherA, refresherB := makeRefresher(), makeRefresher()
+	ctxA, stopA := context.WithCancel(context.Background())
+	ctxB, stopB := context.WithCancel(context.Background())
+	results := make(chan error, 2)
+	go func() { results <- refresherA.RunPeriodic(ctxA, time.Minute) }()
+	go func() { results <- refresherB.RunPeriodic(ctxB, time.Minute) }()
+	stopA()
+	stopB()
+	for range 2 {
+		<-results
+	}
+	fmt.Println("both refreshers stopped")
+	// Output: both refreshers stopped
+}
