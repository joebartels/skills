+func TestSendPropagatesCancellation(t *testing.T) {
+	started := make(chan struct{})
+	client := &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		close(started)
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- NewSender("https://receipts.invalid", client).Send(ctx, "abc") }()
+	select {
+	case <-started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("request did not reach server")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("Send returned nil after cancellation")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("Send did not return after cancellation")
+	}
+}
+
+func TestSendRejectsNon2xxResponse(t *testing.T) {
+	client := &http.Client{Transport: roundTripFunc(func(*http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: http.StatusServiceUnavailable, Body: io.NopCloser(strings.NewReader("")), Header: make(http.Header)}, nil
+	})}
+	if err := NewSender("https://receipts.invalid", client).Send(context.Background(), "abc"); err == nil {
+		t.Fatal("Send succeeded for non-2xx response")
+	}
+}
