+func TestProducerFailureStopsAndJoinsConsumer(t *testing.T) {
+	failure := errors.New("production failed")
+	consumerStarted := make(chan struct{})
+	cleanupStarted := make(chan struct{})
+	consumerReturned := make(chan struct{})
+	release, open := gate()
+	accepted := 0
+	done := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			select {
+			case out <- 7:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			select {
+			case <-consumerStarted:
+				return failure
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		},
+		func(ctx context.Context, in <-chan int) error {
+			defer close(consumerReturned)
+			select {
+			case accepted = <-in:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			close(consumerStarted)
+			<-ctx.Done()
+			close(cleanupStarted)
+			<-release
+			return ctx.Err()
+		}, open)
+	waitEvent(t, cleanupStarted)
+	assertHeld(t, done)
+	open()
+	err := waitResult(t, done)
+	if !errors.Is(err, failure) || errors.Is(err, context.Canceled) {
+		t.Fatalf("runPipeline = %v, want production failure without stop acknowledgment", err)
+	}
+	waitEvent(t, consumerReturned)
+	if accepted != 7 {
+		t.Fatalf("accepted value after failure = %d, want 7", accepted)
+	}
+}
