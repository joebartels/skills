+func TestCanceledCallerSkipsCallbacks(t *testing.T) {
+	ctx, cancel := context.WithCancelCause(context.Background())
+	cancel(cancellationCause{[]string{"caller stopped"}})
+	called := false
+	err := runPipeline(ctx, 1,
+		func(context.Context, chan<- int) error { called = true; return nil },
+		func(context.Context, <-chan int) error { called = true; return nil })
+	if called {
+		t.Error("already-canceled caller invoked a callback")
+	}
+	assertCallerCancellation(t, err)
+}
