+func TestChannelClosesAfterProducerReturnAndConsumerIsJoined(t *testing.T) {
+	producerCleanup := make(chan struct{})
+	producerReturned := make(chan struct{})
+	valueAccepted := make(chan struct{})
+	channelClosed := make(chan struct{})
+	consumerReturned := make(chan struct{})
+	producerRelease, openProducer := gate()
+	consumerRelease, openConsumer := gate()
+	got := 0
+	done := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			defer close(producerReturned)
+			select {
+			case out <- 7:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			close(producerCleanup)
+			<-producerRelease
+			return nil
+		},
+		func(ctx context.Context, in <-chan int) error {
+			defer close(consumerReturned)
+			select {
+			case got = <-in:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			close(valueAccepted)
+			select {
+			case _, ok := <-in:
+				if ok {
+					return errors.New("unexpected second value")
+				}
+				close(channelClosed)
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			<-consumerRelease
+			return nil
+		}, openProducer, openConsumer)
+	waitEvent(t, producerCleanup)
+	waitEvent(t, valueAccepted)
+	select {
+	case <-channelClosed:
+		t.Fatal("channel closed while producer callback still held cleanup")
+	case <-time.After(20 * time.Millisecond):
+	}
+	openProducer()
+	waitEvent(t, producerReturned)
+	waitEvent(t, channelClosed)
+	assertHeld(t, done)
+	openConsumer()
+	if err := waitResult(t, done); err != nil {
+		t.Fatalf("runPipeline = %v, want nil", err)
+	}
+	waitEvent(t, consumerReturned)
+	if got != 7 {
+		t.Fatalf("accepted value = %d, want 7", got)
+	}
+}
