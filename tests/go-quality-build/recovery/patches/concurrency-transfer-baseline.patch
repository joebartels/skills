+func TestExactContextErrorBeforeStoppingIsIndependent(t *testing.T) {
+	for _, side := range []string{"producer", "consumer"} {
+		t.Run(side, func(t *testing.T) {
+			done := startPipeline(t, context.Background(), 1,
+				func(ctx context.Context, _ chan<- int) error {
+					if side == "producer" {
+						return context.Canceled
+					}
+					<-ctx.Done()
+					return ctx.Err()
+				},
+				func(ctx context.Context, _ <-chan int) error {
+					if side == "consumer" {
+						return context.Canceled
+					}
+					<-ctx.Done()
+					return ctx.Err()
+				})
+			if err := waitResult(t, done); !errors.Is(err, context.Canceled) {
+				t.Fatalf("runPipeline = %v, missing independent exact context error", err)
+			}
+		})
+	}
+}
