+func TestConsumerEarlyCompletionStopsAndJoinsProducer(t *testing.T) {
+	cleanupStarted := make(chan struct{})
+	producerReturned := make(chan struct{})
+	release, open := gate()
+	var accepted []int
+	done := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			defer close(producerReturned)
+			for value := 1; ; value++ {
+				select {
+				case out <- value:
+				case <-ctx.Done():
+					close(cleanupStarted)
+					<-release
+					return ctx.Err()
+				}
+			}
+		},
+		func(ctx context.Context, in <-chan int) error {
+			for len(accepted) < 3 {
+				select {
+				case value := <-in:
+					accepted = append(accepted, value)
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			}
+			return nil
+		}, open)
+	waitEvent(t, cleanupStarted)
+	assertHeld(t, done)
+	open()
+	if err := waitResult(t, done); err != nil {
+		t.Fatalf("runPipeline = %v, want early completion success", err)
+	}
+	waitEvent(t, producerReturned)
+	if !slices.Equal(accepted, []int{1, 2, 3}) {
+		t.Fatalf("accepted values = %v, want [1 2 3]", accepted)
+	}
+}
