+func TestOrderedValues(t *testing.T) {
+	var got []int
+	done := startPipeline(t, context.Background(), 2,
+		func(ctx context.Context, out chan<- int) error {
+			for _, value := range []int{3, 1, 4, 1, 5} {
+				select {
+				case out <- value:
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			}
+			return nil
+		},
+		func(ctx context.Context, in <-chan int) error {
+			if cap(in) != 2 {
+				return fmt.Errorf("channel capacity = %d, want 2", cap(in))
+			}
+			for {
+				select {
+				case value, ok := <-in:
+					if !ok {
+						return nil
+					}
+					got = append(got, value)
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			}
+		})
+	if err := waitResult(t, done); err != nil {
+		t.Fatalf("runPipeline = %v, want nil", err)
+	}
+	if !slices.Equal(got, []int{3, 1, 4, 1, 5}) {
+		t.Fatalf("consumed values = %v, want [3 1 4 1 5]", got)
+	}
+}
