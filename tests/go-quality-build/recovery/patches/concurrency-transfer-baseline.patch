+func TestIndependentErrorsAfterCoordinatedStop(t *testing.T) {
+	marker := errors.New("independent operation failed")
+	for _, tc := range []struct {
+		name string
+		err  error
+		want error
+	}{
+		{"wrapped canceled", fmt.Errorf("independent operation: %w", context.Canceled), context.Canceled},
+		{"joined canceled", errors.Join(marker, context.Canceled), marker},
+		{"joined deadline", errors.Join(marker, context.DeadlineExceeded), marker},
+		{"bare deadline", context.DeadlineExceeded, context.DeadlineExceeded},
+	} {
+		for _, side := range []string{"producer", "consumer"} {
+			t.Run(side+"/"+tc.name, func(t *testing.T) {
+				peerFailure := errors.New("peer failed")
+				done := startPipeline(t, context.Background(), 1,
+					func(ctx context.Context, _ chan<- int) error {
+						if side == "consumer" {
+							return peerFailure
+						}
+						<-ctx.Done()
+						return tc.err
+					},
+					func(ctx context.Context, _ <-chan int) error {
+						if side == "producer" {
+							return nil
+						}
+						<-ctx.Done()
+						return tc.err
+					})
+				err := waitResult(t, done)
+				if !errors.Is(err, tc.err) || !errors.Is(err, tc.want) {
+					t.Fatalf("runPipeline = %v, missing original independent error %v", err, tc.err)
+				}
+				if side == "consumer" && !errors.Is(err, peerFailure) {
+					t.Fatalf("runPipeline = %v, missing independent producer failure", err)
+				}
+			})
+		}
+	}
+}
