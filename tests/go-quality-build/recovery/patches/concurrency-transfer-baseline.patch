+func TestCallerCancellationJoinsHeldCallbacksAndPreservesFailures(t *testing.T) {
+	ctx, cancel := context.WithCancelCause(context.Background())
+	t.Cleanup(func() { cancel(nil) })
+	producerStarted := make(chan struct{})
+	consumerStarted := make(chan struct{})
+	producerCleanup := make(chan struct{})
+	consumerCleanup := make(chan struct{})
+	producerReturned := make(chan struct{})
+	consumerReturned := make(chan struct{})
+	release, open := gate()
+	failure := errors.New("independent failure during cancellation")
+	done := startPipeline(t, ctx, 1,
+		func(ctx context.Context, _ chan<- int) error {
+			defer close(producerReturned)
+			close(producerStarted)
+			<-ctx.Done()
+			close(producerCleanup)
+			<-release
+			return errors.Join(failure, ctx.Err())
+		},
+		func(ctx context.Context, _ <-chan int) error {
+			defer close(consumerReturned)
+			close(consumerStarted)
+			<-ctx.Done()
+			close(consumerCleanup)
+			<-release
+			return ctx.Err()
+		}, open)
+	waitEvent(t, producerStarted)
+	waitEvent(t, consumerStarted)
+	cancel(cancellationCause{[]string{"caller stopped"}})
+	waitEvent(t, producerCleanup)
+	waitEvent(t, consumerCleanup)
+	assertHeld(t, done)
+	open()
+	err := waitResult(t, done)
+	assertCallerCancellation(t, err)
+	if !errors.Is(err, failure) {
+		t.Fatalf("runPipeline = %v, missing independent failure", err)
+	}
+	waitEvent(t, producerReturned)
+	waitEvent(t, consumerReturned)
+}
