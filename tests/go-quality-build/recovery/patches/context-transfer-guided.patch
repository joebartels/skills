+func TestReceiptWaitsForCooperativeFinish(t *testing.T) {
+	expired := make(chan struct{})
+	release := make(chan struct{})
+	result := make(chan error, 1)
+	finishErr := errors.New("receipt failure after cleanup")
+	var once sync.Once
+	received := false
+	t.Cleanup(func() {
+		once.Do(func() { close(release) })
+		if !received {
+			select {
+			case <-result:
+			case <-time.After(time.Second):
+				t.Error("ApplyBatch did not join finish")
+			}
+		}
+	})
+	go func() {
+		_, err := ApplyBatch(context.Background(), []string{"one"}, 10*time.Millisecond,
+			func(context.Context, string) error { return nil },
+			func(ctx context.Context, _ int) error {
+				select {
+				case <-ctx.Done():
+				case <-time.After(time.Second):
+					return errors.New("finish scope has no working budget")
+				}
+				close(expired)
+				<-release
+				return errors.Join(finishErr, ctx.Err())
+			})
+		result <- err
+	}()
+	select {
+	case <-expired:
+	case err := <-result:
+		received = true
+		t.Fatalf("returned before finish reached its budget: %v", err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("finish did not observe its budget")
+	}
+	select {
+	case err := <-result:
+		received = true
+		t.Fatalf("returned while finish still held caller data: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	once.Do(func() { close(release) })
+	select {
+	case err := <-result:
+		received = true
+		if !errors.Is(err, finishErr) || !errors.Is(err, context.DeadlineExceeded) {
+			t.Errorf("finish failure missing: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("ApplyBatch did not return after finish")
+	}
+}
