+func TestCallerCancellationJoinsCallbacksAndPreservesCause(t *testing.T) {
+	ctx, cancel := context.WithCancelCause(context.Background())
+	defer cancel(nil)
+	producerStarted := make(chan struct{})
+	consumerStarted := make(chan struct{})
+	producerCleanup := make(chan struct{})
+	consumerCleanup := make(chan struct{})
+	producerRelease := make(chan struct{})
+	consumerRelease := make(chan struct{})
+	defer close(producerRelease)
+	defer close(consumerRelease)
+	consumerFailure := errors.New("independent consumer failure")
+	result := startPipeline(t, ctx, 1,
+		func(ctx context.Context, out chan<- int) error {
+			close(producerStarted)
+			<-ctx.Done()
+			close(producerCleanup)
+			<-producerRelease
+			return nil
+		},
+		func(ctx context.Context, in <-chan int) error {
+			close(consumerStarted)
+			<-ctx.Done()
+			close(consumerCleanup)
+			<-consumerRelease
+			return consumerFailure
+		})
+	waitEvent(t, producerStarted, "producer start")
+	waitEvent(t, consumerStarted, "consumer start")
+	cancel(sliceCause{"caller stopped"})
+	waitEvent(t, producerCleanup, "producer cleanup")
+	waitEvent(t, consumerCleanup, "consumer cleanup")
+	assertPending(t, result)
+	producerRelease <- struct{}{}
+	assertPending(t, result)
+	consumerRelease <- struct{}{}
+	err := waitResult(t, result)
+	var cause sliceCause
+	if !errors.Is(err, context.Canceled) || !errors.Is(err, consumerFailure) || !errors.As(err, &cause) || cause[0] != "caller stopped" {
+		t.Fatalf("error = %v, want caller classification, noncomparable cause, and consumer failure", err)
+	}
+}
