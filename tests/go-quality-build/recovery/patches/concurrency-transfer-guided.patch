+func startPipeline(t *testing.T, parent context.Context, capacity int, produce func(context.Context, chan<- int) error, consume func(context.Context, <-chan int) error) <-chan error {
+	t.Helper()
+	ctx, cancel := context.WithCancel(parent)
+	result := make(chan error, 1)
+	finished := make(chan struct{})
+	t.Cleanup(func() {
+		cancel()
+		select {
+		case <-finished:
+		case <-time.After(3 * time.Second):
+			t.Error("pipeline did not finish during test cleanup")
+		}
+	})
+	go func() {
+		defer close(finished)
+		result <- runPipeline(ctx, capacity, produce, consume)
+	}()
+	return result
+}
+
+func waitEvent(t *testing.T, event <-chan struct{}, name string) {
+	t.Helper()
+	select {
+	case <-event:
+	case <-time.After(3 * time.Second):
+		t.Fatalf("timed out waiting for %s", name)
+	}
+}
+
+func waitResult(t *testing.T, result <-chan error) error {
+	t.Helper()
+	select {
+	case err := <-result:
+		return err
+	case <-time.After(3 * time.Second):
+		t.Fatal("timed out waiting for pipeline result")
+		return nil
+	}
+}
+
+func assertPending(t *testing.T, result <-chan error) {
+	t.Helper()
+	select {
+	case err := <-result:
+		t.Fatalf("pipeline returned while callback cleanup was held: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+}
