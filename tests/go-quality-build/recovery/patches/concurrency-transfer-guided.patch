+func TestProducerFailureStopsAndJoinsConsumer(t *testing.T) {
+	failure := errors.New("production failed")
+	accepted := make(chan struct{})
+	cleanupStarted := make(chan struct{})
+	release := make(chan struct{})
+	returned := make(chan struct{})
+	defer close(release)
+	got := 0
+	result := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			select {
+			case out <- 19:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			select {
+			case <-accepted:
+				return failure
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		},
+		func(ctx context.Context, in <-chan int) error {
+			defer close(returned)
+			select {
+			case got = <-in:
+				close(accepted)
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			<-ctx.Done()
+			close(cleanupStarted)
+			<-release
+			return ctx.Err()
+		})
+	waitEvent(t, cleanupStarted, "consumer cleanup")
+	assertPending(t, result)
+	release <- struct{}{}
+	err := waitResult(t, result)
+	if !errors.Is(err, failure) || errors.Is(err, context.Canceled) {
+		t.Fatalf("error = %v, want production failure without stop acknowledgement", err)
+	}
+	waitEvent(t, returned, "consumer return")
+	if got != 19 {
+		t.Fatalf("accepted value = %d, want 19", got)
+	}
+}
