+func TestIndependentBareCancellationBeforeStop(t *testing.T) {
+	started := make(chan struct{})
+	result := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			select {
+			case <-started:
+				return context.Canceled
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		},
+		func(ctx context.Context, in <-chan int) error {
+			close(started)
+			<-ctx.Done()
+			return ctx.Err()
+		})
+	if err := waitResult(t, result); !errors.Is(err, context.Canceled) {
+		t.Fatalf("error = %v, want independent bare cancellation", err)
+	}
+}
