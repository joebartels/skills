+func TestAlreadyCanceledCallerInvokesNeitherCallback(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	called := false
+	err := runPipeline(ctx, 1,
+		func(context.Context, chan<- int) error { called = true; return nil },
+		func(context.Context, <-chan int) error { called = true; return nil })
+	if called || !errors.Is(err, context.Canceled) {
+		t.Fatalf("called = %v, error = %v; want neither callback and caller cancellation", called, err)
+	}
+}
