+func TestOrderedValuesBeyondCapacity(t *testing.T) {
+	want := []int{2, 3, 5, 7, 11, 13}
+	var got []int
+	result := startPipeline(t, context.Background(), 2,
+		func(ctx context.Context, out chan<- int) error {
+			for _, value := range want {
+				select {
+				case out <- value:
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			}
+			return nil
+		},
+		func(ctx context.Context, in <-chan int) error {
+			for {
+				select {
+				case value, ok := <-in:
+					if !ok {
+						return nil
+					}
+					got = append(got, value)
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			}
+		})
+	if err := waitResult(t, result); err != nil {
+		t.Fatalf("pipeline: %v", err)
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("values = %v, want %v", got, want)
+	}
+}
