+func TestEarlyConsumerCompletionJoinsProducerCleanup(t *testing.T) {
+	cleanupStarted := make(chan struct{})
+	release := make(chan struct{})
+	returned := make(chan struct{})
+	defer close(release)
+	got := 0
+	result := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			defer close(returned)
+			for {
+				select {
+				case out <- 7:
+				case <-ctx.Done():
+					close(cleanupStarted)
+					<-release
+					return ctx.Err()
+				}
+			}
+		},
+		func(ctx context.Context, in <-chan int) error {
+			select {
+			case got = <-in:
+				return nil
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		})
+	waitEvent(t, cleanupStarted, "producer cleanup")
+	assertPending(t, result)
+	release <- struct{}{}
+	if err := waitResult(t, result); err != nil {
+		t.Fatalf("early completion: %v", err)
+	}
+	waitEvent(t, returned, "producer return")
+	if got != 7 {
+		t.Fatalf("accepted value = %d, want 7", got)
+	}
+}
