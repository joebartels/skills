+func TestIndependentDeadlineAfterCoordinatedStop(t *testing.T) {
+	result := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			<-ctx.Done()
+			return context.DeadlineExceeded
+		},
+		func(ctx context.Context, in <-chan int) error { return nil })
+	if err := waitResult(t, result); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("error = %v, want independent deadline failure", err)
+	}
+}
