+func TestIndependentWrappedAndJoinedFailures(t *testing.T) {
+	producerFailure := fmt.Errorf("independent producer operation: %w", context.Canceled)
+	consumerFailure := errors.New("consumer cleanup failed")
+	started := make(chan struct{})
+	result := startPipeline(t, context.Background(), 1,
+		func(ctx context.Context, out chan<- int) error {
+			select {
+			case <-started:
+				return producerFailure
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+		},
+		func(ctx context.Context, in <-chan int) error {
+			close(started)
+			<-ctx.Done()
+			return errors.Join(consumerFailure, ctx.Err())
+		})
+	err := waitResult(t, result)
+	if !errors.Is(err, producerFailure) || !errors.Is(err, consumerFailure) || !errors.Is(err, context.Canceled) {
+		t.Fatalf("error = %v, want both independent failures and their cancellation classification", err)
+	}
+}
