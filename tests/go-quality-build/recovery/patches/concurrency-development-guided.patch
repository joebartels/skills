+func TestLateAcquisitionClosesWithoutRun(t *testing.T) {
+	workErr := errors.New("run failure")
+	jobs := make(chan Job, 2)
+	jobs <- 1
+	jobs <- 2
+	acquiring, stopped := make(chan struct{}), make(chan struct{})
+	secondRun, lateClose := make(chan struct{}), make(chan struct{})
+	failGate, acquireGate, closeGate := newGate(), newGate(), newGate()
+	var lateRuns, lateCloses atomic.Int32
+	result := startServe(t, context.Background(), jobs, 2, func(ctx context.Context, job Job) (Lease, error) {
+		if job == 1 {
+			close(acquiring)
+			<-ctx.Done()
+			close(stopped)
+			<-acquireGate.ch
+			return funcLease{
+				run: func(context.Context, Job) error { lateRuns.Add(1); return nil },
+				close: func() error {
+					lateCloses.Add(1)
+					close(lateClose)
+					<-closeGate.ch
+					return nil
+				},
+			}, nil
+		}
+		return funcLease{
+			run: func(ctx context.Context, _ Job) error {
+				close(secondRun)
+				select {
+				case <-failGate.ch:
+					return workErr
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			},
+			close: func() error { return nil },
+		}, nil
+	}, failGate, acquireGate, closeGate)
+	await(t, acquiring, "held acquisition")
+	await(t, secondRun, "second Run")
+	failGate.release()
+	await(t, stopped, "held acquisition cancellation")
+	remainsBlocked(t, result.done, "Serve")
+	acquireGate.release()
+	await(t, lateClose, "late lease Close")
+	remainsBlocked(t, result.done, "Serve")
+	closeGate.release()
+	if err := result.wait(t); !errors.Is(err, workErr) {
+		t.Fatalf("Serve = %v, want %v", err, workErr)
+	}
+	if lateRuns.Load() != 0 || lateCloses.Load() != 1 {
+		t.Fatalf("late lease: runs=%d closes=%d", lateRuns.Load(), lateCloses.Load())
+	}
+}
