+func TestCloseFailureStopsAcquisitionAndRetainsOpenError(t *testing.T) {
+	closeErr := errors.New("close failure")
+	openErr := errors.New("open failure")
+	jobs := make(chan Job, 2)
+	jobs <- 1
+	jobs <- 2
+	acquiring, stopped := make(chan struct{}), make(chan struct{})
+	closing := make(chan struct{})
+	closeGate, openGate := newGate(), newGate()
+	result := startServe(t, context.Background(), jobs, 2, func(ctx context.Context, job Job) (Lease, error) {
+		if job == 2 {
+			close(acquiring)
+			<-ctx.Done()
+			close(stopped)
+			<-openGate.ch
+			return nil, errors.Join(openErr, ctx.Err())
+		}
+		return funcLease{
+			run: func(context.Context, Job) error { return nil },
+			close: func() error {
+				close(closing)
+				<-closeGate.ch
+				return closeErr
+			},
+		}, nil
+	}, closeGate, openGate)
+	await(t, acquiring, "second acquisition")
+	await(t, closing, "first Close")
+	closeGate.release()
+	await(t, stopped, "acquisition stop after Close failure")
+	remainsBlocked(t, result.done, "Serve")
+	openGate.release()
+	err := result.wait(t)
+	if !errors.Is(err, closeErr) || !errors.Is(err, openErr) || !errors.Is(err, context.Canceled) {
+		t.Fatalf("Serve = %v, want independent Open and Close causes including cancellation", err)
+	}
+}
+
+type sliceCause struct{ messages []string }
+
+func (e sliceCause) Error() string { return fmt.Sprint(e.messages) }
+
+func TestCallerCancellationDuringCleanupRetainsAllCauses(t *testing.T) {
+	workErr, closeErr := errors.New("work failure"), errors.New("close failure")
+	ctx, cancel := context.WithCancelCause(context.Background())
+	defer cancel(nil)
+	jobs := make(chan Job, 1)
+	jobs <- 1
+	closing := make(chan struct{})
+	closeGate := newGate()
+	result := startServe(t, ctx, jobs, 1, func(context.Context, Job) (Lease, error) {
+		return funcLease{
+			run: func(context.Context, Job) error { return errors.Join(workErr, context.DeadlineExceeded) },
+			close: func() error {
+				close(closing)
+				<-closeGate.ch
+				return fmt.Errorf("close: %w", errors.Join(closeErr, context.Canceled))
+			},
+		}, nil
+	}, closeGate)
+	await(t, closing, "held Close after independent Run failure")
+	cause := sliceCause{messages: []string{"caller stopped during cleanup"}}
+	cancel(cause)
+	remainsBlocked(t, result.done, "Serve")
+	closeGate.release()
+	err := result.wait(t)
+	for _, want := range []error{workErr, closeErr, context.Canceled, context.DeadlineExceeded} {
+		if !errors.Is(err, want) {
+			t.Errorf("Serve = %v, missing %v", err, want)
+		}
+	}
+	var got sliceCause
+	if !errors.As(err, &got) || !reflect.DeepEqual(got.messages, cause.messages) {
+		t.Fatalf("Serve = %v, missing noncomparable caller cause", err)
+	}
+}
+
+func TestAlreadyCanceledAdmitsNothing(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	jobs := make(chan Job, 1)
+	jobs <- 1
+	close(jobs)
+	calls := 0
+	err := Serve(ctx, jobs, 3, func(context.Context, Job) (Lease, error) {
+		calls++
+		return new(basicLease), nil
+	})
+	if !errors.Is(err, context.Canceled) || calls != 0 {
+		t.Fatalf("Serve = %v, Open calls=%d", err, calls)
+	}
+	if job := <-jobs; job != 1 {
+		t.Fatalf("caller channel changed: job=%d", job)
+	}
+}
