+func TestRunFailureStopsBeforeHeldCleanup(t *testing.T) {
+	workErr := errors.New("run failure")
+	jobs := make(chan Job, 3)
+	jobs <- 1
+	jobs <- 2
+	jobs <- 3
+	firstRun, secondRun := make(chan struct{}), make(chan struct{})
+	firstStopped, firstClosed := make(chan struct{}), make(chan struct{})
+	secondClose := make(chan struct{})
+	failGate, runCleanup, closeCleanup := newGate(), newGate(), newGate()
+	var thirdOpened atomic.Bool
+	var closed [4]atomic.Int32
+	result := startServe(t, context.Background(), jobs, 2, func(ctx context.Context, job Job) (Lease, error) {
+		if job == 3 {
+			thirdOpened.Store(true)
+			return funcLease{
+				run:   func(context.Context, Job) error { return nil },
+				close: func() error { closed[job].Add(1); return nil },
+			}, nil
+		}
+		return funcLease{
+			run: func(ctx context.Context, _ Job) error {
+				if job == 1 {
+					close(firstRun)
+					<-ctx.Done()
+					close(firstStopped)
+					<-runCleanup.ch
+					return ctx.Err()
+				}
+				close(secondRun)
+				select {
+				case <-failGate.ch:
+					return workErr
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			},
+			close: func() error {
+				closed[job].Add(1)
+				if job == 1 {
+					close(firstClosed)
+				} else {
+					close(secondClose)
+					<-closeCleanup.ch
+				}
+				return nil
+			},
+		}, nil
+	}, failGate, runCleanup, closeCleanup)
+	await(t, firstRun, "first Run")
+	await(t, secondRun, "second Run")
+	failGate.release()
+	await(t, secondClose, "failing lease Close")
+	await(t, firstStopped, "cooperative stop before Close finishes")
+	remainsBlocked(t, firstClosed, "first Close")
+	remainsBlocked(t, result.done, "Serve")
+	closeCleanup.release()
+	runCleanup.release()
+	await(t, firstClosed, "first Close after Run cleanup")
+	err := result.wait(t)
+	if !errors.Is(err, workErr) || errors.Is(err, context.Canceled) {
+		t.Fatalf("Serve = %v, want run failure without coordinated stop acknowledgement", err)
+	}
+	if thirdOpened.Load() || closed[1].Load() != 1 || closed[2].Load() != 1 {
+		t.Fatalf("third admitted=%v closes=[%d %d]", thirdOpened.Load(), closed[1].Load(), closed[2].Load())
+	}
+	jobs <- 4 // The caller still owns an open, usable channel after failure.
+}
