+type funcLease struct {
+	run   func(context.Context, Job) error
+	close func() error
+}
+
+func (l funcLease) Run(ctx context.Context, job Job) error { return l.run(ctx, job) }
+func (l funcLease) Close() error                           { return l.close() }
+
+type gate struct {
+	ch   chan struct{}
+	once sync.Once
+}
+
+func newGate() *gate     { return &gate{ch: make(chan struct{})} }
+func (g *gate) release() { g.once.Do(func() { close(g.ch) }) }
+
+func await(t *testing.T, event <-chan struct{}, description string) {
+	t.Helper()
+	select {
+	case <-event:
+	case <-time.After(5 * time.Second):
+		t.Fatalf("timed out waiting for %s", description)
+	}
+}
+
+func remainsBlocked(t *testing.T, event <-chan struct{}, description string) {
+	t.Helper()
+	select {
+	case <-event:
+		t.Fatalf("%s completed while its prerequisite was held", description)
+	case <-time.After(25 * time.Millisecond):
+	}
+}
+
+type serveResult struct {
+	done chan struct{}
+	err  error
+}
+
+func startServe(t *testing.T, parent context.Context, jobs <-chan Job, limit int,
+	open func(context.Context, Job) (Lease, error), gates ...*gate) *serveResult {
+	t.Helper()
+	ctx, cancel := context.WithCancel(parent)
+	result := &serveResult{done: make(chan struct{})}
+	t.Cleanup(func() {
+		cancel()
+		for _, gate := range gates {
+			gate.release()
+		}
+		select {
+		case <-result.done:
+		case <-time.After(5 * time.Second):
+			t.Error("Serve did not finish during cleanup")
+		}
+	})
+	go func() {
+		result.err = Serve(ctx, jobs, limit, open)
+		close(result.done)
+	}()
+	return result
+}
+
+func (r *serveResult) wait(t *testing.T) error {
+	t.Helper()
+	await(t, r.done, "Serve return")
+	return r.err
+}
+
+func TestSparseInputAndIndependentSlotRelease(t *testing.T) {
+	jobs := make(chan Job, 3)
+	jobs <- 1
+	firstRun := make(chan struct{})
+	secondClose := make(chan struct{})
+	thirdOpen := make(chan struct{})
+	firstRunGate, secondCloseGate := newGate(), newGate()
+	var reserved atomic.Int32
+	var overLimit atomic.Bool
+	var opened, closed [4]atomic.Int32
+	result := startServe(t, context.Background(), jobs, 2, func(ctx context.Context, job Job) (Lease, error) {
+		opened[job].Add(1)
+		if reserved.Add(1) > 2 {
+			overLimit.Store(true)
+		}
+		if job == 3 {
+			close(thirdOpen)
+		}
+		return funcLease{
+			run: func(ctx context.Context, _ Job) error {
+				if job == 1 {
+					close(firstRun)
+					select {
+					case <-firstRunGate.ch:
+					case <-ctx.Done():
+						return ctx.Err()
+					}
+				}
+				return nil
+			},
+			close: func() error {
+				if job == 2 {
+					close(secondClose)
+					<-secondCloseGate.ch
+				}
+				closed[job].Add(1)
+				reserved.Add(-1)
+				return nil
+			},
+		}, nil
+	}, firstRunGate, secondCloseGate)
+
+	await(t, firstRun, "first Run with sparse input")
+	jobs <- 2
+	await(t, secondClose, "second Close")
+	jobs <- 3
+	remainsBlocked(t, thirdOpen, "third acquisition")
+	secondCloseGate.release()
+	await(t, thirdOpen, "third acquisition while first Run is held")
+	close(jobs)
+	remainsBlocked(t, result.done, "Serve")
+	firstRunGate.release()
+	if err := result.wait(t); err != nil {
+		t.Fatal(err)
+	}
+	if overLimit.Load() || reserved.Load() != 0 {
+		t.Fatalf("reservation bound violated: over=%v remaining=%d", overLimit.Load(), reserved.Load())
+	}
+	for job := 1; job <= 3; job++ {
+		if opened[job].Load() != 1 || closed[job].Load() != 1 {
+			t.Errorf("job %d: opened=%d closed=%d", job, opened[job].Load(), closed[job].Load())
+		}
+	}
+}
