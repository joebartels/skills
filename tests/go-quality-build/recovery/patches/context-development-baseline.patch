+		return &http.Response{StatusCode: 200, Body: body, Request: r}, nil
+	})}
+	bodies, err := FetchAll(ctx, client, []string{"http://example.test/first"}, time.Second, time.Second)
+	if err != nil || len(bodies) != 1 || string(bodies[0]) != "complete" || !liveAtClose || scope.Err() == nil {
+		t.Fatalf("bodies=%q liveAtClose=%v scopeErr=%v error=%v", bodies, liveAtClose, scope.Err(), err)
+	}
+}
