+func TestFailurePreservesCancellationAndIndependentErrors(t *testing.T) {
+	for _, cancelAtClose := range []bool{false, true} {
+		t.Run(map[bool]string{false: "read", true: "close"}[cancelAtClose], func(t *testing.T) {
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			cause := cancellationCause{"caller", "stopped"}
+			failure := errors.New("independent failure")
+			closes := 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				reader := io.Reader(strings.NewReader("body"))
+				if !cancelAtClose {
+					reader = readerFunc(func([]byte) (int, error) {
+						cancel(cause)
+						return 0, failure
+					})
+				}
+				body := testBody{Reader: reader, close: func() error {
+					closes++
+					if cancelAtClose {
+						cancel(cause)
+						return failure
+					}
+					return nil
+				}}
+				return &http.Response{StatusCode: 200, Body: body, Request: r}, nil
+			})}
+			bodies, err := FetchAll(ctx, client, []string{"http://example.test/first"}, time.Second, time.Second)
+			var gotCause cancellationCause
+			if len(bodies) != 0 || closes != 1 || !errors.Is(err, failure) || !errors.Is(err, context.Canceled) || !errors.As(err, &gotCause) || gotCause.Error() != cause.Error() {
+				t.Fatalf("bodies=%q closes=%d error=%v cause=%v", bodies, closes, err, gotCause)
+			}
+		})
+	}
+}
