+func TestFailureRetainsOnlyCompletedPrefix(t *testing.T) {
+	readErr := errors.New("read failed")
+	closeErr := errors.New("close failed")
+	for _, tc := range []struct {
+		name        string
+		status      int
+		read, close error
+	}{
+		{"read", 200, readErr, nil},
+		{"close", 200, nil, closeErr},
+		{"read_and_close", 200, readErr, closeErr},
+		{"non_200_and_close", 206, nil, closeErr},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			closes := [2]int{}
+			liveAtClose := true
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				i := calls
+				calls++
+				if i > 1 {
+					return nil, errors.New("unexpected later endpoint")
+				}
+				status := 200
+				var reader io.Reader = strings.NewReader("first")
+				if i == 1 {
+					status = tc.status
+					reader = strings.NewReader("incomplete")
+					if tc.read != nil {
+						reader = io.MultiReader(reader, errorReader{tc.read})
+					}
+				}
+				body := testBody{Reader: reader, close: func() error {
+					closes[i]++
+					liveAtClose = liveAtClose && r.Context().Err() == nil
+					if i == 1 {
+						return tc.close
+					}
+					return nil
+				}}
+				return &http.Response{StatusCode: status, Body: body, Header: make(http.Header), Request: r}, nil
+			})}
+			bodies, err := FetchAll(context.Background(), client, []string{"http://example.test/first", "http://example.test/failed", "http://example.test/later"}, time.Second, time.Second)
+			if err == nil || len(bodies) != 1 || string(bodies[0]) != "first" || calls != 2 {
+				t.Fatalf("bodies=%q calls=%d error=%v", bodies, calls, err)
+			}
+			for _, want := range []error{tc.read, tc.close} {
+				if want != nil && !errors.Is(err, want) {
+					t.Errorf("error=%v, missing %v", err, want)
+				}
+			}
+			if tc.status != 200 && !strings.Contains(err.Error(), "status 206") {
+				t.Errorf("error=%v, want status 206", err)
+			}
+			if closes != [2]int{1, 1} || !liveAtClose {
+				t.Errorf("closes=%v liveAtClose=%v", closes, liveAtClose)
+			}
+		})
+	}
+}
