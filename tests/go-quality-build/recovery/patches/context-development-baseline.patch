+func TestCancellationAtLocalHTTPBoundary(t *testing.T) {
+	for _, reading := range []bool{false, true} {
+		t.Run(map[bool]string{false: "request", true: "body_read"}[reading], func(t *testing.T) {
+			started := make(chan struct{})
+			remoteCanceled := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if reading {
+					w.WriteHeader(200)
+					_, _ = io.WriteString(w, "partial")
+					w.(http.Flusher).Flush()
+				} else {
+					close(started)
+				}
+				<-r.Context().Done()
+				close(remoteCanceled)
+			}))
+			ctx, cancel := context.WithCancelCause(context.Background())
+			cause := errors.New("caller canceled local HTTP")
+			client := server.Client()
+			transport := client.Transport
+			closes := 0
+			if reading {
+				client.Transport = transportFunc(func(r *http.Request) (*http.Response, error) {
+					response, err := transport.RoundTrip(r)
+					if err != nil {
+						return response, err
+					}
+					body := response.Body
+					reads := 0
+					response.Body = testBody{Reader: readerFunc(func(p []byte) (int, error) {
+						reads++
+						if reads == 2 {
+							close(started)
+						}
+						return body.Read(p)
+					}), close: func() error {
+						closes++
+						return body.Close()
+					}}
+					return response, nil
+				})
+			}
+			type result struct {
+				bodies [][]byte
+				err    error
+			}
+			outcomes := make(chan result, 1)
+			finished := make(chan struct{})
+			go func() {
+				defer close(finished)
+				bodies, err := FetchAll(ctx, client, []string{server.URL}, 2*time.Second, time.Second)
+				outcomes <- result{bodies, err}
+			}()
+			t.Cleanup(func() {
+				cancel(nil)
+				server.CloseClientConnections()
+				select {
+				case <-finished:
+				case <-time.After(3 * time.Second):
+					t.Error("FetchAll did not finish during cleanup")
+				}
+				server.Close()
+			})
+			awaitSignal(t, started, "request/body consumption started")
+			cancel(cause)
+			select {
+			case got := <-outcomes:
+				if len(got.bodies) != 0 || !errors.Is(got.err, context.Canceled) || !errors.Is(got.err, cause) {
+					t.Errorf("bodies=%q error=%v", got.bodies, got.err)
+				}
+			case <-time.After(3 * time.Second):
+				t.Fatal("FetchAll did not finish after cancellation")
+			}
+			awaitSignal(t, remoteCanceled, "local handler observed cancellation")
+			if reading && closes != 1 {
+				t.Errorf("body closes=%d, want 1", closes)
+			}
+		})
+	}
+}
+
+func awaitSignal(t *testing.T, signal <-chan struct{}, event string) {
+	t.Helper()
+	select {
+	case <-signal:
+	case <-time.After(3 * time.Second):
+		t.Fatalf("timed out waiting for %s", event)
+	}
+}
