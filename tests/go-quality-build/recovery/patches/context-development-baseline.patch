+func fetchStage(parent context.Context, client *http.Client, endpoint string, duration time.Duration) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(parent, duration)
+	defer cancel()
+	if err := ctx.Err(); err != nil {
+		return nil, stageFailure(ctx, err)
+	}
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, stageFailure(ctx, err)
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		var closeErr error
+		if response != nil && response.Body != nil {
+			closeErr = response.Body.Close()
+		}
+		return nil, stageFailure(ctx, err, closeErr)
+	}
+	if response.StatusCode != http.StatusOK {
+		closeErr := response.Body.Close()
+		return nil, stageFailure(ctx, fmt.Errorf("status %d", response.StatusCode), closeErr)
+	}
+	body, readErr := io.ReadAll(response.Body)
+	closeErr := response.Body.Close()
+	if readErr != nil || closeErr != nil {
+		return nil, stageFailure(ctx, readErr, closeErr)
+	}
+	return body, nil
+}
+
+// Observe cancellation before fetchStage releases its own scope. A completed
+// stage succeeds even if cancellation follows its successful read and close.
+func stageFailure(ctx context.Context, failures ...error) error {
+	if err := ctx.Err(); err != nil {
+		failures = append(failures, err, context.Cause(ctx))
+	}
+	return errors.Join(failures...)
+}
