+func TestBudgetScopes(t *testing.T) {
+	t.Run("one_total_budget", func(t *testing.T) {
+		var scopes []context.Context
+		client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+			scopes = append(scopes, r.Context())
+			if len(scopes) == 2 {
+				<-r.Context().Done()
+				return nil, r.Context().Err()
+			}
+			return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("first")), Request: r}, nil
+		})}
+		bodies, err := FetchAll(context.Background(), client, []string{"http://example.test/first", "http://example.test/second"}, 40*time.Millisecond, time.Second)
+		if !errors.Is(err, context.DeadlineExceeded) || len(bodies) != 1 || string(bodies[0]) != "first" || len(scopes) != 2 {
+			t.Fatalf("bodies=%q scopes=%d error=%v", bodies, len(scopes), err)
+		}
+		first, _ := scopes[0].Deadline()
+		second, _ := scopes[1].Deadline()
+		if !first.Equal(second) {
+			t.Errorf("total deadline restarted: first=%v second=%v", first, second)
+		}
+	})
+	t.Run("stage_budget", func(t *testing.T) {
+		var scope context.Context
+		var remaining time.Duration
+		client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+			scope = r.Context()
+			deadline, ok := scope.Deadline()
+			if !ok {
+				return nil, errors.New("missing deadline")
+			}
+			remaining = time.Until(deadline)
+			<-scope.Done()
+			return nil, scope.Err()
+		})}
+		_, err := FetchAll(context.Background(), client, []string{"http://example.test/first"}, time.Second, 30*time.Millisecond)
+		if !errors.Is(err, context.DeadlineExceeded) || scope == nil || remaining > 30*time.Millisecond {
+			t.Fatalf("remaining=%v scope=%v error=%v", remaining, scope, err)
+		}
+	})
+	t.Run("earlier_parent", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		want, _ := ctx.Deadline()
+		var scope context.Context
+		client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+			scope = r.Context()
+			return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("body")), Request: r}, nil
+		})}
+		_, err := FetchAll(ctx, client, []string{"http://example.test/first"}, 2*time.Second, 2*time.Second)
+		if err != nil || scope == nil {
+			t.Fatalf("scope=%v error=%v", scope, err)
+		}
+		got, _ := scope.Deadline()
+		if !got.Equal(want) || !errors.Is(scope.Err(), context.Canceled) || ctx.Err() != nil {
+			t.Errorf("deadline=%v want=%v stageErr=%v parentErr=%v", got, want, scope.Err(), ctx.Err())
+		}
+	})
+}
