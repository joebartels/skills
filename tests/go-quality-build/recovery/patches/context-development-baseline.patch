+func TestCompletedSuccessSurvivesCancellation(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var scope context.Context
+	liveAtClose := false
+	client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+		scope = r.Context()
+		body := testBody{Reader: strings.NewReader("complete"), close: func() error {
