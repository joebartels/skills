+func TestStageBudgetIncludesReadAndClose(t *testing.T) {
+	for _, waitAtClose := range []bool{false, true} {
+		t.Run(map[bool]string{false: "read", true: "close"}[waitAtClose], func(t *testing.T) {
+			closeFailure := errors.New("close failed after deadline")
+			closes := 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				reader := io.Reader(strings.NewReader("body"))
+				if !waitAtClose {
+					reader = readerFunc(func([]byte) (int, error) {
+						<-r.Context().Done()
+						return 0, r.Context().Err()
+					})
+				}
+				body := testBody{Reader: reader, close: func() error {
+					closes++
+					if waitAtClose {
+						<-r.Context().Done()
+						return closeFailure
+					}
+					return nil
+				}}
+				return &http.Response{StatusCode: 200, Body: body, Request: r}, nil
+			})}
+			bodies, err := FetchAll(context.Background(), client, []string{"http://example.test/first"}, time.Second, 30*time.Millisecond)
+			if len(bodies) != 0 || closes != 1 || !errors.Is(err, context.DeadlineExceeded) || (waitAtClose && !errors.Is(err, closeFailure)) {
+				t.Fatalf("bodies=%q closes=%d error=%v", bodies, closes, err)
+			}
+		})
+	}
+}
