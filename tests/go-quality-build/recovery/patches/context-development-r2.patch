+func fetchStage(parent context.Context, client *http.Client, endpoint string, limit time.Duration) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(parent, limit)
+	defer cancel()
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, withObservedCancellation(ctx, err)
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		// On a redirect error, http.Client has already closed the returned body.
+		return nil, withObservedCancellation(ctx, err)
+	}
+	if response.StatusCode != http.StatusOK {
+		statusErr := fmt.Errorf("status %d", response.StatusCode)
+		closeErr := response.Body.Close()
+		return nil, withObservedCancellation(ctx, errors.Join(statusErr, closeErr))
+	}
+	body, readErr := io.ReadAll(response.Body)
+	closeErr := response.Body.Close()
+	if err := errors.Join(readErr, closeErr); err != nil {
+		return nil, withObservedCancellation(ctx, err)
+	}
+	return body, nil
+}
+
+// Sample before releasing an owned scope, retaining both an independent failure
+// and the standard cancellation classification when a custom cause is present.
+func withObservedCancellation(ctx context.Context, failure error) error {
+	if ctxErr := ctx.Err(); ctxErr != nil {
+		return errors.Join(failure, ctxErr, context.Cause(ctx))
+	}
+	return failure
+}
