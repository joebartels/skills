+func TestConfiguredDeadlineStopsBlockedStage(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		total time.Duration
+		stage time.Duration
+	}{
+		{"total", 20 * time.Millisecond, time.Second},
+		{"stage", time.Second, 20 * time.Millisecond},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var requestCtx context.Context
+			closes := 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				requestCtx = r.Context()
+				body := &observedBody{
+					reader: readerFunc(func(p []byte) (int, error) {
+						select {
+						case <-r.Context().Done():
+							return 0, r.Context().Err()
+						case <-time.After(2 * time.Second):
+							return 0, errors.New("request scope never expired")
+						}
+					}),
+					close: func() error { closes++; return nil },
+				}
+				return testResponse(r, 200, body), nil
+			})}
+			got, err := FetchAll(context.Background(), client, []string{"http://example.test/one"}, tc.total, tc.stage)
+			if got != nil || !errors.Is(err, context.DeadlineExceeded) || !errors.Is(requestCtx.Err(), context.DeadlineExceeded) || closes != 1 {
+				t.Fatalf("bodies=%q err=%v request err=%v closes=%d", got, err, requestCtx.Err(), closes)
+			}
+		})
+	}
+}
