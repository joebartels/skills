+func TestCancellationAtCompletion(t *testing.T) {
+	for _, moreWork := range []bool{false, true} {
+		t.Run(fmt.Sprintf("more work=%v", moreWork), func(t *testing.T) {
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			cause := errors.New("caller stopped after body completion")
+			calls := 0
+			body := &observedBody{reader: strings.NewReader("completed"), close: func() error { cancel(cause); return nil }}
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				return testResponse(r, 200, body), nil
+			})}
+			endpoints := []string{"http://example.test/one"}
+			if moreWork {
+				endpoints = append(endpoints, "http://example.test/forbidden")
+			}
+			got, err := FetchAll(ctx, client, endpoints, time.Second, time.Second)
+			if len(got) != 1 || string(got[0]) != "completed" || calls != 1 || body.closes != 1 {
+				t.Fatalf("bodies=%q err=%v calls=%d closes=%d", got, err, calls, body.closes)
+			}
+			if moreWork {
+				if !errors.Is(err, context.Canceled) || !errors.Is(err, cause) {
+					t.Errorf("error=%v, want cancellation before new work", err)
+				}
+			} else if err != nil {
+				t.Errorf("completed success invalidated: %v", err)
+			}
+		})
+	}
+}
