+func TestIndependentFailureAndObservedCancellation(t *testing.T) {
+	for _, cancelDuringRead := range []bool{false, true} {
+		t.Run(fmt.Sprintf("canceled=%v", cancelDuringRead), func(t *testing.T) {
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			cause := customCause{details: []string{"caller", "stopped"}}
+			independent := errors.New("independent body failure")
+			closeErr := errors.New("independent close failure")
+			body := &observedBody{
+				reader: readerFunc(func(p []byte) (int, error) {
+					if cancelDuringRead {
+						cancel(cause)
+					}
+					return copy(p, "partial"), errors.Join(independent, context.Canceled)
+				}),
+				close: func() error { return closeErr },
+			}
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				return testResponse(r, 200, body), nil
+			})}
+			got, err := FetchAll(ctx, client, []string{"http://example.test/one"}, time.Second, time.Second)
+			if got != nil || !errors.Is(err, independent) || !errors.Is(err, closeErr) || !errors.Is(err, context.Canceled) || body.closes != 1 {
+				t.Fatalf("bodies=%q err=%v closes=%d, want both independent errors and classification", got, err, body.closes)
+			}
+			var actual customCause
+			if found := errors.As(err, &actual); found != cancelDuringRead || (found && !reflect.DeepEqual(actual.details, cause.details)) {
+				t.Errorf("error=%v custom cause=%v, want observed=%v", err, actual, cancelDuringRead)
+			}
+		})
+	}
+}
