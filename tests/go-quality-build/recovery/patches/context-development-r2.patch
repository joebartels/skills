+func TestBudgetsAndStageLifetime(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		total     time.Duration
+		stage     time.Duration
+		parentCap bool
+	}{
+		{"one total deadline", time.Second, 2 * time.Second, false},
+		{"narrow stage deadline", 2 * time.Second, time.Second, false},
+		{"earlier parent deadline", 2 * time.Second, time.Second, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			parent := context.WithValue(context.Background(), "request-metadata", "retained")
+			if tc.parentCap {
+				var cancel context.CancelFunc
+				parent, cancel = context.WithDeadline(parent, time.Now().Add(time.Second/2))
+				defer cancel()
+			}
+			var contexts []context.Context
+			var deadlines []time.Time
+			var bodies []*observedBody
+			before := time.Now()
+			var observations []string
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				if len(contexts) > 0 && contexts[len(contexts)-1].Err() == nil {
+					observations = append(observations, "previous stage not released")
+				}
+				stageCtx := r.Context()
+				deadline, ok := stageCtx.Deadline()
+				if !ok {
+					observations = append(observations, "no request deadline")
+				}
+				if stageCtx.Value("request-metadata") != "retained" {
+					observations = append(observations, "request metadata lost")
+				}
+				contexts = append(contexts, stageCtx)
+				deadlines = append(deadlines, deadline)
+				body := &observedBody{
+					reader: readerFunc(func(p []byte) (int, error) {
+						if stageCtx.Err() != nil {
+							observations = append(observations, "stage ended before read")
+						}
+						return 0, io.EOF
+					}),
+					close: func() error {
+						if stageCtx.Err() != nil {
+							observations = append(observations, "stage ended before close")
+						}
+						return nil
+					},
+				}
+				bodies = append(bodies, body)
+				return testResponse(r, 200, body), nil
+			})}
+			got, err := FetchAll(parent, client, []string{"http://example.test/one", "http://example.test/two"}, tc.total, tc.stage)
+			after := time.Now()
+			if err != nil || len(got) != 2 || len(observations) != 0 {
+				t.Fatalf("bodies=%q err=%v observations=%v", got, err, observations)
+			}
+			for i, stageCtx := range contexts {
+				if !errors.Is(stageCtx.Err(), context.Canceled) || bodies[i].closes != 1 {
+					t.Errorf("stage %d: err=%v closes=%d", i, stageCtx.Err(), bodies[i].closes)
+				}
+			}
+			if tc.parentCap {
+				want, _ := parent.Deadline()
+				for _, deadline := range deadlines {
+					if !deadline.Equal(want) {
+						t.Errorf("deadline=%v, want parent deadline=%v", deadline, want)
+					}
+				}
+			} else if tc.stage >= tc.total {
+				if !deadlines[0].Equal(deadlines[1]) {
+					t.Errorf("total deadline restarted: %v then %v", deadlines[0], deadlines[1])
+				}
+				if deadlines[0].Before(before.Add(tc.total)) || deadlines[0].After(after.Add(tc.total)) {
+					t.Errorf("total deadline=%v, outside operation-start bounds", deadlines[0])
+				}
+			} else {
+				for _, deadline := range deadlines {
+					if deadline.Before(before.Add(tc.stage)) || deadline.After(after.Add(tc.stage)) {
+						t.Errorf("stage deadline=%v, outside stage-start bounds", deadline)
+					}
+				}
+			}
+		})
+	}
+}
