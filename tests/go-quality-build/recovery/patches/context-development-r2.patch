+// Keep compatibility with callers that store the exact exported function type.
+var _ func(context.Context, *http.Client, []string, time.Duration, time.Duration) ([][]byte, error) = FetchAll
+
+type observedBody struct {
+	reader io.Reader
+	close  func() error
+	closes int
+}
+
+func (b *observedBody) Read(p []byte) (int, error) { return b.reader.Read(p) }
+func (b *observedBody) Close() error {
+	b.closes++
+	if b.close != nil {
+		return b.close()
+	}
+	return nil
+}
+
+type readerFunc func([]byte) (int, error)
+
+func (f readerFunc) Read(p []byte) (int, error) { return f(p) }
+
+func testResponse(r *http.Request, status int, body io.ReadCloser) *http.Response {
+	return &http.Response{StatusCode: status, Body: body, Header: make(http.Header), Request: r}
+}
+
+type customCause struct{ details []string }
+
+func (c customCause) Error() string { return strings.Join(c.details, ": ") }
+
+func TestEmptyAndCanceledAdmission(t *testing.T) {
+	for _, empty := range []bool{true, false} {
+		t.Run(fmt.Sprintf("empty=%v", empty), func(t *testing.T) {
+			ctx, cancel := context.WithCancelCause(context.Background())
+			cause := customCause{details: []string{"caller", "stopped"}}
+			cancel(cause)
+			calls := 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				return testResponse(r, 200, io.NopCloser(strings.NewReader("bad"))), nil
+			})}
+			var endpoints []string
+			if !empty {
+				endpoints = []string{"http://example.test/one"}
+			}
+			got, err := FetchAll(ctx, client, endpoints, time.Second, time.Second)
+			if got != nil || calls != 0 {
+				t.Fatalf("bodies=%q calls=%d, want nil and zero calls", got, calls)
+			}
+			if empty {
+				if err != nil {
+					t.Fatalf("empty work: %v", err)
+				}
+				return
+			}
+			var actual customCause
+			if !errors.Is(err, context.Canceled) || !errors.As(err, &actual) || !reflect.DeepEqual(actual.details, cause.details) {
+				t.Fatalf("error=%v, want cancellation and noncomparable custom cause", err)
+			}
+		})
+	}
+}
