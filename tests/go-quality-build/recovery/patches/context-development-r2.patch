+func TestRetainedPrefixAndOwnedBodyFailures(t *testing.T) {
+	requestErr := errors.New("request failed")
+	readErr := errors.New("read failed")
+	closeErr := errors.New("close failed")
+	for _, tc := range []struct {
+		name   string
+		status int
+		read   error
+		close  error
+		do     error
+	}{
+		{"request", 200, nil, nil, requestErr},
+		{"neighbor status", 206, nil, nil, nil},
+		{"status and close", 503, nil, closeErr, nil},
+		{"read", 200, readErr, nil, nil},
+		{"close", 200, nil, closeErr, nil},
+		{"read and close", 200, readErr, closeErr, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls := 0
+			first := &observedBody{reader: strings.NewReader("first")}
+			failed := &observedBody{reader: strings.NewReader("second"), close: func() error { return tc.close }}
+			if tc.read != nil {
+				failed.reader = readerFunc(func(p []byte) (int, error) { return copy(p, "partial"), tc.read })
+			}
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if calls == 1 {
+					return testResponse(r, 200, first), nil
+				}
+				if tc.do != nil {
+					return nil, tc.do
+				}
+				return testResponse(r, tc.status, failed), nil
+			})}
+			got, err := FetchAll(context.Background(), client, []string{"http://example.test/one", "http://example.test/two", "http://example.test/forbidden"}, time.Second, time.Second)
+			if err == nil || len(got) != 1 || string(got[0]) != "first" || calls != 2 || first.closes != 1 {
+				t.Fatalf("bodies=%q err=%v calls=%d first closes=%d", got, err, calls, first.closes)
+			}
+			for _, want := range []error{tc.do, tc.read, tc.close} {
+				if want != nil && !errors.Is(err, want) {
+					t.Errorf("error=%v lost cause %v", err, want)
+				}
+			}
+			if tc.status != 200 && !strings.Contains(err.Error(), fmt.Sprintf("status %d", tc.status)) {
+				t.Errorf("error=%v lost status %d", err, tc.status)
+			}
+			wantCloses := 1
+			if tc.do != nil {
+				wantCloses = 0
+			}
+			if failed.closes != wantCloses {
+				t.Errorf("failed closes=%d, want %d", failed.closes, wantCloses)
+			}
+			if errors.Is(err, context.Canceled) {
+				t.Errorf("error=%v classified its own cleanup cancellation as failure", err)
+			}
+		})
+	}
+}
