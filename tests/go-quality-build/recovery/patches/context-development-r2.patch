+func TestRedirectFailureDoesNotCloseBodyTwice(t *testing.T) {
+	redirectErr := errors.New("redirect rejected by supplied client")
+	body := &observedBody{reader: strings.NewReader("redirect")}
+	client := &http.Client{
+		Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+			response := testResponse(r, http.StatusFound, body)
+			response.Header.Set("Location", "/second")
+			return response, nil
+		}),
+		CheckRedirect: func(*http.Request, []*http.Request) error { return redirectErr },
+	}
+	got, err := FetchAll(context.Background(), client, []string{"http://example.test/one"}, time.Second, time.Second)
+	if got != nil || !errors.Is(err, redirectErr) || body.closes != 1 {
+		t.Fatalf("bodies=%q err=%v closes=%d, want client redirect error and exactly one close", got, err, body.closes)
+	}
+}
