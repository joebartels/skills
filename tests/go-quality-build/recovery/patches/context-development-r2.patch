+// This fixture exercises the actual loopback HTTP transport. Its handler stays
+// alive until cancellation is observed or test cleanup releases it.
+func TestHTTPInFlightCancellation(t *testing.T) {
+	for _, sendHeaders := range []bool{false, true} {
+		t.Run(fmt.Sprintf("body=%v", sendHeaders), func(t *testing.T) {
+			started := make(chan struct{})
+			readStarted := make(chan struct{})
+			observed := make(chan struct{})
+			release := make(chan struct{})
+			var releaseOnce sync.Once
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if sendHeaders {
+					w.WriteHeader(http.StatusOK)
+					_, _ = io.WriteString(w, "partial")
+					w.(http.Flusher).Flush()
+				}
+				close(started)
+				select {
+				case <-r.Context().Done():
+					close(observed)
+				case <-release:
+				}
+			}))
+			ctx, cancel := context.WithCancelCause(context.Background())
+			cause := errors.New("caller cancellation")
+			client := server.Client()
+			baseTransport := client.Transport
+			var responseBody *observedBody
+			var readOnce sync.Once
+			client.Transport = transportFunc(func(r *http.Request) (*http.Response, error) {
+				response, err := baseTransport.RoundTrip(r)
+				if err == nil {
+					original := response.Body
+					responseBody = &observedBody{
+						reader: readerFunc(func(p []byte) (int, error) {
+							readOnce.Do(func() { close(readStarted) })
+							return original.Read(p)
+						}),
+						close: original.Close,
+					}
+					response.Body = responseBody
+				}
+				return response, err
+			})
+			type result struct {
+				bodies [][]byte
+				err    error
+			}
+			finished := make(chan result, 1)
+			joined := make(chan struct{})
+			t.Cleanup(func() {
+				cancel(nil)
+				releaseOnce.Do(func() { close(release) })
+				select {
+				case <-joined:
+				case <-time.After(5 * time.Second):
+					t.Error("FetchAll did not complete during cleanup")
+				}
+				server.Close()
+			})
+			go func() {
+				defer close(joined)
+				bodies, err := FetchAll(ctx, client, []string{server.URL}, 5*time.Second, 5*time.Second)
+				finished <- result{bodies, err}
+			}()
+			select {
+			case <-started:
+			case <-time.After(5 * time.Second):
+				t.Fatal("request did not start")
+			}
+			if sendHeaders {
+				select {
+				case <-readStarted:
+				case <-time.After(5 * time.Second):
+					t.Fatal("response body reading did not start")
+				}
+			}
+			cancel(cause)
+			select {
+			case result := <-finished:
+				if result.bodies != nil || !errors.Is(result.err, context.Canceled) || !errors.Is(result.err, cause) {
+					t.Fatalf("bodies=%q err=%v, want cancellation and cause without incomplete body", result.bodies, result.err)
+				}
+				if sendHeaders && (responseBody == nil || responseBody.closes != 1) {
+					t.Fatalf("body=%v, want exactly one owned-body close", responseBody)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("FetchAll did not observe cancellation")
+			}
+			select {
+			case <-observed:
+			case <-time.After(5 * time.Second):
+				t.Fatal("loopback handler did not observe transport cancellation")
+			}
+		})
+	}
+}
