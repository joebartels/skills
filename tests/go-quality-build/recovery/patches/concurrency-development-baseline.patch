+func TestIndependentErrorCombinations(t *testing.T) {
+	runFailure := errors.New("Run failure")
+	closeFailure := errors.New("Close failure")
+	for _, tc := range []struct {
+		name       string
+		open, run  error
+		close      error
+		wantCauses []error
+	}{
+		{name: "success"},
+		{name: "Run only", run: runFailure, wantCauses: []error{runFailure}},
+		{name: "Close only", close: closeFailure, wantCauses: []error{closeFailure}},
+		{name: "both", run: runFailure, close: closeFailure, wantCauses: []error{runFailure, closeFailure}},
+		{name: "wrapped Open cancellation", open: fmt.Errorf("acquire failed: %w", context.Canceled), wantCauses: []error{context.Canceled}},
+		{name: "joined Run deadline", run: errors.Join(context.DeadlineExceeded, runFailure), wantCauses: []error{context.DeadlineExceeded, runFailure}},
+		{name: "joined Close cancellation", close: errors.Join(context.Canceled, closeFailure), wantCauses: []error{context.Canceled, closeFailure}},
+		{name: "exact Close cancellation", close: context.Canceled, wantCauses: []error{context.Canceled}},
+		{name: "noncomparable Run error", run: detailError{labels: []string{"independent"}, cause: runFailure}, wantCauses: []error{runFailure}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			jobs := make(chan Job, 2)
+			jobs <- 1
+			close(jobs)
+			var runs, closes int
+			err := Serve(context.Background(), jobs, 1, func(context.Context, Job) (Lease, error) {
+				if tc.open != nil {
+					return nil, tc.open
+				}
+				return callbackLease{
+					run:   func(context.Context, Job) error { runs++; return tc.run },
+					close: func() error { closes++; return tc.close },
+				}, nil
+			})
+			if len(tc.wantCauses) == 0 && err != nil {
+				t.Errorf("Serve = %v, want nil", err)
+			}
+			for _, cause := range tc.wantCauses {
+				if !errors.Is(err, cause) {
+					t.Errorf("Serve = %v, missing cause %v", err, cause)
+				}
+			}
+			wantCalls := 1
+			if tc.open != nil {
+				wantCalls = 0
+			}
+			if runs != wantCalls || closes != wantCalls {
+				t.Errorf("Run calls = %d, Close calls = %d, want both %d", runs, closes, wantCalls)
+			}
+		})
+	}
+}
