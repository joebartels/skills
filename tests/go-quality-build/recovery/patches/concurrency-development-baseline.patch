+func TestLateAcquisitionIsClosedWithoutRun(t *testing.T) {
+	workFailure := errors.New("Run independently failed")
+	closeFailure := errors.New("late lease Close failed")
+	trigger, fail := gate()
+	acquired, finishAcquire := gate()
+	closeGate, finishClose := gate()
+	ready := make(chan struct{}, 2)
+	acquiringStopped := make(chan struct{}, 1)
+	lateClosing := make(chan struct{}, 1)
+	var lateRuns, closes atomic.Int32
+	var closeFinished atomic.Bool
+	jobs := make(chan Job, 2)
+	jobs <- 1
+	jobs <- 2
+	open := func(ctx context.Context, job Job) (Lease, error) {
+		ready <- struct{}{}
+		if job == 1 {
+			return callbackLease{
+				run:   func(context.Context, Job) error { <-trigger; return workFailure },
+				close: func() error { closes.Add(1); return nil },
+			}, nil
+		}
+		<-ctx.Done()
+		acquiringStopped <- struct{}{}
+		<-acquired
+		return callbackLease{
+			run: func(context.Context, Job) error { lateRuns.Add(1); return nil },
+			close: func() error {
+				closes.Add(1)
+				lateClosing <- struct{}{}
+				<-closeGate
+				closeFinished.Store(true)
+				return closeFailure
+			},
+		}, nil
+	}
+	result := startServe(t, context.Background(), jobs, 2, open, fail, finishAcquire, finishClose)
+	await(t, ready, "first admitted acquisition")
+	await(t, ready, "second admitted acquisition")
+	fail()
+	await(t, acquiringStopped, "cancellation during acquisition")
+	finishAcquire()
+	await(t, lateClosing, "late acquisition Close")
+	assertPending(t, result, "late acquisition Close")
+	finishClose()
+	err := await(t, result, "late lease finalization")
+	if !errors.Is(err, workFailure) || !errors.Is(err, closeFailure) {
+		t.Errorf("Serve = %v, want both %v and %v", err, workFailure, closeFailure)
+	}
+	if lateRuns.Load() != 0 || closes.Load() != 2 || !closeFinished.Load() {
+		t.Errorf("late Runs = %d, Close calls = %d, Close finished = %v", lateRuns.Load(), closes.Load(), closeFinished.Load())
+	}
+}
