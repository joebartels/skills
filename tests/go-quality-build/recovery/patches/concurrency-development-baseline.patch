+func TestFailuresStopAndJoin(t *testing.T) {
+	for _, stage := range []string{"Open", "Run", "Close"} {
+		t.Run(stage, func(t *testing.T) {
+			failure := errors.New(stage + " independently failed")
+			trigger, fail := gate()
+			cleanup, finishCleanup := gate()
+			ready := make(chan struct{}, 1)
+			running := make(chan struct{}, 1)
+			stopped := make(chan struct{}, 1)
+			var opens, closes atomic.Int32
+			var cleaned, prematureClose atomic.Bool
+			jobs := make(chan Job, 3)
+			jobs <- 1
+			jobs <- 2
+			jobs <- 3
+			open := func(ctx context.Context, job Job) (Lease, error) {
+				opens.Add(1)
+				if job == 1 {
+					if stage == "Open" {
+						ready <- struct{}{}
+						<-trigger
+						return nil, failure
+					}
+					return callbackLease{
+						run: func(context.Context, Job) error {
+							if stage == "Run" {
+								ready <- struct{}{}
+								<-trigger
+								return failure
+							}
+							return nil
+						},
+						close: func() error {
+							closes.Add(1)
+							if stage == "Close" {
+								ready <- struct{}{}
+								<-trigger
+								return failure
+							}
+							return nil
+						},
+					}, nil
+				}
+				return callbackLease{
+					run: func(ctx context.Context, _ Job) error {
+						running <- struct{}{}
+						<-ctx.Done()
+						stopped <- struct{}{}
+						<-cleanup
+						cleaned.Store(true)
+						return ctx.Err()
+					},
+					close: func() error {
+						if !cleaned.Load() {
+							prematureClose.Store(true)
+						}
+						closes.Add(1)
+						return nil
+					},
+				}, nil
+			}
+			result := startServe(t, context.Background(), jobs, 2, open, fail, finishCleanup)
+			await(t, ready, "failing stage readiness")
+			await(t, running, "unrelated Run startup")
+			fail()
+			await(t, stopped, "immediate cooperative stop")
+			assertPending(t, result, "Run cleanup")
+			finishCleanup()
+			err := await(t, result, "failure after held Run cleanup")
+			if !errors.Is(err, failure) {
+				t.Errorf("Serve = %v, want independent failure %v", err, failure)
+			}
+			if errors.Is(err, context.Canceled) {
+				t.Errorf("Serve exposed coordinated cancellation acknowledgment: %v", err)
+			}
+			if opens.Load() != 2 {
+				t.Errorf("Open calls = %d, want exactly the two admitted jobs", opens.Load())
+			}
+			wantCloses := int32(2)
+			if stage == "Open" {
+				wantCloses = 1
+			}
+			if got := closes.Load(); got != wantCloses || prematureClose.Load() {
+				t.Errorf("Close calls = %d, want %d; premature Close = %v", got, wantCloses, prematureClose.Load())
+			}
+			// The input belongs to the caller and remains usable after failure.
+			jobs <- 4
+		})
+	}
+}
