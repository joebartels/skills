+func TestReservationsIncludeHeldClose(t *testing.T) {
+	jobs := make(chan Job, 8)
+	for job := Job(1); job <= 8; job++ {
+		jobs <- job
+	}
+	close(jobs)
+	closeGate, releaseClose := gate()
+	closing := make(chan struct{}, 8)
+	var outstanding, peak atomic.Int32
+	open := func(context.Context, Job) (Lease, error) {
+		n := outstanding.Add(1)
+		for previous := peak.Load(); n > previous && !peak.CompareAndSwap(previous, n); previous = peak.Load() {
+		}
+		return callbackLease{close: func() error {
+			closing <- struct{}{}
+			<-closeGate
+			outstanding.Add(-1)
+			return nil
+		}}, nil
+	}
+	result := startServe(t, context.Background(), jobs, 2, open, releaseClose)
+	await(t, closing, "first held Close")
+	await(t, closing, "second held Close")
+	// Both lifetimes have reached held cleanup. This is an observation window
+	// for forbidden admission, not a sleep used to guess worker readiness.
+	select {
+	case <-closing:
+		t.Error("a third reservation reached Close while two Close calls were held")
+	case <-result:
+		t.Fatal("Serve returned while Close was held")
+	case <-time.After(30 * time.Millisecond):
+	}
+	releaseClose()
+	if err := await(t, result, "all eight leases"); err != nil {
+		t.Fatal(err)
+	}
+	if got := peak.Load(); got > 2 {
+		t.Errorf("peak outstanding reservations = %d, want at most 2", got)
+	}
+	if got := outstanding.Load(); got != 0 {
+		t.Errorf("outstanding leases after return = %d, want 0", got)
+	}
+}
