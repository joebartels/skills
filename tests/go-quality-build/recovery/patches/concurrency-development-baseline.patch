+func TestSparseInputAndIndependentRelease(t *testing.T) {
+	jobs := make(chan Job, 3)
+	run1, releaseRun1 := gate()
+	run2, releaseRun2 := gate()
+	run3, releaseRun3 := gate()
+	close1, releaseClose1 := gate()
+	started := make(chan Job, 3)
+	closing := make(chan Job, 3)
+	var close1Finished atomic.Bool
+	var closes [4]atomic.Int32
+	var outOfOrder atomic.Bool
+	open := func(ctx context.Context, job Job) (Lease, error) {
+		if job == 3 && !close1Finished.Load() {
+			outOfOrder.Store(true)
+		}
+		var run <-chan struct{}
+		switch job {
+		case 1:
+			run = run1
+		case 2:
+			run = run2
+		case 3:
+			run = run3
+		}
+		return callbackLease{
+			run: func(ctx context.Context, job Job) error {
+				started <- job
+				select {
+				case <-run:
+					return nil
+				case <-ctx.Done():
+					return ctx.Err()
+				}
+			},
+			close: func() error {
+				closes[job].Add(1)
+				closing <- job
+				if job == 1 {
+					<-close1
+					close1Finished.Store(true)
+				}
+				return nil
+			},
+		}, nil
+	}
+	result := startServe(t, context.Background(), jobs, 2, open, releaseRun1, releaseRun2, releaseRun3, releaseClose1)
+	jobs <- 1
+	if got := await(t, started, "first sparse job"); got != 1 {
+		t.Fatalf("first Run = %d, want 1", got)
+	}
+	jobs <- 2
+	if got := await(t, started, "second job"); got != 2 {
+		t.Fatalf("second Run = %d, want 2", got)
+	}
+	releaseRun1()
+	if got := await(t, closing, "first Close while second Run is held"); got != 1 {
+		t.Fatalf("first Close = %d, want 1", got)
+	}
+	jobs <- 3
+	releaseClose1()
+	if got := await(t, started, "work in independently released slot"); got != 3 {
+		t.Fatalf("third Run = %d, want 3", got)
+	}
+	if outOfOrder.Load() {
+		t.Error("third acquisition started before the first Close finished")
+	}
+	close(jobs)
+	releaseRun2()
+	releaseRun3()
+	if err := await(t, result, "successful completion"); err != nil {
+		t.Fatal(err)
+	}
+	for job := 1; job <= 3; job++ {
+		if got := closes[job].Load(); got != 1 {
+			t.Errorf("job %d Close calls = %d, want 1", job, got)
+		}
+	}
+}
