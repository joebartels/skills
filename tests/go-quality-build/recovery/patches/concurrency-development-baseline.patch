+func TestIndependentErrorsDuringStop(t *testing.T) {
+	for _, stage := range []string{"Open", "Run", "Close"} {
+		t.Run(stage, func(t *testing.T) {
+			firstFailure := errors.New("initial failure")
+			secondFailure := errors.New("independent " + stage + " failure")
+			secondError := fmt.Errorf("%s failed during stop: %w", stage, errors.Join(context.Canceled, detailError{labels: []string{"independent"}, cause: secondFailure}))
+			secondReady := make(chan struct{})
+			jobs := make(chan Job, 2)
+			jobs <- 1
+			jobs <- 2
+			var closes atomic.Int32
+			open := func(ctx context.Context, job Job) (Lease, error) {
+				if job == 1 {
+					return callbackLease{run: func(context.Context, Job) error {
+						<-secondReady
+						return firstFailure
+					}}, nil
+				}
+				if stage == "Open" {
+					close(secondReady)
+					<-ctx.Done()
+					return nil, secondError
+				}
+				return callbackLease{
+					run: func(ctx context.Context, _ Job) error {
+						close(secondReady)
+						<-ctx.Done()
+						if stage == "Run" {
+							return secondError
+						}
+						return ctx.Err()
+					},
+					close: func() error {
+						closes.Add(1)
+						if stage == "Close" {
+							return secondError
+						}
+						return nil
+					},
+				}, nil
+			}
+			result := startServe(t, context.Background(), jobs, 2, open)
+			err := await(t, result, "independent failure during coordinated stop")
+			for _, cause := range []error{firstFailure, secondError, secondFailure, context.Canceled} {
+				if !errors.Is(err, cause) {
+					t.Errorf("Serve = %v, missing independent cause %v", err, cause)
+				}
+			}
+			wantCloses := int32(1)
+			if stage == "Open" {
+				wantCloses = 0
+			}
+			if got := closes.Load(); got != wantCloses {
+				t.Errorf("second lease Close calls = %d, want %d", got, wantCloses)
+			}
+		})
+	}
+}
