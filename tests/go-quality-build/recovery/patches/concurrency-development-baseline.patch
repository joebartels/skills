+func TestAlreadyExpiredDeadline(t *testing.T) {
+	cause := errors.New("caller deadline cause")
+	ctx, cancel := context.WithDeadlineCause(context.Background(), time.Now().Add(-time.Minute), cause)
+	defer cancel()
+	jobs := make(chan Job, 1)
+	jobs <- 1
+	called := false
+	err := Serve(ctx, jobs, 1, func(context.Context, Job) (Lease, error) {
+		called = true
+		return callbackLease{}, nil
+	})
+	if called || !errors.Is(err, context.DeadlineExceeded) || !errors.Is(err, cause) {
+		t.Errorf("Serve = %v, Open called = %v; want deadline classification and cause without admission", err, called)
+	}
