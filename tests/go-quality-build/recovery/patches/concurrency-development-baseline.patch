+func TestCanceledEntryAndWaitingInput(t *testing.T) {
+	for _, entry := range []bool{true, false} {
+		t.Run(fmt.Sprintf("canceled-at-entry=%v", entry), func(t *testing.T) {
+			custom := errors.New("caller cause")
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			jobs := make(chan Job, 2)
+			jobs <- 1
+			if entry {
+				cancel(custom)
+			}
+			var opens, runs, closes atomic.Int32
+			closed := make(chan struct{}, 1)
+			result := startServe(t, ctx, jobs, 1, func(context.Context, Job) (Lease, error) {
+				opens.Add(1)
+				return callbackLease{
+					run:   func(context.Context, Job) error { runs.Add(1); return nil },
+					close: func() error { closes.Add(1); closed <- struct{}{}; return nil },
+				}, nil
+			})
+			if !entry {
+				await(t, closed, "accepted work before waiting for sparse input")
+				cancel(custom)
+			}
+			err := await(t, result, "caller cancellation without admission")
+			wantCalls := int32(1)
+			if entry {
+				wantCalls = 0
+			}
+			if !errors.Is(err, context.Canceled) || !errors.Is(err, custom) {
+				t.Errorf("Serve = %v, want caller classification and cause", err)
+			}
+			if opens.Load() != wantCalls || runs.Load() != wantCalls || closes.Load() != wantCalls {
+				t.Errorf("Open/Run/Close calls = %d/%d/%d, want each %d", opens.Load(), runs.Load(), closes.Load(), wantCalls)
+			}
+			jobs <- 2
+		})
+	}
+}
