+func TestCallerCancellationWhileStopping(t *testing.T) {
+	failure := errors.New("independent Run failure")
+	custom := errors.New("caller cause")
+	cause := detailError{labels: []string{"caller cancellation"}, cause: custom}
+	ctx, cancel := context.WithCancelCause(context.Background())
+	defer cancel(nil)
+	closeGate, finishClose := gate()
+	closing := make(chan struct{}, 1)
+	var closeFinished atomic.Bool
+	jobs := make(chan Job, 1)
+	jobs <- 1
+	open := func(context.Context, Job) (Lease, error) {
+		return callbackLease{
+			run: func(context.Context, Job) error { return failure },
+			close: func() error {
+				closing <- struct{}{}
+				<-closeGate
+				closeFinished.Store(true)
+				return nil
+			},
+		}, nil
+	}
+	result := startServe(t, ctx, jobs, 1, open, finishClose)
+	await(t, closing, "held cleanup during independent stopping")
+	cancel(cause)
+	assertPending(t, result, "Close after caller cancellation")
+	finishClose()
+	err := await(t, result, "caller cancellation while stopping")
+	for _, want := range []error{failure, context.Canceled, custom} {
+		if !errors.Is(err, want) {
+			t.Errorf("Serve = %v, missing cause %v", err, want)
+		}
+	}
+	if !closeFinished.Load() {
+		t.Error("Serve returned before Close finished")
+	}
+}
