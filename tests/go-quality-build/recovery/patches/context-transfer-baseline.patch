+func TestFirstApplyFailure(t *testing.T) {
+	want := errors.New("first item failed")
+	calls := 0
+	n, err := ApplyBatch(context.Background(), []string{"one", "two"}, time.Second,
+		func(context.Context, string) error { calls++; return want },
+		func(context.Context, int) error { t.Error("receipt without accepted work"); return nil })
+	if n != 0 || calls != 1 || !errors.Is(err, want) {
+		t.Errorf("count = %d, calls = %d, error = %v; want 0, 1, first failure", n, calls, err)
+	}
+}
