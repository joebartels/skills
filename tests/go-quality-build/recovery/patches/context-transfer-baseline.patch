+func TestFinalizationBudgetAndCompletion(t *testing.T) {
+	cause := errors.New("caller deadline cause")
+	ctx, cancel := context.WithTimeoutCause(context.Background(), 100*time.Millisecond, cause)
+	defer cancel()
+	expired := make(chan error, 1)
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	done := make(chan struct{})
+	var n int
+	var err error
+	t.Cleanup(func() {
+		releaseOnce.Do(func() { close(release) })
+		cancel()
+		select {
+		case <-done:
+		case <-time.After(2 * time.Second):
+			t.Error("ApplyBatch did not finish during cleanup")
+		}
+	})
+	go func() {
+		defer close(done)
+		n, err = ApplyBatch(ctx, []string{"one", "two"}, 10*time.Millisecond,
+			func(got context.Context, _ string) error { <-got.Done(); return nil },
+			func(got context.Context, _ int) error {
+				if got.Err() != nil {
+					expired <- fmt.Errorf("receipt already canceled: %w", got.Err())
+				} else {
+					select {
+					case <-got.Done():
+						expired <- got.Err()
+					case <-time.After(time.Second):
+						expired <- errors.New("receipt budget did not expire")
+					}
+				}
+				<-release
+				return got.Err()
+			})
+	}()
+	select {
+	case got := <-expired:
+		if got != context.DeadlineExceeded {
+			t.Errorf("receipt expiration = %v, want its deadline", got)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("receipt did not reach its budget")
+	}
+	select {
+	case <-done:
+		t.Fatal("ApplyBatch returned while receipt was still in use")
+	case <-time.After(20 * time.Millisecond):
+	}
+	releaseOnce.Do(func() { close(release) })
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("ApplyBatch did not return after receipt completion")
+	}
+	if n != 1 || !errors.Is(err, context.DeadlineExceeded) || !errors.Is(err, cause) {
+		t.Errorf("count = %d, error = %v; want 1, deadline exceeded and caller cause", n, err)
+	}
+}
