+func TestCancellationAfterAcceptance(t *testing.T) {
+	type metadataKey struct{}
+	for _, tc := range []struct {
+		name  string
+		items []string
+	}{
+		{"stops before next item", []string{"one", "two"}},
+		{"completed final item succeeds", []string{"one"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			parent, release := context.WithTimeout(context.WithValue(context.Background(), metadataKey{}, "metadata"), time.Second)
+			defer release()
+			ctx, cancel := context.WithCancelCause(parent)
+			defer cancel(nil)
+			cause := errors.New("caller stopped after acceptance")
+			applies, finishes := 0, 0
+			var receiptCtx context.Context
+			n, err := ApplyBatch(ctx, tc.items, time.Minute,
+				func(got context.Context, item string) error {
+					applies++
+					if got != ctx || item != "one" {
+						t.Errorf("apply received context %v, item %q", got, item)
+					}
+					cancel(cause)
+					return nil
+				},
+				func(got context.Context, count int) error {
+					finishes++
+					receiptCtx = got
+					deadline, ok := got.Deadline()
+					callerDeadline, _ := parent.Deadline()
+					if count != 1 || got.Err() != nil || got.Value(metadataKey{}) != "metadata" || !ok || !deadline.After(callerDeadline) {
+						t.Errorf("receipt count = %d, error = %v, metadata = %v, deadline = %v", count, got.Err(), got.Value(metadataKey{}), deadline)
+					}
+					return nil
+				})
+			if n != 1 || applies != 1 || finishes != 1 {
+				t.Fatalf("count = %d, apply calls = %d, finish calls = %d", n, applies, finishes)
+			}
+			if len(tc.items) == 1 {
+				if err != nil {
+					t.Errorf("completed error = %v, want nil", err)
+				}
+			} else if !errors.Is(err, context.Canceled) || !errors.Is(err, cause) {
+				t.Errorf("error = %v, want cancellation and cause", err)
+			}
+			if receiptCtx.Err() != context.Canceled {
+				t.Errorf("receipt scope after return = %v, want released", receiptCtx.Err())
+			}
+		})
+	}
+}
