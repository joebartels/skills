+func TestNoAcceptedItems(t *testing.T) {
+	cause := errors.New("caller stopped")
+	ctx, cancel := context.WithCancelCause(context.Background())
+	cancel(cause)
+	for _, tc := range []struct {
+		name  string
+		items []string
+	}{
+		{"empty", nil},
+		{"canceled", []string{"one"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			n, err := ApplyBatch(ctx, tc.items, time.Second,
+				func(context.Context, string) error { t.Error("apply called"); return nil },
+				func(context.Context, int) error { t.Error("finish called"); return nil })
+			if n != 0 {
+				t.Errorf("count = %d, want 0", n)
+			}
+			if len(tc.items) == 0 {
+				if err != nil {
+					t.Errorf("empty error = %v, want nil", err)
+				}
+			} else if !errors.Is(err, context.Canceled) || !errors.Is(err, cause) {
+				t.Errorf("error = %v, want cancellation and cause", err)
+			}
+		})
+	}
+}
