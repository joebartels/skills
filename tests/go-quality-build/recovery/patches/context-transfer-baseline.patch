+func TestIndependentFailures(t *testing.T) {
+	applyFailure := errors.New("apply failed")
+	finishFailure := errors.New("receipt failed")
+	for _, tc := range []struct {
+		name       string
+		applyErr   error
+		finishErr  error
+		wantCount  int
+		wantEvents []string
+	}{
+		{"apply", fmt.Errorf("apply: %w", applyFailure), nil, 1, []string{"one", "two", "finish"}},
+		{"finish", nil, errors.Join(finishFailure, context.DeadlineExceeded), 3, []string{"one", "two", "three", "finish"}},
+		{"both", errors.Join(applyFailure, context.Canceled), fmt.Errorf("finish: %w", finishFailure), 1, []string{"one", "two", "finish"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var events []string
+			n, err := ApplyBatch(context.Background(), []string{"one", "two", "three"}, time.Second,
+				func(_ context.Context, item string) error {
+					events = append(events, item)
+					if item == "two" {
+						return tc.applyErr
+					}
+					return nil
+				},
+				func(_ context.Context, count int) error {
+					events = append(events, "finish")
+					if count != tc.wantCount {
+						t.Errorf("receipt count = %d, want %d", count, tc.wantCount)
+					}
+					return tc.finishErr
+				})
+			if n != tc.wantCount || !reflect.DeepEqual(events, tc.wantEvents) {
+				t.Errorf("count = %d, events = %v; want %d, %v", n, events, tc.wantCount, tc.wantEvents)
+			}
+			for _, want := range []error{applyFailure, finishFailure, context.Canceled, context.DeadlineExceeded} {
+				wantPresent := errors.Is(tc.applyErr, want) || errors.Is(tc.finishErr, want)
+				if errors.Is(err, want) != wantPresent {
+					t.Errorf("error = %v, presence of %v = %v, want %v", err, want, !wantPresent, wantPresent)
+				}
+			}
+		})
+	}
+}
