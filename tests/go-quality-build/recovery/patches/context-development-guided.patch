+func TestCompletionAndNextStageCancellation(t *testing.T) {
+	for _, count := range []int{1, 2} {
+		name := "complete"
+		if count == 2 {
+			name = "remaining"
+		}
+		t.Run(name, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			calls := 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				reader := strings.NewReader("complete")
+				return &http.Response{StatusCode: 200, Body: bodyFuncs{
+					read: reader.Read,
+					close: func() error {
+						cancel()
+						return nil
+					},
+				}}, nil
+			})}
+			endpoints := []string{"http://example.test/complete", "http://example.test/forbidden"}[:count]
+			got, err := FetchAll(ctx, client, endpoints, time.Hour, time.Hour)
+			if !reflect.DeepEqual(got, [][]byte{[]byte("complete")}) || calls != 1 {
+				t.Fatalf("bodies=%q err=%v requests=%d", got, err, calls)
+			}
+			if count == 1 && err != nil || count == 2 && !errors.Is(err, context.Canceled) {
+				t.Fatalf("error = %v for %d stages", err, count)
+			}
+		})
+	}
+}
