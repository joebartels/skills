+func TestCancellationRetainsIndependentFailures(t *testing.T) {
+	ctx, cancel := context.WithCancelCause(context.Background())
+	defer cancel(nil)
+	cause := cancelCause{"operator", "stop"}
+	readErr, closeErr := errors.New("read failed"), errors.New("close failed")
+	closes := 0
+	client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+		return &http.Response{StatusCode: 200, Body: bodyFuncs{
+			read: func(p []byte) (int, error) {
+				cancel(cause)
+				return copy(p, "partial"), errors.Join(readErr, context.Canceled)
+			},
+			close: func() error { closes++; return closeErr },
+		}}, nil
+	})}
+	got, err := FetchAll(ctx, client, []string{"http://example.test/fails"}, time.Hour, time.Hour)
+	var observed cancelCause
+	if len(got) != 0 || closes != 1 || !errors.Is(err, readErr) || !errors.Is(err, closeErr) || !errors.Is(err, context.Canceled) || !errors.As(err, &observed) || !reflect.DeepEqual(observed, cause) {
+		t.Fatalf("bodies=%q err=%v closes=%d cause=%v", got, err, closes, observed)
+	}
+}
