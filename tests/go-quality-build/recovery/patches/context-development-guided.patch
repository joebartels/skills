+func TestBudgetsAndStageLifetime(t *testing.T) {
+	for _, tc := range []struct {
+		name         string
+		total, stage time.Duration
+		parentLimit  time.Duration
+	}{
+		{"total", time.Hour, 2 * time.Hour, 0},
+		{"stage", 2 * time.Hour, time.Hour, 0},
+		{"parent", 2 * time.Hour, 2 * time.Hour, time.Hour},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := context.Background()
+			if tc.parentLimit != 0 {
+				var cancel context.CancelFunc
+				ctx, cancel = context.WithTimeout(ctx, tc.parentLimit)
+				defer cancel()
+			}
+			before := time.Now()
+			var previous context.Context
+			var firstDeadline time.Time
+			calls, closes := 0, 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if r.Method != http.MethodGet || r.URL.Path != []string{"/first", "/second"}[calls-1] {
+					t.Errorf("request %d = %s %s", calls, r.Method, r.URL.Path)
+				}
+				if previous != nil && (!errors.Is(previous.Err(), context.Canceled) || closes != 1) {
+					t.Error("previous stage was not closed and canceled before the next request")
+				}
+				deadline, ok := r.Context().Deadline()
+				if !ok {
+					t.Error("request has no deadline")
+				}
+				limit := min(tc.total, tc.stage)
+				if deadline.Before(before.Add(limit)) || deadline.After(time.Now().Add(limit)) {
+					if tc.parentLimit == 0 {
+						t.Errorf("deadline %v outside duration %v", deadline, limit)
+					}
+				}
+				if parentDeadline, ok := ctx.Deadline(); ok && !deadline.Equal(parentDeadline) {
+					t.Errorf("deadline = %v, want parent %v", deadline, parentDeadline)
+				}
+				if calls == 1 {
+					firstDeadline = deadline
+				} else if tc.name != "stage" && !deadline.Equal(firstDeadline) {
+					t.Error("the total operation deadline restarted for the second stage")
+				}
+				previous = r.Context()
+				reader := strings.NewReader(r.URL.Path)
+				body := bodyFuncs{
+					read: func(p []byte) (int, error) {
+						if err := r.Context().Err(); err != nil {
+							t.Errorf("stage canceled before body read: %v", err)
+						}
+						return reader.Read(p)
+					},
+					close: func() error {
+						closes++
+						if err := r.Context().Err(); err != nil {
+							t.Errorf("stage canceled before body closure: %v", err)
+						}
+						return nil
+					},
+				}
+				return &http.Response{StatusCode: http.StatusOK, Body: body}, nil
+			})}
+			got, err := FetchAll(ctx, client, []string{"http://example.test/first", "http://example.test/second"}, tc.total, tc.stage)
+			if err != nil || !reflect.DeepEqual(got, [][]byte{[]byte("/first"), []byte("/second")}) || calls != 2 || closes != 2 {
+				t.Fatalf("bodies=%q err=%v requests=%d closes=%d", got, err, calls, closes)
+			}
+			if !errors.Is(previous.Err(), context.Canceled) {
+				t.Error("final stage cancel resources were not released")
+			}
+		})
+	}
+}
