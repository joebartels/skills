+
+// This assignment also preserves the supported function type.
+var _ func(context.Context, *http.Client, []string, time.Duration, time.Duration) ([][]byte, error) = FetchAll
+
+type bodyFuncs struct {
+	read  func([]byte) (int, error)
+	close func() error
+}
+
+func (b bodyFuncs) Read(p []byte) (int, error) { return b.read(p) }
+func (b bodyFuncs) Close() error               { return b.close() }
+
+type cancelCause []string
+
+func (c cancelCause) Error() string { return strings.Join(c, ": ") }
+
+func TestEmptyAndCanceled(t *testing.T) {
+	cause := cancelCause{"caller", "stopped"}
+	ctx, cancel := context.WithCancelCause(context.Background())
+	cancel(cause)
+	calls := 0
+	client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return nil, errors.New("unexpected request")
+	})}
+	got, err := FetchAll(ctx, client, nil, time.Second, time.Second)
+	if len(got) != 0 || err != nil {
+		t.Fatalf("empty call = %q, %v", got, err)
+	}
+	got, err = FetchAll(ctx, client, []string{"http://example.test/first"}, time.Second, time.Second)
+	var observed cancelCause
+	if len(got) != 0 || !errors.Is(err, context.Canceled) || !errors.As(err, &observed) || !reflect.DeepEqual(observed, cause) {
+		t.Fatalf("canceled call = %q, %v; cause = %v", got, err, observed)
+	}
+	if calls != 0 {
+		t.Fatalf("requests = %d, want 0", calls)
+	}
+}
