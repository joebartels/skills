+func fetchStage(parent context.Context, client *http.Client, endpoint string, limit time.Duration) ([]byte, error) {
+	ctx, cancel := context.WithTimeout(parent, limit)
+	defer cancel()
+	if err := withCancellation(ctx, nil); err != nil {
+		return nil, err
+	}
+
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, endpoint, nil)
+	if err != nil {
+		return nil, withCancellation(ctx, err)
+	}
+	response, err := client.Do(request)
+	if err != nil {
+		if response != nil && response.Body != nil {
+			err = errors.Join(err, response.Body.Close())
+		}
+		return nil, withCancellation(ctx, err)
+	}
+
+	var body []byte
+	if response.StatusCode != http.StatusOK {
+		err = fmt.Errorf("status %d", response.StatusCode)
+	} else {
+		body, err = io.ReadAll(response.Body)
+	}
+	err = errors.Join(err, response.Body.Close())
+	if err != nil {
+		return nil, withCancellation(ctx, err)
+	}
+	return body, nil
+}
+
+// Observe cancellation before deferred cleanup cancels this stage itself.
+func withCancellation(ctx context.Context, err error) error {
+	if contextErr := ctx.Err(); contextErr != nil {
+		return errors.Join(err, contextErr, context.Cause(ctx))
+	}
+	return err
+}
