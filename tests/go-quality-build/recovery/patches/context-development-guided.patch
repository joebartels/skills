+func TestStageDeadlineFailure(t *testing.T) {
+	requestErr := errors.New("transport stopped")
+	client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+		<-r.Context().Done()
+		return nil, requestErr
+	})}
+	got, err := FetchAll(context.Background(), client, []string{"http://example.test/slow"}, time.Second, 10*time.Millisecond)
+	if len(got) != 0 || !errors.Is(err, requestErr) || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("bodies=%q err=%v", got, err)
+	}
+}
