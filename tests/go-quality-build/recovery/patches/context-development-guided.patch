+func TestLocalTransportCancellation(t *testing.T) {
+	for _, bodyStarted := range []bool{false, true} {
+		name := "request"
+		if bodyStarted {
+			name = "body"
+		}
+		t.Run(name, func(t *testing.T) {
+			started, canceled, release := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			readStarted := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if bodyStarted {
+					w.WriteHeader(http.StatusOK)
+					w.(http.Flusher).Flush()
+				}
+				close(started)
+				select {
+				case <-r.Context().Done():
+					close(canceled)
+				case <-release:
+				}
+			}))
+			ctx, cancel := context.WithCancel(context.Background())
+			result := make(chan error, 1)
+			finished := make(chan struct{})
+			client := server.Client()
+			transport := client.Transport
+			if bodyStarted {
+				client.Transport = transportFunc(func(r *http.Request) (*http.Response, error) {
+					response, err := transport.RoundTrip(r)
+					if err == nil {
+						body := response.Body
+						notified := false
+						response.Body = bodyFuncs{
+							read: func(p []byte) (int, error) {
+								if !notified {
+									notified = true
+									close(readStarted)
+								}
+								return body.Read(p)
+							},
+							close: body.Close,
+						}
+					}
+					return response, err
+				})
+			}
+			t.Cleanup(func() {
+				cancel()
+				close(release)
+				select {
+				case <-finished:
+				case <-time.After(5 * time.Second):
+					t.Error("FetchAll did not finish during cleanup")
+				}
+				transport.(*http.Transport).CloseIdleConnections()
+				server.Close()
+			})
+			go func() {
+				defer close(finished)
+				_, err := FetchAll(ctx, client, []string{server.URL}, time.Hour, time.Hour)
+				result <- err
+			}()
+			select {
+			case <-started:
+			case <-time.After(5 * time.Second):
+				t.Fatal("server did not observe the request")
+			}
+			if bodyStarted {
+				select {
+				case <-readStarted:
+				case <-time.After(5 * time.Second):
+					t.Fatal("FetchAll did not begin response body consumption")
+				}
+			}
+			cancel()
+			select {
+			case err := <-result:
+				if !errors.Is(err, context.Canceled) {
+					t.Fatalf("error = %v, want cancellation", err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("FetchAll did not return after caller cancellation")
+			}
+			select {
+			case <-canceled:
+			case <-time.After(5 * time.Second):
+				t.Fatal("local server did not observe request cancellation")
+			}
+		})
+	}
+}
