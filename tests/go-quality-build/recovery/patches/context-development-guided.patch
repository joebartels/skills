+func TestFailedStageRetainsPrefixAndErrors(t *testing.T) {
+	requestErr := errors.New("request failed")
+	readErr := errors.New("read failed")
+	closeErr := errors.New("close failed")
+	for _, tc := range []struct {
+		name                 string
+		status               int
+		request, read, close error
+	}{
+		{"request", 200, requestErr, nil, nil},
+		{"status", 206, nil, nil, nil},
+		{"status and close", 206, nil, nil, closeErr},
+		{"read", 200, nil, readErr, nil},
+		{"close", 200, nil, nil, closeErr},
+		{"read and close", 200, nil, readErr, closeErr},
+		{"read wraps cancellation", 200, nil, errors.Join(readErr, context.Canceled), closeErr},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			calls, closes := 0, 0
+			client := &http.Client{Transport: transportFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				if calls == 1 {
+					return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("accepted"))}, nil
+				}
+				if tc.request != nil {
+					return nil, tc.request
+				}
+				reader := strings.NewReader("unaccepted")
+				body := bodyFuncs{
+					read: func(p []byte) (int, error) {
+						if tc.read != nil {
+							return copy(p, "partial"), tc.read
+						}
+						return reader.Read(p)
+					},
+					close: func() error { closes++; return tc.close },
+				}
+				return &http.Response{StatusCode: tc.status, Body: body}, nil
+			})}
+			got, err := FetchAll(context.Background(), client, []string{"http://example.test/first", "http://example.test/fails", "http://example.test/forbidden"}, time.Hour, time.Hour)
+			if !reflect.DeepEqual(got, [][]byte{[]byte("accepted")}) || err == nil || calls != 2 {
+				t.Fatalf("bodies=%q err=%v requests=%d", got, err, calls)
+			}
+			for _, want := range []error{tc.request, tc.read, tc.close} {
+				if want != nil && !errors.Is(err, want) {
+					t.Errorf("error %v lost %v", err, want)
+				}
+			}
+			if tc.status != 200 && !strings.Contains(err.Error(), "status 206") {
+				t.Errorf("error %v lost the rejected status", err)
+			}
+			if tc.read == nil && errors.Is(err, context.Canceled) {
+				t.Error("scope cleanup invented a cancellation error")
+			}
+			wantCloses := 1
+			if tc.request != nil {
+				wantCloses = 0
+			}
+			if closes != wantCloses {
+				t.Errorf("closes = %d, want %d", closes, wantCloses)
+			}
+		})
+	}
+}
